function inicializarMateriaisPlanilha() {
  if (!Array.isArray(D.mat)) D.mat = [];
  const existentes = new Set(D.mat.map(m => String(m.nome || '').trim().toLowerCase()));
  MATERIAIS_PLANILHA.forEach((nome, i) => {
    const chave = nome.trim().toLowerCase();
    if (!existentes.has(chave)) {
      D.mat.push({
        id: 'MAT-PLAN-' + String(i + 1).padStart(3, '0'),
        nome,
        unidade: 'UN',
        estoque: 0,
        origem: 'MATERIAL LOGISTICO.xlsx',
        c: ag()
      });
      existentes.add(chave);
    }
  });
  sv();
}

D.mat = Array.isArray(D.mat) ? D.mat : [];
D.mr = Array.isArray(D.mr) ? D.mr : [];
let S = lsGet('ss', null);
let CID = null, EID = null, TI = null, loginType = '';

const SITE_FIELDS = ['c-si','c-cd','c-en','c-co','c-ho','c-ve','c-pt','c-pv','c-regiao-planilha','c-tecnicos-planilha'];
const SITE_INDEX = new Map();
const SITE_NUMBER_INDEX = new Map();
SITES_PEII.forEach(site => {
  const circuito = String(site[0] || '').trim();
  const chave = normalizarCircuito(circuito);
  if (chave) SITE_INDEX.set(chave, site);

  const numero = numeroCircuito(circuito);
  if (numero) {
    if (!SITE_NUMBER_INDEX.has(numero)) SITE_NUMBER_INDEX.set(numero, []);
    SITE_NUMBER_INDEX.get(numero).push(site);
  }
});

function normalizarCircuito(v) { return String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, ''); }
function numeroCircuito(v) { return (String(v || '').match(/\d+/g) || []).join(''); }
function esc(v) { const d = document.createElement('div'); d.textContent = String(v == null ? '' : v); return d.innerHTML; }
function valorInfo(v) { return v ? esc(v).replace(/\n/g, '<br>') : 'Não informado'; }
function limparSite() { SITE_FIELDS.forEach(id => { if (el(id)) el(id).value = ''; }); }
function preencherSite(site) {
  const ids = ['c-si','c-cd','c-en','c-co','c-ho','c-ve','c-pt','c-pv'];
  ids.forEach((id, i) => { el(id).value = site[i + 1] || ''; });
  el('c-ci').value = site[0];
  el('c-regiao-planilha').value = site[9] || '';
  el('c-tecnicos-planilha').value = site[10] || '';
  definirRegiaoPlanilha(site[9], site[2]);
  el('c-opcoes').classList.add('hidden');
  el('c-status').textContent = '✓ Circuito encontrado — informações carregadas automaticamente.';
  el('c-status').style.color = 'var(--g)';
  return site;
}
function buscarCircuito() {
  const numero = String(el('c-ci').value || '').trim();
  const chave = normalizarCircuito(numero);
  const numeroSomente = numeroCircuito(numero);
  const status = el('c-status');
  const opcoes = el('c-opcoes');

  if (!chave) {
    limparSite();
    opcoes.classList.add('hidden');
    status.textContent = 'Digite o circuito para carregar os dados do site.';
    status.style.color = 'var(--gr)';
    return null;
  }

  // Primeiro tenta o circuito completo/exato.
  const exato = SITE_INDEX.get(chave);
  if (exato) return preencherSite(exato);

  // Depois tenta pelo número do circuito, permitindo digitar apenas os números.
  const encontrados = SITE_NUMBER_INDEX.get(numeroSomente) || [];

  if (encontrados.length === 1) return preencherSite(encontrados[0]);

  if (encontrados.length > 1) {
    limparSite();
    opcoes.innerHTML = '<option value="">Selecione o circuito correto...</option>' +
      encontrados.map(site =>
        `<option value="${esc(site[0])}">${esc(site[0])} — ${esc(site[1])} (${esc(site[2])})</option>`
      ).join('');
    opcoes.classList.remove('hidden');
    status.textContent = 'Este número existe em mais de um site. Selecione o circuito correto.';
    status.style.color = 'var(--y)';
    return null;
  }

  limparSite();
  opcoes.classList.add('hidden');
  status.textContent = 'Circuito não encontrado na base de dados.';
  status.style.color = 'var(--r)';
  return null;
}

function extrairCampoDaDescricao(texto,tipo){
  const conteudo=String(texto||'');
  const regexRotulo=tipo==='protocolo'
    ? /\b(?:N[º°O.]?\s*)?PROTOCOLO(?:\s*N[º°O.]?)?/i
    : /\bSDM(?:\s*N[º°O.]?)?/i;
  const achadoRotulo=conteudo.match(regexRotulo);
  if(!achadoRotulo) return '';
  const inicio=(achadoRotulo.index||0)+achadoRotulo[0].length;
  let trecho=conteudo.slice(inicio,inicio+500);
  const proximoRotulo=tipo==='protocolo'
    ? trecho.search(/\bSDM\b/i)
    : trecho.search(/\b(?:CIRCUITO|DESIGNA(?:ÇÃO|CAO)|SITE|CLIENTE|ENDEREÇO|ENDERECO|CIDADE|CONTATO)\b/i);
  if(proximoRotulo>0) trecho=trecho.slice(0,proximoRotulo);
  const candidatos=trecho.match(/[A-Z0-9._\/-]*\d[A-Z0-9._\/-]*/ig)||[];
  return candidatos.length ? candidatos[0].replace(/^[._\/-]+|[._\/-]+$/g,'').trim() : '';
}

function normalizarRotuloDescricao(v){
  return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().trim();
}

function extrairTextoRotulado(texto,rotulos){
  const linhas=String(texto||'').split(/\r?\n/);
  const chaves=rotulos.map(normalizarRotuloDescricao);
  const todosRotulos=['SITE','SITE/CLIENTE','SITE / CLIENTE','CLIENTE','ENDERECO','CIDADE','CONTATO','PROTOCOLO','SDM','CIRCUITO','DESIGNACAO'];
  for(let i=0;i<linhas.length;i++){
    const original=String(linhas[i]||'').trim();
    const normal=normalizarRotuloDescricao(original);
    for(const chave of chaves){
      const pos=normal.indexOf(chave);
      if(pos<0) continue;
      const depoisOriginal=original.slice(pos+chave.length).replace(/^\s*[:=\-–—]\s*/,'').trim();
      if(depoisOriginal && /[A-ZÀ-Ú0-9]/i.test(depoisOriginal)) return depoisOriginal;
      for(let j=i+1;j<Math.min(linhas.length,i+5);j++){
        const proxima=String(linhas[j]||'').trim();
        if(!proxima || /^[>_\-=–—\s]+$/.test(proxima)) continue;
        const proxNorm=normalizarRotuloDescricao(proxima);
        if(todosRotulos.some(r=>proxNorm===r || proxNorm.startsWith(r+':') || proxNorm.startsWith(r+' -'))) break;
        return proxima;
      }
    }
  }
  return '';
}

function preencherDadosDaDescricao(texto){
  const dados={
    site:extrairTextoRotulado(texto,['SITE / CLIENTE','SITE/CLIENTE','NOME DO SITE','SITE','CLIENTE']),
    endereco:extrairTextoRotulado(texto,['ENDEREÇO','ENDERECO']),
    cidade:extrairTextoRotulado(texto,['CIDADE','MUNICÍPIO','MUNICIPIO']),
    contato:extrairTextoRotulado(texto,['CONTATO','RESPONSÁVEL LOCAL','RESPONSAVEL LOCAL'])
  };
  if(dados.site) el('c-si').value=dados.site;
  if(dados.endereco) el('c-en').value=dados.endereco;
  if(dados.cidade) el('c-cd').value=dados.cidade;
  if(dados.contato) el('c-co').value=dados.contato;
  return dados;
}

function buscarCircuitoNaDescricao() {
  const campo=el('c-descricao-colada');
  const texto=String(campo?.value||'').trim();
  const status=el('c-status'), opcoes=el('c-opcoes');
  el('c-pr').value=''; el('c-sdm').value=''; el('c-ci').value='';
  limparSite();
  opcoes.classList.add('hidden');

  if(!texto){
    status.textContent='Cole a descrição para localizar automaticamente protocolo, SDM e circuito.';
    status.style.color='var(--gr)';
    return null;
  }

  el('c-pr').value=extrairCampoDaDescricao(texto,'protocolo');
  el('c-sdm').value=extrairCampoDaDescricao(texto,'sdm');
  const dadosDescricao=preencherDadosDaDescricao(texto);

  const textoNormalizado=normalizarCircuito(texto);
  let encontrados=SITES_PEII.filter(site=>{
    const designacao=normalizarCircuito(site[0]);
    return designacao && textoNormalizado.includes(designacao);
  });

  if(!encontrados.length){
    encontrados=SITES_PEII.filter(site=>{
      const numero=numeroCircuito(site[0]);
      return numero && new RegExp('(^|\\\\D)'+numero+'(\\\\D|$)').test(texto);
    });
  }

  const unicos=[...new Map(encontrados.map(site=>[site[0],site])).values()];
  if(unicos.length===1){
    const site=preencherSite(unicos[0]);
    if(el('c-de') && !el('c-de').value.trim()) el('c-de').value=texto;
    status.textContent='✓ Designação localizada: '+site[0]+' — dados preenchidos automaticamente.';
    status.style.color='var(--g)';
    return site;
  }
  if(unicos.length>1){
    opcoes.innerHTML='<option value="">Mais de um circuito encontrado. Selecione...</option>'+
      unicos.map(site=>`<option value="${esc(site[0])}">${esc(site[0])} — ${esc(site[1])} (${esc(site[2])})</option>`).join('');
    opcoes.classList.remove('hidden');
    status.textContent='Foram encontradas várias designações no texto. Selecione o circuito correto.';
    status.style.color='var(--y)';
    return null;
  }

  const camposPreenchidos=[dadosDescricao.site,dadosDescricao.endereco,dadosDescricao.cidade,dadosDescricao.contato].filter(Boolean).length;
  status.textContent=camposPreenchidos
    ? 'Circuito não localizado na base — '+camposPreenchidos+' dado(s) preenchido(s) diretamente pela descrição.'
    : 'Nenhuma designação ou dado de site foi localizado no texto colado.';
  status.style.color=camposPreenchidos?'var(--y)':'var(--r)';
  return null;
}

function selecionarCircuitoDaDescricao(valor){
  const site=SITE_INDEX.get(normalizarCircuito(valor));
  if(!site) return;
  preencherSite(site);
  if(el('c-de') && !el('c-de').value.trim()) el('c-de').value=el('c-descricao-colada').value.trim();
  el('c-status').textContent='✓ Designação selecionada: '+site[0]+' — dados preenchidos automaticamente.';
  el('c-status').style.color='var(--g)';
}

function dadosSite(c) {
  return `<div class="os-r"><b>Circuito:</b> ${valorInfo(c.ci)}</div>
     <div class="os-r"><b>SDM:</b> ${valorInfo(c.sdm)}</div>
    <div class="os-r"><b>Site:</b> ${valorInfo(c.si)}</div>
    <div class="os-r"><b>Cidade:</b> ${valorInfo(c.cid)}</div>
    <div class="os-r"><b>Endereço:</b> ${valorInfo(c.en)}</div>
    <div class="os-r"><b>Contato:</b> ${valorInfo(c.contato)}</div>
    <div class="os-r"><b>Horário de expediente:</b> ${valorInfo(c.horario)}</div>
    <div class="os-r"><b>Velocidade:</b> ${valorInfo(c.velocidade)}</div>
    <div class="os-r"><b>PRTM:</b> ${valorInfo(c.prtm)}</div>
    <div class="os-r"><b>PVF Total:</b> ${valorInfo(c.pvfTotal)}</div>`;
}

function sv() { lsSet('dd', D); }
function ss() { lsSet('ss', S); }
function ag() { return new Date().toLocaleString('pt-BR'); }
function nt(u) { const t = D.tc.find(x => x.u === u); return t ? t.n : u; }
function adminGeral() { return !!(S && S.t === 'adm' && D.ad.some(a => a.u === S.u && a.p)); }
function emailValido(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
function selecionados(nome) { return Array.from(document.querySelectorAll(`input[name="${nome}"]:checked`)).map(x => x.value); }
function nomeSkill(v) { return ({ voz: 'Voz', dados: 'Dados', infra: 'Infra' })[v] || 'Não definida'; }
function nomeArea(v) { return ({ norte: 'Norte', leste: 'Leste', sul: 'Sul', oeste: 'Oeste', interior: 'Interior', noronha: 'Fernando de Noronha' })[v] || 'Não definida'; }
function nomeRegiao(v) { return ({ capital: '🏙️ Capital', interior: '🌾 Interior', noronha: '🏝️ Fernando de Noronha' })[v] || 'Região não definida'; }
function slaRegiao(v) { return v === 'interior' ? '8h' : '6h'; }
function skillsTec(t) { return t.sk && t.sk.length ? t.sk : ['voz','dados','infra']; }
const ENDERECO_TAG='__ENTREGA__:';
function codificarEnderecoEntrega(d){try{return ENDERECO_TAG+encodeURIComponent(JSON.stringify(d||{}));}catch(e){return ENDERECO_TAG+'%7B%7D';}}
function enderecoEntregaTec(t){
  if(t?.entrega)return t.entrega;
  const item=(t?.ar||[]).find(x=>String(x).startsWith(ENDERECO_TAG));
  if(!item)return {};
  try{return JSON.parse(decodeURIComponent(String(item).slice(ENDERECO_TAG.length)))||{};}catch(e){return {};}
}
function areasComEndereco(areas,dados){
  const limpas=(areas||[]).filter(x=>!String(x).startsWith(ENDERECO_TAG));
  return dados&&dados.cep?[...limpas,codificarEnderecoEntrega(dados)]:limpas;
}
function areasTec(t) {
  const areas=(t.ar||[]).filter(x=>!String(x).startsWith(ENDERECO_TAG));
  return areas.length ? areas : (t.r === 'interior' ? ['interior'] : ['norte','leste','sul','oeste']);
}
function enderecoEntregaTexto(t){const d=enderecoEntregaTec(t);return [d.endereco,d.complemento,d.cidade,d.cep&&('CEP '+d.cep)].filter(Boolean).join(', ');}
function tecnicoCompativel(t, c) {
  const areaChamado = c.re === 'interior' ? 'interior' : c.area;
  return t.r === c.re && (!c.skill || skillsTec(t).includes(c.skill)) && (!areaChamado || areasTec(t).includes(areaChamado));
}
const AREAS_CAPITAL_PLANILHA = new Set(['norte','leste','sul','oeste']);
const CIDADES_CAPITAL = new Set(['recife','olinda','jaboatao dos guararapes','paulista','camaragibe','cabo de santo agostinho','abreu e lima','igarassu','ipojuca','moreno','sao lourenco da mata']);
function chaveCidade(v) { return String(v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim(); }
function detectarRegiaoPlanilha(regiao, cidade) {
  const raw = chaveCidade(regiao);
  const cidadeChave = chaveCidade(cidade);
  if (raw.includes('noronha') || cidadeChave.includes('fernando de noronha')) return { tipo: 'noronha', area: 'noronha' };
  // A planilha é a fonte de verdade da região operacional. Aceita variações
  // como "Norte", "Região Norte", "Capital - Norte", etc.
  if (raw.includes('norte')) return { tipo: 'capital', area: 'norte' };
  if (raw.includes('leste')) return { tipo: 'capital', area: 'leste' };
  if (raw.includes('sul')) return { tipo: 'capital', area: 'sul' };
  if (raw.includes('oeste')) return { tipo: 'capital', area: 'oeste' };
  if (raw.includes('interior') || raw.includes('agreste') || raw.includes('sert') || raw.includes('mata') || raw.includes('metropolitana')) return { tipo: 'interior', area: '' };
  if (CIDADES_CAPITAL.has(chaveCidade(cidade))) return { tipo: 'capital', area: '' };
  return { tipo: raw ? 'interior' : (CIDADES_CAPITAL.has(chaveCidade(cidade)) ? 'capital' : 'interior'), area: '' };
}
function definirRegiaoPlanilha(regiao, cidade) {
  const info = detectarRegiaoPlanilha(regiao, cidade);
  el('c-re').value = info.tipo;
  atualizarCamposRegiao();
  if (info.area) el('c-area').value = info.area;
  atualizarTecnicosChamado();
}
function nomesTecnicosPlanilha() {
  const raw = String(el('c-tecnicos-planilha')?.value || '').trim();
  if (!raw) return [];
  return raw.split(/[;,\n|]+/).map(x => x.trim()).filter(Boolean);
}
function tecnicoIndicado(t, indicados) {
  const nome = chaveCidade(t.n);
  return indicados.some(i => {
    const k = chaveCidade(i);
    return k === nome || k.includes(nome) || nome.includes(k);
  });
}
function atualizarTecnicosChamado() {
  const select = el('c-tecnico');
  if (!select) return;

  const skill = el('c-sk')?.value || '';
  const regiao = el('c-re')?.value || '';
  const area = el('c-area')?.value || '';

  // Lista todos os técnicos cadastrados que atendem a região/área selecionada
  // e, quando informada, possuem a skill escolhida. A lista de técnicos
  // indicada na planilha do circuito é mantida apenas como referência.
  let lista = D.tc.filter(t => {
    const skillOk = !skill || skillsTec(t).includes(skill);
    const regiaoOk = !regiao || t.r === regiao;

    if (!regiaoOk || !skillOk) return false;

    // Interior: todos os técnicos cadastrados como interior.
    if (regiao === 'interior') return true;

    // Capital: quando uma área foi selecionada, somente os técnicos
    // cadastrados para aquela área.
    if (area) return areasTec(t).includes(area);

    // Capital sem área definida: todos os técnicos da capital.
    return true;
  });

  // A liberação excepcional permite técnicos de outra área, mas continua
  // respeitando região e skill.
  if (el('c-liberar-area')?.checked && regiao === 'capital' && area) {
    lista = D.tc.filter(t =>
      t.r === regiao &&
      (!skill || skillsTec(t).includes(skill))
    );
  }

  const valorAnterior = String(select.value || '').trim();
  select.innerHTML = '<option value="">Selecione...</option>' + lista.map(t => {
    const areas = areasTec(t).map(nomeArea).join('/');
    return `<option value="${esc(t.u)}">${esc(t.n)} — ${skillsTec(t).map(nomeSkill).join('/')} — ${esc(areas)}</option>`;
  }).join('');

  if (!lista.length) {
    select.innerHTML += '<option value="" disabled>Nenhum técnico cadastrado para esta região/skill</option>';
  } else if (valorAnterior && lista.some(t => String(t.u || '').trim() === valorAnterior)) {
    select.value = valorAnterior;
  }
}

function atualizarCamposRegiao() {
  const regiaoTec = el('t-r').value;
  document.querySelectorAll('input[name="t-ar"]').forEach(x => {
    const disponivel = regiaoTec === 'capital'
      ? !['interior','noronha'].includes(x.value)
      : (regiaoTec === 'noronha' ? x.value === 'noronha' : x.value === 'interior');
    x.disabled = !disponivel;
    if (!disponivel) x.checked = false;
  });
  const entregaBox=el('t-entrega-box');
  if(entregaBox) entregaBox.classList.toggle('hidden',regiaoTec==='capital');
  const capitalChamado = el('c-re').value === 'capital';
  el('c-area-box').classList.toggle('hidden', !capitalChamado);
  if (!capitalChamado) el('c-area').value = '';
  atualizarTecnicosChamado();
}

function tm(iso, reg) {
  if (!iso) return { t: '00:00:00', c: 't-g', s: 0 };
  const d = Math.floor((Date.now() - new Date(iso)) / 1000);
  const s = SLA[reg] || SLA.capital;
  let c = 't-g';
  if (d > s.r) c = 't-c';
  else if (d > s.a) c = 't-r';
  else if (d > s.v) c = 't-y';
  const h = String(Math.floor(d / 3600)).padStart(2, '0');
  const m = String(Math.floor((d % 3600) / 60)).padStart(2, '0');
  const sec = String(d % 60).padStart(2, '0');
  return { t: `${h}:${m}:${sec}`, c, s: d };
}

// ========== NAVEGAÇÃO ==========
function el(id) { return document.getElementById(id); }
function hide(id) { const e = el(id); if(e) e.classList.add('hidden'); }
function show(id) { const e = el(id); if(e) e.classList.remove('hidden'); }

function showLogin(t) {
  loginType = t;
  hide('t0');
  show('t1');
  el('lu').value = '';
  el('lp').value = '';
  el('le').style.display = 'none';
  if (t === 'adm') {
    el('li').textContent = '🛡️';
    el('lt').textContent = 'Área Administrador';
    el('ls').textContent = 'Use seu usuário e senha';
  } else if (t === 'log') {
    el('li').textContent = '🚚';
    el('lt').textContent = 'Área Logística';
    el('ls').textContent = 'Use o acesso criado pelo administrador';
  } else {
    el('li').textContent = '👷';
    el('lt').textContent = 'Área do Técnico';
    el('ls').textContent = 'Use seu usuário e senha';
  }
}

function goHome() {
  hide('t1'); hide('pa'); hide('pt'); hide('plog');
  show('t0');
}

function logout() {
  S = null; lsRemove('ss'); goHome();
}

function usuarioAtual() {
  if (!S) return null;
  return ((S.t === 'adm' || S.t === 'log') ? D.ad : D.tc).find(x => x.u === S.u) || null;
}

function abrirMinhaSenha() {
  const u = usuarioAtual(); if (!u) return;
  el('ms-email').value = u.e || ''; el('ms-atual').value = ''; el('ms-nova').value = ''; el('ms-conf').value = '';
  el('m-senha').classList.add('a');
}

function salvarMinhaSenha() {
  const u = usuarioAtual(); if (!u) return;
  const email = el('ms-email').value.trim().toLowerCase();
  const atual = el('ms-atual').value, nova = el('ms-nova').value, conf = el('ms-conf').value;
  if (!emailValido(email)) { alert('Informe um e-mail válido'); return; }
  if (atual !== u.s) { alert('A senha atual está incorreta'); return; }
  if (nova.length < 6) { alert('A nova senha deve ter pelo menos 6 caracteres'); return; }
  if (nova !== conf) { alert('A confirmação da nova senha não confere'); return; }
  if ([...D.tc, ...D.ad].some(x => x !== u && x.e === email)) { alert('Este e-mail já está cadastrado'); return; }
  u.e = email; u.s = nova; sv(); el('m-senha').classList.remove('a');
  alert('E-mail e senha atualizados com sucesso.');
}

function gerarSenha() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#';
  const bytes = new Uint32Array(10); crypto.getRandomValues(bytes);
  return Array.from(bytes, n => chars[n % chars.length]).join('');
}

function recuperarSenha() {
  const usuario = el('rec-u').value.trim();
  const email = el('rec-e').value.trim().toLowerCase();
  const lista = loginType === 'adm' ? D.ad : D.tc;
  const conta = lista.find(x => x.u === usuario && x.e && x.e.toLowerCase() === email);
  if (!conta) { alert('Usuário e e-mail não correspondem a uma conta cadastrada'); return; }
  const nova = gerarSenha(); conta.s = nova; sv();
  const assunto = encodeURIComponent('Nova senha — Despacho Técnico');
  const corpo = encodeURIComponent(`Olá, ${conta.n}.\n\nSua nova senha temporária é: ${nova}\n\nEntre no sistema e altere-a em “Alterar senha”.`);
  el('m-rec').classList.remove('a');
  window.location.href = `mailto:${encodeURIComponent(conta.e)}?subject=${assunto}&body=${corpo}`;
  alert('A nova senha foi gerada. Confirme o envio no programa de e-mail que será aberto.');
}

function doLogin() {
  const u = el('lu').value.trim();
  const p = el('lp').value;
  if (!u || !p) { el('le').style.display = 'block'; return; }
  if (loginType === 'adm') {
    const a = D.ad.find(x => x.u === u && x.s === p);
    if (a) { S = { t: 'adm', n: a.n, u: a.u, p: !!a.p }; ss(); enterAdm(); }
    else el('le').style.display = 'block';
  } else {
    const te = D.tc.find(x => x.u === u && x.s === p);
    if (te) { S = { t: 'tec', n: te.n, u: te.u, r: te.r }; ss(); enterTec(); }
    else el('le').style.display = 'block';
  }
}

function enterAdm() {
  hide('t0'); hide('t1'); hide('pt'); show('pa');
  el('an').textContent = S.n;
  admTab(el('nv').querySelector('[data-tab="db"]'), 'db');
  startLoop();
}

function enterLog() {
  hide('t0'); hide('t1'); hide('pa'); hide('pt'); show('plog');
  el('ln').textContent = S.n;
  rLog();
  startLoop();
}

function enterTec() {
  hide('t0'); hide('t1'); hide('pa'); show('pt');
  el('tn').textContent = S.n;
  const b = S.r === 'noronha'
    ? '<span class="badge b-capital">🏝️ Fernando de Noronha (6h)</span>'
    : (S.r === 'capital' ? '<span class="badge b-capital">🏙️ Capital (6h)</span>' : '<span class="badge b-interior">🌾 Interior (8h)</span>');
  el('tr').innerHTML = b;
  tecTab(el('nv2').querySelector('[data-tab="db"]'), 'db');
  startLoop();
}

// ========== ABAS ==========
function admTab(btn, a) {
  document.querySelectorAll('#nv button').forEach(b => b.classList.remove('a'));
  if (btn) btn.classList.add('a');
  ['db','tc','ch','at','rl','ml','ad'].forEach(x => {
    const e = el('v-'+x);
    if(e) e.classList.toggle('hidden', x !== a);
  });
  if (a === 'db') rDb();
  if (a === 'tc') rTc();
  if (a === 'ch') rCh();
  if (a === 'at') rAt();
  if (a === 'rl') rRl();
  if (a === 'ml') rMl();
  if (a === 'ad') rAd();
}

function tecTab(btn, a) {
  document.querySelectorAll('#nv2 button').forEach(b => b.classList.remove('a'));
  if (btn) btn.classList.add('a');
  ['db','dp','at','co','ar','mt'].forEach(x => {
    const e = el('t-'+x);
    if(e) e.classList.toggle('hidden', x !== a);
  });
  if (a === 'db') rTdb();
  if (a === 'dp') rTdp();
  if (a === 'at') rTat();
  if (a === 'co') rTco();
  if (a === 'ar') rTar();
  if (a === 'mt') rTmat();
}

// ========== MATERIAIS / LOGÍSTICA ==========
function escM(v){ return esc(v); }
function materialById(id){ return D.mat.find(m=>m.id===id); }
const LOG_TAG='[[LOGISTICA]]';
function logMeta(r){
  const s=String(r?.obs||''), i=s.lastIndexOf(LOG_TAG);
  if(i<0)return {};
  try{return JSON.parse(s.slice(i+LOG_TAG.length).trim())||{};}catch(e){return {};}
}
function logObsBase(r){const s=String(r?.obs||''),i=s.lastIndexOf(LOG_TAG);return (i<0?s:s.slice(0,i)).trim();}
function logObs(r,meta){const base=logObsBase(r);return (base?base+'\n':'')+LOG_TAG+JSON.stringify(meta);}
function tecnicoMaterial(r){return D.tc.find(t=>t.u===r.tecnico);}
function materialInterior(r){const t=tecnicoMaterial(r);return t && (t.r==='interior'||t.r==='noronha');}
function logStatus(r){
  const m=logMeta(r);
  if(r.status==='entregue')return ['b-concluida','Entregue'];
  if(m.etapa==='em_transito')return ['b-andamento','Em trânsito'];
  if(m.etapa==='aguardando_aceite')return ['b-pendente','Aguardando aceite'];
  return {solicitado:['b-pendente','Solicitado'],direcionado:['b-andamento','Na separação'],separado:['b-andamento','Separado'],cancelado:['b-recusado','Cancelado']}[r.status]||['b-pendente',r.status];
}
function logDetalhes(r){
  const m=logMeta(r),base=logObsBase(r);
  return `${base?`<div class="os-r"><b>Observação:</b> ${escM(base)}</div>`:''}
    ${m.rastreamento?`<div class="os-r"><b>Código de rastreamento:</b> ${escM(m.rastreamento)}</div>`:''}
    ${m.prazo?`<div class="os-r"><b>Previsão de entrega:</b> ${escM(new Date(m.prazo+'T12:00:00').toLocaleDateString('pt-BR'))}</div>`:''}`;
}
function rMl(){
  const box=el('ml-solicitacoes'); if(!box) return;
  const list=D.mr.slice().reverse();
  box.innerHTML=list.length?list.map(r=>{
    const m=materialById(r.materialId),c=D.ch.find(x=>x.id===r.chamadoId),st=logStatus(r);
    return `<div class="os"><div class="os-h"><span class="os-id">📦 ${escM(m?m.nome:r.materialNome)} — ${r.qtdSolicitada} ${escM(m?m.unidade:'')}</span><span class="badge ${st[0]}">${st[1]}</span></div>
      <div class="os-r"><b>Protocolo:</b> ${escM(c?c.pr:r.protocolo||'—')} &nbsp; <b>Técnico:</b> ${escM(nt(r.tecnico))}</div>
      <div class="os-r"><b>Destino:</b> ${materialInterior(r)?'Interior / Fernando de Noronha':'Capital'} &nbsp; <b>Separado:</b> ${r.qtdSeparada||0} &nbsp; <b>Entregue:</b> ${r.qtdEntregue||0}</div>
      ${logDetalhes(r)}
      ${r.responsavel?`<div class="os-r"><b>Responsável logística:</b> ${escM(r.responsavel)}</div>`:''}
      <div style="margin-top:8px">${r.status==='solicitado'?`<button class="btn btn-y btn-mat-direcionar" data-id="${r.id}">➡️ Direcionar para separação</button>`:''}</div></div>`;
  }).join(''):'<div class="empty"><h3>Nenhuma solicitação de material</h3></div>';
  rRastreioMateriais('ml-rastreio-lista');
  rMlEstoque(); rMateriaisCadastro();
}
function rMlEstoque(){
 const s=el('ml-estoque-material');
 if(!s)return;
 const valorSelecionado=s.value || '';
 const qCampo=el('ml-estoque-qtd');
 const qtdAtual=qCampo ? qCampo.value : '';
 s.innerHTML='<option value="">Selecione...</option>'+D.mat.map(m=>`<option value="${m.id}">${escM(m.nome)} (${m.unidade})</option>`).join('');
 if(valorSelecionado && D.mat.some(m=>String(m.id)===String(valorSelecionado))){
   s.value=valorSelecionado;
   if(qCampo && qtdAtual!=='') qCampo.value=qtdAtual;
 }
 const b=el('ml-estoque-lista');
 if(!b)return;
 b.innerHTML=D.mat.length?'<div style="overflow-x:auto"><table class="table"><thead><tr><th>Material</th><th>Unidade</th><th>Estoque</th><th>Situação</th></tr></thead><tbody>'+D.mat.map(m=>`<tr><td>${escM(m.nome)}</td><td>${escM(m.unidade)}</td><td><b>${m.estoque||0}</b></td><td><span class="badge ${(m.estoque||0)>0?'b-concluida':'b-recusado'}">${(m.estoque||0)>0?'Disponível':'Sem estoque'}</span></td></tr>`).join('')+'</tbody></table></div>':'<div class="empty">Nenhum material cadastrado.</div>';
}

function rMateriaisCadastro(){const b=el('mat-cadastro-lista');if(!b)return;b.innerHTML=D.mat.length?'<div style="overflow-x:auto"><table class="table"><thead><tr><th>Material</th><th>Unidade</th><th>Estoque</th><th></th></tr></thead><tbody>'+D.mat.map(m=>`<tr><td>${escM(m.nome)}</td><td>${m.unidade}</td><td>${m.estoque||0}</td><td><button class="btn btn-r btn-rm-mat" data-id="${m.id}">Excluir</button></td></tr>`).join('')+'</tbody></table></div>':'<div class="empty">Cadastre os materiais disponíveis.</div>'}
function addMaterial(){const nome=el('mat-nome').value.trim(),un=el('mat-un').value;if(!nome){alert('Informe o material');return;}if(D.mat.some(m=>m.nome.toLowerCase()===nome.toLowerCase())){alert('Material já cadastrado');return;}D.mat.push({id:'MAT-'+Date.now(),nome,unidade:un,estoque:0,c:ag()});sv();el('mat-nome').value='';rMl();alert('Material cadastrado com sucesso!');}
function ajusteEstoque(){const id=el('ml-estoque-material').value,q=Number(el('ml-estoque-qtd').value);const m=materialById(id);if(!m||q<0){alert('Selecione o material e informe uma quantidade válida');return;}m.estoque=q;sv();rMl();alert('Estoque atualizado.');}
async function direcionarMaterial(id){
  const r=D.mr.find(x=>x.id===id);
  if(!r)return;
  const btn=document.querySelector('.btn-mat-direcionar[data-id="'+CSS.escape(String(id))+'"]');
  const textoBtn=btn?.textContent;
  try{
    if(btn){btn.disabled=true;btn.textContent='Salvando no Supabase...';}
    const confirmado=await sbDirecionarMaterial(r);
    r.status='direcionado';
    r.direcionadoEm=confirmado.direcionado_em;
    r.direcionadoPor=S.n;
    r.responsavel=S.n;
    lsSet('dd',D);
    rMl();
    alert('Solicitação direcionada e confirmada no servidor.');
  }catch(err){
    sbShowError('Não foi possível direcionar para separação',err);
    await sbRecarregarDados();
  }finally{
    if(btn&&document.body.contains(btn)){btn.disabled=false;btn.textContent=textoBtn||'➡️ Direcionar para separação';}
  }
}
async function logAtualizarSolicitacao(r,campos){
  const {data,error}=await SB.from('solicitacoes_material').update(campos).eq('id',r.id).select('*').single();
  if(error)throw error; return data;
}
async function separarMaterial(id){
  const r=D.mr.find(x=>x.id===id),m=r&&materialById(r.materialId);if(!r||!m)return;
  const q=Number(prompt(`Quantidade a separar (solicitada: ${r.qtdSolicitada}; estoque: ${m.estoque||0})`,String(r.qtdSolicitada)));
  if(!q||q<1)return;if(q>(m.estoque||0)){alert('Quantidade superior ao estoque disponível.');return;}
  try{
    const novoEstoque=(m.estoque||0)-q,obs=logObs(r,{...logMeta(r),etapa:'separado'});
    const {error:me}=await SB.from('materiais').update({estoque:novoEstoque}).eq('id',m.id);if(me)throw me;
    try{await logAtualizarSolicitacao(r,{status:'separado',quantidade_separada:q,separado_em:new Date().toISOString(),responsavel_id:SB_PROFILE.id,observacao:obs});}
    catch(e){await SB.from('materiais').update({estoque:m.estoque||0}).eq('id',m.id);throw e;}
    await sbRecarregarDados();alert('Material separado e confirmado no servidor.');
  }catch(e){sbShowError('Não foi possível registrar a separação',e);await sbRecarregarDados();}
}
async function liberarMaterial(id){
  const r=D.mr.find(x=>x.id===id);if(!r)return;
  try{await logAtualizarSolicitacao(r,{observacao:logObs(r,{...logMeta(r),etapa:'aguardando_aceite'})});await sbRecarregarDados();alert('Material liberado para aceite do técnico.');}
  catch(e){sbShowError('Não foi possível liberar o material',e);}
}
async function enviarMaterial(id){
  const r=D.mr.find(x=>x.id===id);if(!r)return;
  const atual=logMeta(r);
  const rastreamento=prompt('Informe o código de rastreamento do envio:',atual.rastreamento||'');if(!rastreamento?.trim())return;
  const prazo=prompt('Informe a previsão de entrega (AAAA-MM-DD):',atual.prazo||'');
  if(!/^\d{4}-\d{2}-\d{2}$/.test(prazo||'')){alert('Informe a previsão no formato AAAA-MM-DD.');return;}
  try{
    await logAtualizarSolicitacao(r,{observacao:logObs(r,{...atual,etapa:'em_transito',rastreamento:rastreamento.trim(),prazo,transitoEm:atual.transitoEm||new Date().toISOString()})});
    await sbRecarregarDados();alert('Expedição e rastreamento confirmados no servidor.');
  }catch(e){sbShowError('Não foi possível registrar o envio',e);}
}
function consultarCorreiosOficial(id){
  const r=D.mr.find(x=>x.id===id),codigo=r&&logMeta(r).rastreamento;if(!codigo){alert('Informe primeiro o código de rastreamento.');return;}
  if(navigator.clipboard)navigator.clipboard.writeText(codigo).catch(()=>{});
  window.open('https://rastreamento.correios.com.br/app/index.php','_blank','noopener');
  alert('Código '+codigo+' copiado. Cole-o na página oficial dos Correios.');
}
async function aceitarMaterial(id){
  const r=D.mr.find(x=>x.id===id);if(!r||r.tecnico!==S.u)return;
  const q=r.qtdSeparada||r.qtdSolicitada;
  if(!confirm('Confirma que recebeu este material?'))return;
  try{await logAtualizarSolicitacao(r,{status:'entregue',quantidade_entregue:q,entregue_em:new Date().toISOString(),observacao:logObs(r,{...logMeta(r),etapa:'entregue'})});await sbRecarregarDados();alert('Recebimento confirmado. Status atualizado para entregue.');}
  catch(e){sbShowError('Não foi possível confirmar o recebimento',e);}
}
function rastreioData(v){if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?escM(v):d.toLocaleString('pt-BR');}
function rastreioTramite(r){
 const meta=logMeta(r),direcionado=r.status!=='solicitado',separado=['separado','entregue'].includes(r.status),transito=!!meta.rastreamento,entregue=r.status==='entregue';
 const passos=[
  ['Solicitado',true,r.data],['Direcionado',direcionado,r.direcionadoEm],['Separado',separado,r.separadoEm],
  ['Em transporte',transito,meta.transitoEm],['Entregue ao técnico',entregue,r.entregueEm]
 ];
 return '<div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0">'+passos.map(p=>`<span class="badge ${p[1]?'b-concluida':'b-pendente'}" title="${p[2]?escM(rastreioData(p[2])):'Pendente'}">${p[1]?'✓':'○'} ${p[0]}</span>`).join('')+'</div>';
}
function rRastreioMateriais(targetId){
 const box=el(targetId);if(!box)return;
 const list=D.mr.filter(r=>materialInterior(r)&&r.status!=='cancelado').slice().reverse();
 box.innerHTML=list.length?list.map(r=>{
  const m=materialById(r.materialId),c=D.ch.find(x=>x.id===r.chamadoId),meta=logMeta(r),st=logStatus(r),tec=tecnicoMaterial(r),destino=enderecoEntregaTec(tec);
  const podeRastrear=['separado'].includes(r.status);
  return `<div class="os"><div class="os-h"><span class="os-id">📦 ${escM(m?m.nome:r.materialNome)} — ${r.qtdSeparada||r.qtdSolicitada} ${escM(m?m.unidade:'')}</span><span class="badge ${st[0]}">${st[1]}</span></div>
   <div class="os-r"><b>Protocolo:</b> ${escM(c?c.pr:r.protocolo||'—')} &nbsp; <b>Técnico:</b> ${escM(nt(r.tecnico))}</div>
   <div class="os-r"><b>Localidade:</b> ${tecnicoMaterial(r)?.r==='noronha'?'Fernando de Noronha':'Interior'}</div>
   <div class="os-r"><b>Endereço de entrega:</b> ${escM(enderecoEntregaTexto(tec)||'Não cadastrado')}</div>
   ${destino.contato?`<div class="os-r"><b>Contato para entrega:</b> ${escM(destino.contato)}</div>`:''}
   ${rastreioTramite(r)}
   <div class="os-r"><b>Código de rastreamento:</b> ${escM(meta.rastreamento||'Ainda não informado')}</div>
   <div class="os-r"><b>Previsão de entrega:</b> ${meta.prazo?escM(new Date(meta.prazo+'T12:00:00').toLocaleDateString('pt-BR')):'Ainda não informada'}</div>
   ${meta.rastreamento?`<div style="margin-top:8px"><button class="btn btn-s btn-correios" data-id="${r.id}">🔎 Consultar no site oficial dos Correios</button></div>`:''}
   ${podeRastrear?`<div style="margin-top:8px"><button class="btn btn-p btn-log-enviar" data-id="${r.id}">🚚 ${meta.rastreamento?'Atualizar rastreio':'Informar rastreio e previsão'}</button></div>`:''}
  </div>`;
 }).join(''):'<div class="empty"><h3>Nenhum material destinado ao interior</h3></div>';
}
function rLogEstoque(){
 const s=el('lg-estoque-material'),b=el('lg-estoque-lista');if(!s||!b)return;
 const selecionado=s.value||'',q=el('lg-estoque-qtd'),qtdAtual=q?q.value:'';
 s.innerHTML='<option value="">Selecione...</option>'+D.mat.map(m=>`<option value="${m.id}">${escM(m.nome)} (${escM(m.unidade)})</option>`).join('');
 if(selecionado&&D.mat.some(m=>String(m.id)===String(selecionado))){s.value=selecionado;if(q&&qtdAtual!=='')q.value=qtdAtual;}
 b.innerHTML=D.mat.length?'<div style="overflow-x:auto"><table class="table"><thead><tr><th>Material</th><th>Unidade</th><th>Estoque</th><th>Situação</th></tr></thead><tbody>'+D.mat.map(m=>`<tr><td>${escM(m.nome)}</td><td>${escM(m.unidade)}</td><td><b>${m.estoque||0}</b></td><td><span class="badge ${(m.estoque||0)>0?'b-concluida':'b-recusado'}">${(m.estoque||0)>0?'Disponível':'Sem estoque'}</span></td></tr>`).join('')+'</tbody></table></div>':'<div class="empty">Nenhum material cadastrado.</div>';
}
async function ajusteEstoqueLogistica(){
 const id=el('lg-estoque-material')?.value,q=Number(el('lg-estoque-qtd')?.value),m=materialById(id),btn=el('btn-lg-ajuste');
 if(!m||!Number.isFinite(q)||q<0){alert('Selecione o material e informe uma quantidade válida');return;}
 const texto=btn?.innerHTML;
 try{
   if(btn){btn.disabled=true;btn.textContent='Salvando no Supabase...';}
   const {data,error}=await SB.from('materiais').update({estoque:q,atualizado_em:new Date().toISOString()}).eq('id',m.id).select('id,estoque').single();
   if(error)throw error;
   m.estoque=Number(data.estoque||0);lsSet('dd',D);rLogEstoque();
   alert('Quantidade do estoque confirmada no servidor.');
 }catch(e){sbShowError('Não foi possível atualizar o estoque',e);await sbRecarregarDados();}
 finally{if(btn){btn.disabled=false;btn.innerHTML=texto||'💾 Salvar Quantidade';}}
}
function rLog(){
 const box=el('lg-list');if(!box)return;
 const list=D.mr.slice().reverse();
 box.innerHTML=list.length?list.map(r=>{
   const m=materialById(r.materialId),c=D.ch.find(x=>x.id===r.chamadoId),st=logStatus(r),meta=logMeta(r),interior=materialInterior(r),tec=tecnicoMaterial(r),destino=enderecoEntregaTec(tec);
   let acao='';
   if(r.status==='direcionado')acao=`<button class="btn btn-g btn-mat-separar" data-id="${r.id}">📦 Registrar separação</button>`;
   else if(r.status==='separado'&&meta.etapa==='separado')acao=interior?`<button class="btn btn-p btn-log-enviar" data-id="${r.id}">🚚 Informar envio e rastreio</button>`:`<button class="btn btn-p btn-log-liberar" data-id="${r.id}">🤝 Liberar para aceite</button>`;
   return `<div class="os"><div class="os-h"><span class="os-id">📦 ${escM(m?m.nome:r.materialNome)} — ${r.qtdSolicitada} ${escM(m?m.unidade:'')}</span><span class="badge ${st[0]}">${st[1]}</span></div>
    <div class="os-r"><b>Protocolo:</b> ${escM(c?c.pr:r.protocolo||'—')} &nbsp; <b>Técnico:</b> ${escM(nt(r.tecnico))}</div>
    <div class="os-r"><b>Destino:</b> ${interior?'Interior / Fernando de Noronha':'Capital'} &nbsp; <b>Itens separados:</b> ${r.qtdSeparada||0}</div>
    ${interior?`<div class="os-r"><b>Entrega:</b> ${escM(enderecoEntregaTexto(tec)||'Endereço não cadastrado')}${destino.contato?' — Contato: '+escM(destino.contato):''}</div>`:''}
    ${logDetalhes(r)}<div style="margin-top:8px">${acao}</div></div>`;
 }).join(''):'<div class="empty"><h3>Nenhuma solicitação logística</h3></div>';
 rRastreioMateriais('lg-rastreio-lista');
 rLogEstoque();
}
function rTmat(){
 const ps=el('tm-protocolo'),ms=el('tm-material'),box=el('tm-lista');if(!ps||!ms||!box)return;
 const protocoloSelecionado=ps.value||'',materialSelecionado=ms.value||'';
 const meus=D.ch.filter(c=>c.te===S.u); ps.innerHTML='<option value="">Selecione...</option>'+meus.map(c=>`<option value="${c.id}">${escM(c.pr)} — ${escM(c.si)}</option>`).join('');
 ms.innerHTML='<option value="">Selecione...</option>'+D.mat.map(m=>`<option value="${m.id}">${escM(m.nome)} (${m.unidade}) — estoque ${m.estoque||0}</option>`).join('');
 if(meus.some(c=>String(c.id)===String(protocoloSelecionado))) ps.value=protocoloSelecionado;
 if(D.mat.some(m=>String(m.id)===String(materialSelecionado))) ms.value=materialSelecionado;
 const list=D.mr.filter(r=>r.tecnico===S.u).slice().reverse();
 box.innerHTML=list.length?list.map(r=>{const m=materialById(r.materialId),c=D.ch.find(x=>x.id===r.chamadoId),st=logStatus(r),meta=logMeta(r),aceitar=r.status==='separado'&&['aguardando_aceite','em_transito'].includes(meta.etapa);return `<div class="os"><div class="os-h"><span class="os-id">📦 ${escM(m?m.nome:r.materialNome)}</span><span class="badge ${st[0]}">${st[1]}</span></div><div class="os-r"><b>Protocolo:</b> ${escM(c?c.pr:r.protocolo)}</div><div class="os-r"><b>Itens:</b> ${r.qtdSolicitada} ${m?m.unidade:''} &nbsp; <b>Separado:</b> ${r.qtdSeparada||0}</div>${logDetalhes(r)}${aceitar?`<div style="margin-top:8px"><button class="btn btn-g btn-tech-aceitar-material" data-id="${r.id}">✅ Confirmar recebimento</button></div>`:''}</div>`}).join(''):'<div class="empty"><h3>Nenhuma solicitação de material</h3></div>';
}
function solicitarMaterial(){const cid=el('tm-protocolo').value,mid=el('tm-material').value,q=Number(el('tm-qtd').value),obs=el('tm-obs').value.trim(),c=D.ch.find(x=>x.id===cid),m=materialById(mid);if(!cid||!mid||!q||q<1){alert('Preencha protocolo, material e quantidade');return;}if(D.mr.some(r=>r.chamadoId===cid&&r.materialId===mid&&['solicitado','direcionado','separado'].includes(r.status))){alert('Já existe uma solicitação pendente deste material para este chamado.');return;}D.mr.push({id:'MR-'+Date.now(),chamadoId:cid,tecnico:S.u,materialId:mid,qtdSolicitada:q,qtdSeparada:0,qtdEntregue:0,status:'solicitado',obs,data:ag(),protocolo:c?c.pr:'',infoChamado:c?`${c.si} — ${c.de}`:''});sv();el('tm-material').value='';el('busca-material-tecnico').value='';el('tm-qtd').value='';el('tm-obs').value='';rTmat();alert('Solicitação enviada ao administrador.');}

// ========== CADASTROS ==========
function limparCEP(v){return String(v||'').replace(/\D/g,'').slice(0,8);}
function formatarCEP(v){const s=limparCEP(v);return s.length>5?s.slice(0,5)+'-'+s.slice(5):s;}
function enderecoEntregaFormulario(){return {
  cep:formatarCEP(el('t-cep')?.value),
  cidade:(el('t-cidade-entrega')?.value||'').trim(),
  endereco:(el('t-endereco-entrega')?.value||'').trim(),
  complemento:(el('t-complemento-entrega')?.value||'').trim(),
  contato:(el('t-contato-entrega')?.value||'').trim()
};}
function limparEnderecoEntregaFormulario(){['t-cep','t-cidade-entrega','t-endereco-entrega','t-complemento-entrega','t-contato-entrega'].forEach(id=>{if(el(id))el(id).value='';});}
async function buscarCEPFormulario(){
  const cep=limparCEP(el('t-cep')?.value);if(cep.length!==8)return;
  try{
    const resp=await fetch('https://viacep.com.br/ws/'+cep+'/json/');
    if(!resp.ok)throw new Error('CEP não localizado');
    const d=await resp.json();if(d.erro)throw new Error('CEP não localizado');
    if(el('t-endereco-entrega')&&!el('t-endereco-entrega').value)el('t-endereco-entrega').value=[d.logradouro,d.bairro].filter(Boolean).join(', ');
    if(el('t-cidade-entrega'))el('t-cidade-entrega').value=[d.localidade,d.uf].filter(Boolean).join(' - ');
  }catch(e){console.warn('Busca de CEP indisponível',e);}
}
async function editarEnderecoTecnico(usuario){
  const t=D.tc.find(x=>x.u===usuario);if(!t||!t._id)return;
  const atual=enderecoEntregaTec(t);
  const cep=prompt('CEP para entrega:',atual.cep||'');if(cep===null)return;
  if(limparCEP(cep).length!==8){alert('Informe um CEP válido com 8 números.');return;}
  const endereco=prompt('Rua / avenida / sítio:',atual.endereco||'');if(endereco===null)return;
  const complemento=prompt('Número, bairro, complemento e referência:',atual.complemento||'');if(complemento===null)return;
  const cidade=prompt('Cidade / UF:',atual.cidade||'');if(cidade===null)return;
  const contato=prompt('Contato para entrega:',atual.contato||'');if(contato===null)return;
  const entrega={cep:formatarCEP(cep),endereco:endereco.trim(),complemento:complemento.trim(),cidade:cidade.trim(),contato:contato.trim()};
  if(!entrega.endereco||!entrega.cidade){alert('Informe o endereço e a cidade.');return;}
  try{
    const areas=areasComEndereco(t.ar,entrega);
    const {error}=await SB.from('perfis').update({areas}).eq('id',t._id);if(error)throw error;
    await sbLoadAll();rTc();alert('Endereço de entrega atualizado no servidor.');
  }catch(e){sbShowError('Não foi possível salvar o endereço',e);}
}
function addTec() {
  const n = el('t-n').value.trim();
  const u = el('t-u').value.trim();
  const s = el('t-s').value;
  const sc = el('t-sc').value;
  const e = el('t-e').value.trim().toLowerCase();
  const r = el('t-r').value;
  const sk = selecionados('t-sk');
  const ar = selecionados('t-ar');
  if (!n || !u || !e || !s || !sc) { alert('Preencha todos os campos'); return; }
  if (!emailValido(e)) { alert('Informe um e-mail válido'); return; }
  if (s.length < 6) { alert('A senha deve ter pelo menos 6 caracteres'); return; }
  if (s !== sc) { alert('A confirmação da senha não confere'); return; }
  if ([...D.tc, ...D.ad].some(x => x.e === e)) { alert('E-mail já cadastrado'); return; }
  if (!sk.length) { alert('Selecione pelo menos uma skill para o técnico'); return; }
  if (!ar.length) { alert('Selecione pelo menos uma área de atendimento'); return; }
  if (D.tc.find(x => x.u === u)) { alert('Usuário já existe'); return; }
  D.tc.push({ n, u, e, s, r, sk, ar, c: ag() });
  sv();
  el('t-n').value = ''; el('t-u').value = ''; el('t-e').value = ''; el('t-s').value = ''; el('t-sc').value = '';
  document.querySelectorAll('input[name="t-sk"],input[name="t-ar"]').forEach(x => { x.checked = false; });
  el('t-multi').checked = false;
  rTc();
  alert('Técnico cadastrado com sucesso!');
}

function addAdm() {
  const n = el('a-n').value.trim();
  const u = el('a-u').value.trim();
  const s = el('a-s').value;
  const sc = el('a-sc').value;
  const e = el('a-e').value.trim().toLowerCase();
  if (!n || !u || !e || !s || !sc) { alert('Preencha todos os campos'); return; }
  if (!emailValido(e)) { alert('Informe um e-mail válido'); return; }
  if (s.length < 6) { alert('A senha deve ter pelo menos 6 caracteres'); return; }
  if (s !== sc) { alert('A confirmação da senha não confere'); return; }
  if ([...D.tc, ...D.ad].some(x => x.e === e)) { alert('E-mail já cadastrado'); return; }
  if (D.ad.find(x => x.u === u)) { alert('Usuário já existe'); return; }
  D.ad.push({ n, u, e, s, p: false, c: ag() });
  sv();
  el('a-n').value = ''; el('a-u').value = ''; el('a-e').value = ''; el('a-s').value = ''; el('a-sc').value = '';
  rAd();
  alert('Administrador cadastrado com sucesso!');
}

function addCh() {
  const pr = el('c-pr').value.trim();
  const sdm = el('c-sdm').value.trim();
  const site = buscarCircuito();
  const abertura = el('c-abertura').value;
  const si = el('c-si').value.trim();
  const ci = el('c-ci').value.trim();
  const re = el('c-re').value;
  const skill = el('c-sk').value;
  const area = el('c-area').value;
  const tecnicoEl = el('c-tecnico');
  const tecnico = tecnicoEl ? String(tecnicoEl.value || '').trim() : '';
  const liberarArea = el('c-liberar-area').checked;
  const en = el('c-en').value.trim();
  const de = el('c-de').value.trim();
  if (!pr) { alert('Protocolo não localizado na descrição colada. Verifique se o texto contém a palavra “Protocolo” seguida do número.'); return; }
  if (!abertura) { alert('Selecione quem abriu o chamado'); return; }
  if (!site) { alert('Informe um circuito válido da base de dados'); return; }
  if (!skill) { alert('Selecione a skill necessária para o chamado'); return; }
  if (re === 'capital' && !area) { alert('Selecione a área de atendimento da capital'); return; }
  if (!tecnico) { alert('Selecione o técnico que atenderá o chamado'); return; }
  const dtexec = el('c-dtexec').value;
  D.ch.push({
    id: 'CH-'+Date.now(), pr, sdm, si, ci, re, skill, area: re === 'capital' ? area : '', en, de, dtexec,
    abertura,
    regiaoOperacional: el('c-regiao-planilha').value, tecnicosIndicados: el('c-tecnicos-planilha').value,
    cid: el('c-cd').value, contato: el('c-co').value, horario: el('c-ho').value,
    velocidade: el('c-ve').value, prtm: el('c-pt').value, pvfTotal: el('c-pv').value,
    st: 'pendente', te: tecnico, mr: '', tr: [], dt: liberarArea ? { tipo: 'liberacao-area', admin: S.n, d: ag(), area, regiaoOperacional: el('c-regiao-planilha').value } : null, ex: null,
    cr: ag(), ae: null, am: null, cc: null
  });
  sv();
  el('c-descricao-colada').value = ''; el('c-pr').value = ''; el('c-sdm').value = ''; el('c-abertura').value = ''; el('c-ci').value = ''; limparSite();
  el('c-regiao-planilha').value = ''; el('c-tecnicos-planilha').value = '';
  el('c-de').value = ''; el('c-dtexec').value = '';
  el('c-sk').value = ''; el('c-area').value = '';
  el('c-tecnico').innerHTML = '<option value="">Selecione primeiro a skill e a área...</option>'; el('c-liberar-area').checked = false;
  el('c-status').textContent = 'Cole a descrição para localizar automaticamente o circuito e carregar os dados do site.';
  el('c-status').style.color = 'var(--gr)';
  rCh();
  alert('Chamado criado com sucesso!');
}

// ========== RENDER ADMIN ==========
function rTc() {
  const tb = el('tb-tc');
  if(!tb) return;
  tb.innerHTML = D.tc.map(t => {
    const a = D.ch.filter(c => c.te === t.u && c.st === 'andamento').length;
    const r = nomeRegiao(t.r);
    const skTec = skillsTec(t);
    const sk = ['voz','dados','infra'].every(x => skTec.includes(x)) ? 'Multi-skill (Voz, Dados e Infra)' : skTec.map(nomeSkill).join(', ');
    const ar = areasTec(t).map(nomeArea).join(', ');
    const end=enderecoEntregaTexto(t)||((t.r==='interior'||t.r==='noronha')?'Não cadastrado':'Não se aplica');
    return `<tr><td>${escM(t.n)}</td><td>${escM(t.u)}</td><td>${escM(t.e || 'Não cadastrado')}</td><td>${r}</td><td>${escM(end)}</td><td>${sk}</td><td>${ar}</td><td>${a}</td><td><div style="display:flex;gap:4px;flex-wrap:wrap"><button class="btn btn-p btn-endereco-tec" data-u="${escM(t.u)}" style="padding:4px 8px;font-size:.6rem" title="Cadastrar ou alterar endereço de entrega">📍 Endereço</button><button class="btn btn-s btn-reset-senha" data-u="${escM(t.u)}" data-email="${escM(t.e || '')}" style="padding:4px 8px;font-size:.6rem" title="Enviar redefinição de senha">🔑 Redefinir</button><button class="btn btn-r btn-rm-tec" data-u="${escM(t.u)}" style="padding:4px 8px;font-size:.6rem" title="Excluir técnico">🗑️</button></div></td></tr>`;
  }).join('') || '<tr><td colspan="9" class="empty">Nenhum técnico cadastrado</td></tr>';
}

function rAd() {
  const tb = el('tb-ad');
  if(!tb) return;
  tb.innerHTML = D.ad.map(a =>
    `<tr><td>${a.n}${a.tipo==='logistica' ? ' <span class="badge b-andamento">Logística</span>' : (a.p ? ' <span class="badge b-pendente">Geral</span>' : '')}</td><td>${a.u}</td><td>${a.e || 'Não cadastrado'}</td><td><div style="display:flex;gap:4px;flex-wrap:wrap"><button class="btn btn-s btn-reset-senha" data-u="${a.u}" data-email="${a.e || ''}" style="padding:4px 8px;font-size:.6rem" title="Enviar redefinição de senha">🔑 Redefinir</button>${a.p ? '' : `<button class="btn btn-r btn-rm-adm" data-u="${a.u}" style="padding:4px 8px;font-size:.6rem" title="Excluir administrador">🗑️</button>`}</div></td></tr>`
  ).join('');
}

const JANELA_REINCIDENCIA_MS = 30 * 24 * 60 * 60 * 1000;
const LIMITE_PRAZO_MS = 5 * 60 * 60 * 1000;
function dataChamadoMs(c, preferirConclusao=false){
  const valor=preferirConclusao?(c.cc||c.dtexec||c.cr):(c.cr||c.dtexec||c.cc);
  const ms=new Date(valor||0).getTime();
  return Number.isFinite(ms)?ms:0;
}
function chaveCircuitoReincidencia(c){return numeroCircuito(c?.ci)||normalizarCircuito(c?.ci);}
function historicoAnteriorCircuito(c){
  const chave=chaveCircuitoReincidencia(c);
  const abertura=dataChamadoMs(c);
  if(!chave||!abertura)return null;
  const anteriores=D.ch.filter(x=>x.id!==c.id&&x.st==='concluida'&&chaveCircuitoReincidencia(x)===chave)
    .map(x=>({chamado:x,data:dataChamadoMs(x,true)}))
    .filter(x=>x.data&&x.data<=abertura&&abertura-x.data<JANELA_REINCIDENCIA_MS)
    .sort((a,b)=>b.data-a.data);
  return anteriores[0]||null;
}
function infoReincidencia(c){
  const anterior=historicoAnteriorCircuito(c);
  if(!anterior)return {reincidente:false,html:'<div class="info" style="margin-top:8px;border-left:4px solid var(--g)"><b>Reincidência:</b> Não — nenhum atendimento concluído para este circuito nos últimos 30 dias.</div>'};
  const a=anterior.chamado,acao=a.ex?.atv||a.ex?.relatorio||a.ex?.obs||'Ação não informada';
  const data=new Date(anterior.data).toLocaleDateString('pt-BR');
  return {reincidente:true,anterior:a,html:`<div class="trava" style="margin-top:8px;border-left:4px solid var(--r)"><b>⚠️ Reincidente em menos de 30 dias</b><br><b>Último técnico:</b> ${esc(nt(a.te)||'Não informado')}<br><b>Último atendimento:</b> ${data}<br><b>Ação realizada:</b> ${valorInfo(acao)}</div>`};
}
function dadosIndicadoresTecnicos(){
  const perdas=[];
  D.ch.forEach(c=>{if(c.st!=='concluida'||!c.am||!c.cc)return;const inicio=new Date(c.am).getTime(),fim=new Date(c.cc).getTime();if(Number.isFinite(inicio)&&Number.isFinite(fim)&&fim-inicio>LIMITE_PRAZO_MS)perdas.push({chamado:c,duracao:fim-inicio});});
  const reincidencias=[];
  D.ch.forEach(c=>{const anterior=historicoAnteriorCircuito(c);if(anterior)reincidencias.push({chamado:c,anterior:anterior.chamado,intervalo:dataChamadoMs(c)-anterior.data});});
  return {perdas,reincidencias};
}
function agruparRanking(itens,usuarioFn){
  const mapa={};itens.forEach(item=>{const u=usuarioFn(item)||'nao-informado';(mapa[u]||={usuario:u,nome:u==='nao-informado'?'Não informado':nt(u),qtd:0,itens:[]});mapa[u].qtd++;mapa[u].itens.push(item);});
  return Object.values(mapa).sort((a,b)=>b.qtd-a.qtd||String(a.nome).localeCompare(String(b.nome))).slice(0,5);
}
function barrasRanking(ranking,cor){
  if(!ranking.length)return '<div class="empty">Nenhum registro encontrado.</div>';
  const max=ranking[0].qtd||1;
  return ranking.map((x,i)=>`<div style="margin:9px 0"><div style="display:flex;justify-content:space-between;font-size:.72rem"><b>${i+1}. ${esc(x.nome)}</b><span>${x.qtd}</span></div><div style="height:9px;background:#e5e7eb;border-radius:999px;overflow:hidden;margin-top:4px"><div style="height:100%;width:${Math.max(8,x.qtd/max*100)}%;background:${cor};border-radius:999px"></div></div></div>`).join('');
}

function rCh() {
  const ab = D.ch.filter(c => c.st === 'aberto');
  const di = D.ch.filter(c => c.st === 'pendente');
  const re = D.ch.filter(c => c.st === 'recusado');
  const elAb = el('l-ab');
  const elDi = el('l-di');
  const elRe = el('l-re');
  if(elAb) elAb.innerHTML = ab.length ? ab.map(c => {
    const dtexec = c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : 'Não definida';
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="badge b-pendente">Aberto</span></div>
    ${dadosSite(c)}
    <div class="os-r"><b>Skill:</b> ${nomeSkill(c.skill)}${c.re === 'capital' ? ` — <b>Área:</b> ${nomeArea(c.area)}` : ''}</div>
    <div class="os-r"><b>Descrição:</b> ${c.de}</div>
    <div class="os-r"><b>Data Execução:</b> ${dtexec}</div>
    <div style="margin-top:8px;display:flex;gap:6px"><button class="btn btn-p btn-dp" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">🚚 Despachar</button>${adminGeral() ? `<button class="btn btn-r btn-del-ch" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">🗑️ Excluir</button>` : ''}</div></div>`;
  }).join('') : '<div class="empty"><h3>Nenhum chamado em aberto</h3></div>';

  if(elDi) elDi.innerHTML = di.length ? di.map(c => `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="badge b-pendente">Aguardando técnico</span></div>
    <div class="os-r"><b>Site:</b> ${c.si}</div><div class="os-r"><b>Quem abriu:</b> ${c.abertura || '—'}</div><div class="os-r"><b>Região operacional:</b> ${c.regiaoOperacional || (c.re === 'capital' ? nomeArea(c.area) : (c.re === 'noronha' ? 'Fernando de Noronha' : 'Interior'))} — SLA ${slaRegiao(c.re)}</div><div class="os-r"><b>Skill:</b> ${nomeSkill(c.skill)}${c.re === 'capital' ? ` — <b>Área:</b> ${nomeArea(c.area)}` : ''}</div><div class="os-r"><b>Técnico:</b> ${nt(c.te)}${c.dt && c.dt.tipo === 'liberacao-area' ? ' <span class="badge b-recusado">Liberação excepcional</span>' : ''}</div>
    ${infoReincidencia(c).html}
    <div style="margin-top:8px;display:flex;gap:6px"><button class="btn btn-p btn-redir" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">👷 Redirecionar</button>${adminGeral() ? `<button class="btn btn-r btn-del-ch" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">🗑️ Excluir</button>` : ''}</div></div>`).join('') : '<div class="empty"><h3>Nenhum chamado direcionado</h3></div>';

  if(elRe) elRe.innerHTML = re.length ? re.map(c => {
    const dtexec = c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : 'Não definida';
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="badge b-recusado">Recusado</span></div>
    <div class="os-r"><b>Site:</b> ${c.si}</div>
    <div class="os-r"><b>Técnico:</b> ${nt(c.te)}</div>
    <div class="os-r"><b>Motivo:</b> ${c.mr}</div>
    <div class="os-r"><b>Data Execução:</b> ${dtexec}</div>
    <div style="margin-top:8px;display:flex;gap:6px"><button class="btn btn-p btn-redir" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">👷 Redirecionar</button>${adminGeral() ? `<button class="btn btn-r btn-del-ch" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">🗑️ Excluir</button>` : ''}</div></div>`;
  }).join('') : '<div class="empty"><h3>Nenhum chamado recusado</h3></div>';
}

function rDb() {
  const p = D.ch.filter(c => c.st === 'pendente').length;
  const a = D.ch.filter(c => c.st === 'andamento').length;
  const co = D.ch.filter(c => c.st === 'concluida').length;
  const r = D.ch.filter(c => c.st === 'recusado').length;
  const sp = el('s-p'), sa = el('s-a'), sc = el('s-c'), sr = el('s-r');
  if(sp) sp.textContent = p; if(sa) sa.textContent = a;
  if(sc) sc.textContent = co; if(sr) sr.textContent = r;

  const limitePrazo = LIMITE_PRAZO_MS;
  const agora = Date.now();
  const avaliados = D.ch.map(c => {
    if(!c.am || !['andamento','concluida'].includes(c.st)) return null;
    const inicio = new Date(c.am).getTime();
    const fim = c.st === 'concluida' && c.cc ? new Date(c.cc).getTime() : agora;
    if(!Number.isFinite(inicio) || !Number.isFinite(fim) || fim < inicio) return null;
    return { chamado:c, duracao:fim-inicio, perda:fim-inicio>limitePrazo };
  }).filter(Boolean);
  const dentroPrazo = avaliados.filter(x => x.chamado.st === 'concluida' && !x.perda);
  const perdas = avaliados.filter(x => x.perda);

  const indicadores=dadosIndicadoresTecnicos();
  const totalReincidencias=indicadores.reincidencias.length;
  const rankingPerdas=agruparRanking(indicadores.perdas,x=>x.chamado.te);
  const rankingReincidencias=agruparRanking(indicadores.reincidencias,x=>x.anterior.te);
  const fmtDuracao = ms => {
    const minutos = Math.floor(ms/60000);
    return `${Math.floor(minutos/60)}h ${String(minutos%60).padStart(2,'0')}min`;
  };
  if(el('s-prazo')) el('s-prazo').textContent = dentroPrazo.length;
  if(el('s-perda')) el('s-perda').textContent = perdas.length;
  if(el('s-reincidencia')) el('s-reincidencia').textContent = totalReincidencias;
  if(el('db-prazo-detalhes')) el('db-prazo-detalhes').innerHTML=barrasRanking(rankingPerdas,'#dc2626');
  if(el('db-reincidencias')) el('db-reincidencias').innerHTML=barrasRanking(rankingReincidencias,'#f59e0b');
  const rec = D.ch.slice(-3).reverse();
  const elRec = el('r-rec');
  if(elRec) elRec.innerHTML = rec.map(c => {
    const s = { aberto: 'Aberto', pendente: 'Pendente', andamento: 'Andamento', concluida: 'Concluída', recusado: 'Recusado' }[c.st];
    const bc = { aberto: 'b-pendente', pendente: 'b-pendente', andamento: 'b-andamento', concluida: 'b-concluida', recusado: 'b-recusado' }[c.st];
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="badge ${bc}">${s}</span></div><div class="os-r"><b>Site:</b> ${c.si}</div><div class="os-r"><b>Quem abriu:</b> ${c.abertura || '—'}</div><div class="os-r"><b>Técnico:</b> ${c.te ? nt(c.te) : '—'}</div>${adminGeral() ? `<div style="margin-top:7px"><button class="btn btn-r btn-del-ch" data-id="${c.id}" style="padding:5px 9px;font-size:.65rem">🗑️ Excluir chamado</button></div>` : ''}</div>`;
  }).join('') || '<div class="empty">Nenhum chamado</div>';
}

function rAt() {
  const tb = el('tb-at');
  if(!tb) return;
  const list = D.ch.filter(c => c.st === 'andamento');
  tb.innerHTML = list.map(c => {
    const t = tm(c.am, c.re);
    return `<tr><td>${c.pr}</td><td>${c.si}</td><td>${nt(c.te)}</td><td>${nomeRegiao(c.re)}</td><td><span class="timer ${t.c}">${t.t}</span></td><td><button class="btn btn-p btn-redir" data-id="${c.id}" style="padding:4px 7px;font-size:.6rem">👷 Redirecionar</button>${adminGeral() ? ` <button class="btn btn-r btn-del-ch" data-id="${c.id}" style="padding:4px 7px;font-size:.6rem">🗑️</button>` : ''}</td></tr>`;
  }).join('') || '<tr><td colspan="6" class="empty">Nenhum chamado em atendimento</td></tr>';
}

function rRl(dt1, dt2) {
  const container = el('rl-cards');
  if(!container) return;
  renderRelatoriosQualidade();

  let chamados = D.ch.filter(c => c.st === 'concluida');
  if (dt1) {
    const d1 = new Date(dt1 + 'T00:00:00');
    chamados = chamados.filter(c => c.dtexec && new Date(c.dtexec) >= d1);
  }
  if (dt2) {
    const d2 = new Date(dt2 + 'T23:59:59');
    chamados = chamados.filter(c => c.dtexec && new Date(c.dtexec) <= d2);
  }

  const porTec = {};
  D.tc.forEach(t => { porTec[t.u] = { nome: t.n, regiao: t.r, chamados: [] }; });

  chamados.forEach(c => {
    if (porTec[c.te]) porTec[c.te].chamados.push(c);
    else { porTec[c.te] = { nome: nt(c.te), regiao: c.re, chamados: [c] }; }
  });

  const tecnicos = Object.keys(porTec).filter(u => porTec[u].chamados.length > 0);

  if (tecnicos.length === 0) {
    container.innerHTML = '<div class="empty"><h3>Nenhum chamado concluído no período</h3><p>Ajuste as datas ou aguarde serviços finalizados.</p></div>';
    return;
  }

  container.innerHTML = '<div class="grid-2">' + tecnicos.map(u => {
    const t = porTec[u];
    const pendentes = t.chamados.filter(c => !c.ap || c.ap.status === 'pendente').length;
    const aprovados = t.chamados.filter(c => c.ap && c.ap.status === 'aprovado').length;
    const rejeitados = t.chamados.filter(c => c.ap && c.ap.status === 'rejeitado').length;

    let statusGeral = 'pendente';
    if (pendentes === 0 && aprovados > 0 && rejeitados === 0) statusGeral = 'aprovado';
    else if (pendentes === 0 && rejeitados > 0 && aprovados === 0) statusGeral = 'rejeitado';
    else if (pendentes === 0) statusGeral = 'parcial';

    const badgeGeral = {
      aprovado: '<span class="badge b-aprovado">✅ Aprovada</span>',
      rejeitado: '<span class="badge b-rejeitado">❌ Rejeitada</span>',
      parcial: '<span class="badge b-pag-pendente">⚠️ Parcial</span>',
      pendente: '<span class="badge b-pag-pendente">⏳ Pendente</span>'
    }[statusGeral];

    let totalVal = 0;
    t.chamados.forEach(c => {
      if (c.ex && c.ex.total) {
        const v = parseFloat(c.ex.total.replace('R$ ', '').replace('.', '').replace(',', '.'));
        if (!isNaN(v)) totalVal += v;
      }
    });

    const totalStr = 'R$ ' + totalVal.toFixed(2).replace('.', ',');
    const regBadge = t.regiao === 'capital' ? '<span class="badge b-capital">🏙️ Capital</span>' : '<span class="badge b-interior">🌾 Interior</span>';

    return `<div class="pl-card-mini btn-ver-pl" data-u="${u}">
      <div class="icon">👷</div>
      <h3>${t.nome}</h3>
      <div class="reg">${regBadge}</div>
      <div class="tot">${totalStr}</div>
      <div class="qtd"><b>${t.chamados.length}</b> serviço(s) — ${badgeGeral}</div>
    </div>`;
  }).join('') + '</div>';
}

function renderRelatoriosQualidade(){
  const {perdas,reincidencias}=dadosIndicadoresTecnicos();
  const rankingPerdas=agruparRanking(perdas,x=>x.chamado.te);
  const rankingReinc=agruparRanking(reincidencias,x=>x.anterior.te);
  if(el('rl-perdas'))el('rl-perdas').innerHTML=barrasRanking(rankingPerdas,'#dc2626')+`<div style="margin-top:12px;overflow-x:auto"><table class="table"><thead><tr><th>Técnico</th><th>Chamados</th></tr></thead><tbody>${rankingPerdas.map(x=>`<tr><td>${esc(x.nome)}</td><td>${x.qtd}</td></tr>`).join('')||'<tr><td colspan="2">Nenhum registro</td></tr>'}</tbody></table></div>`;
  if(el('rl-reincidencias'))el('rl-reincidencias').innerHTML=barrasRanking(rankingReinc,'#f59e0b')+`<div style="margin-top:12px;overflow-x:auto"><table class="table"><thead><tr><th>Último técnico</th><th>Reincidências</th></tr></thead><tbody>${rankingReinc.map(x=>`<tr><td>${esc(x.nome)}</td><td>${x.qtd}</td></tr>`).join('')||'<tr><td colspan="2">Nenhum registro</td></tr>'}</tbody></table></div>`;
}

function exportarRelatorioQualidade(tipo){
  const {perdas,reincidencias}=dadosIndicadoresTecnicos();
  let rows=[],nome='';
  if(tipo==='perdas'){
    nome='relatorio_tecnicos_perda_prazo.xlsx';
    rows=perdas.map(x=>({Técnico:nt(x.chamado.te)||'Não informado',Protocolo:x.chamado.pr||'',Circuito:x.chamado.ci||'',Site:x.chamado.si||'','Início':x.chamado.am||'','Conclusão':x.chamado.cc||'','Duração (horas)':Number((x.duracao/3600000).toFixed(2))}));
  }else{
    nome='relatorio_tecnicos_reincidencia_30_dias.xlsx';
    rows=reincidencias.map(x=>({'Técnico do atendimento anterior':nt(x.anterior.te)||'Não informado','Protocolo anterior':x.anterior.pr||'','Novo protocolo':x.chamado.pr||'',Circuito:x.chamado.ci||'',Site:x.chamado.si||'','Ação anterior':x.anterior.ex?.atv||x.anterior.ex?.relatorio||x.anterior.ex?.obs||'Não informada','Intervalo (dias)':Number((x.intervalo/86400000).toFixed(1))}));
  }
  if(!rows.length){alert('Não há dados para este relatório.');return;}
  const ws=XLSX.utils.json_to_sheet(rows);ws['!cols']=Object.keys(rows[0]).map(k=>({wch:Math.min(Math.max(k.length+3,16),45)}));
  const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,tipo==='perdas'?'Perda de Prazo':'Reincidências 30 dias');XLSX.writeFile(wb,nome);
}

let PLU = null;

function opPl(u) {
  PLU = u;
  const tec = D.tc.find(x => x.u === u);
  const nome = tec ? tec.n : nt(u);
  const regiao = tec ? tec.r : 'capital';

  const chamados = D.ch.filter(c => c.te === u && c.st === 'concluida');
  if (chamados.length === 0) return;

  el('pl-tit').textContent = '📋 Planilha — ' + nome;
  el('pl-in').innerHTML = `<b>${nome}</b> — ${regiao === 'capital' ? '🏙️ Capital (6h)' : '🌾 Interior (8h)'}`;

  const rows = chamados.map(c => {
    const ex = c.ex || {};
    const dtexec = c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : '—';
    const atvNome = ex.atv ? ex.atv.split('|')[0] : '—';
    const ap = c.ap || { status: 'pendente' };
    const apBadge = {
      pendente: '<span class="badge b-pag-pendente">Pendente</span>',
      aprovado: '<span class="badge b-aprovado">Aprovado</span>',
      rejeitado: '<span class="badge b-rejeitado">Rejeitado</span>'
    }[ap.status];
    let misc = '—';
    if (ex.utp || ex.cci || ex.can) {
      const parts = [];
      if (ex.utp) parts.push('UTP ' + ex.utp + 'm');
      if (ex.cci) parts.push('CCI ' + ex.cci + 'm');
      if (ex.can) parts.push('Canaleta ' + ex.can + 'm');
      misc = parts.join(', ');
    }
    let qtd = '—';
    if (ex.utp || ex.cci || ex.can) {
      const parts = [];
      if (ex.utp) parts.push(ex.utp);
      if (ex.cci) parts.push(ex.cci);
      if (ex.can) parts.push(ex.can);
      qtd = parts.join(' / ');
    }
    return `<tr><td>${c.pr}</td><td>${c.si}</td><td>${ex.co || '—'}</td><td>${ex.cd || '—'}</td><td>${ex.cr || '—'}</td><td>${dtexec}</td><td>${atvNome}</td><td>${misc}</td><td>${qtd}</td><td>${ex.km || '—'}</td><td>${ex.vkm || '—'}</td><td>—</td><td>${ex.tmat || '—'}</td><td>${ex.vatv || '—'}</td><td>${ex.total || '—'}</td><td>${valorInfo(ex.relatorio || ex.obs)}</td><td>${apBadge}</td></tr>`;
  }).join('');

  el('pl-tb-body').innerHTML = rows;

  const pendentes = chamados.filter(c => !c.ap || c.ap.status === 'pendente').length;
  const aprovados = chamados.filter(c => c.ap && c.ap.status === 'aprovado').length;
  const rejeitados = chamados.filter(c => c.ap && c.ap.status === 'rejeitado').length;

  let totalVal = 0;
  chamados.forEach(c => {
    if (c.ex && c.ex.total) {
      const v = parseFloat(c.ex.total.replace('R$ ', '').replace('.', '').replace(',', '.'));
      if (!isNaN(v)) totalVal += v;
    }
  });

  el('pl-res').innerHTML = `<span><b>Total:</b> ${chamados.length}</span><span><b>Aprovados:</b> ${aprovados}</span><span><b>Pendentes:</b> ${pendentes}</span><span><b>Rejeitados:</b> ${rejeitados}</span>`;
  el('pl-tot').textContent = 'R$ ' + totalVal.toFixed(2).replace('.', ',');

  // Mostrar/esconder botões de ação
  const btnApv = el('btn-apv-pl');
  const btnRej = el('btn-rej-pl');
  if (btnApv) btnApv.style.display = (pendentes > 0 || rejeitados > 0) ? '' : 'none';
  if (btnRej) btnRej.style.display = (pendentes > 0 || aprovados > 0) ? '' : 'none';

  const expAp = el('btn-exp-serv-xlsx');
  if (expAp) {
    const aprovados = chamados.filter(c => c.ap && c.ap.status === 'aprovado').length;
    expAp.classList.toggle('hidden', !adminGeral() || aprovados === 0);
  }
  el('m-pl').classList.add('a');
}

let APT = null;

function opApv(tipo) {
  if (!PLU) return;
  APT = tipo;
  const t = D.tc.find(x => x.u === PLU);
  const nome = t ? t.n : nt(PLU);
  el('ap-tit').textContent = tipo === 'aprovado' ? '✅ Aprovar Planilha' : '❌ Rejeitar Planilha';
  el('ap-in').innerHTML = '<b>' + nome + '</b><br>Todos os chamados pendentes serão ' + (tipo === 'aprovado' ? 'aprovados' : 'rejeitados') + ' para pagamento.';
  const obsBox = el('ap-obs-box');
  if (tipo === 'rejeitado') { obsBox.classList.remove('hidden'); el('ap-obs').value = ''; }
  else { obsBox.classList.add('hidden'); }
  el('m-ap').classList.add('a');
}

async function cfAp() {
  const obs = el('ap-obs').value.trim();
  if (APT === 'rejeitado' && !obs) { alert('Informe o motivo da rejeição'); return; }
  const alvos=D.ch.filter(c=>c.te===PLU && c.st==='concluida' && (!c.ap || c.ap.status==='pendente'));
  if(!alvos.length){alert('Não há serviços pendentes para esta ação.');return;}
  const btn=el('btn-cf-ap'),textoBtn=btn?.textContent;
  try{
    if(btn){btn.disabled=true;btn.textContent='Salvando no Supabase...';}
    const confirmadoEm=await sbPersistirAprovacoes(alvos,APT,APT==='rejeitado'?obs:'');
    alvos.forEach(c=>{
      c.ap={status:APT,obs:APT==='rejeitado'?obs:'',data:confirmadoEm,admin:S.n};
    });
    lsSet('dd',D);
    el('m-ap').classList.remove('a');
    el('m-pl').classList.remove('a');
    rRl();rDb();
    alert(APT==='aprovado'?'Planilha aprovada e confirmada no servidor!':'Planilha rejeitada e confirmada no servidor.');
  }catch(err){
    sbShowError('Não foi possível salvar a aprovação',err);
    await sbRecarregarDados();
  }finally{
    if(btn){btn.disabled=false;btn.textContent=textoBtn||'Confirmar';}
  }
}

function fmtDiff(a, b) {
  const d = Math.floor((new Date(b) - new Date(a)) / 1000);
  const h = String(Math.floor(d / 3600)).padStart(2, '0');
  const m = String(Math.floor((d % 3600) / 60)).padStart(2, '0');
  const s = String(d % 60).padStart(2, '0');
  return `${h}:${m}:${s}`;
}

// ========== AÇÕES ADMIN ==========
let DPMODE = 'despachar';

function opDp(id) {
  DPMODE = 'despachar';
  CID = id;
  const c = D.ch.find(x => x.id === id);
  if(!c) return;
  el('d-in').innerHTML = `<b>${c.pr}</b> — ${c.si}<br><small>${c.en}</small>`;
  const s = el('d-te');
  const compativeis = D.tc.filter(t => tecnicoCompativel(t, c));
  s.innerHTML = '<option value="">Selecione...</option>' + compativeis.map(t => `<option value="${t.u}">${t.n} — ${skillsTec(t).map(nomeSkill).join('/')}${t.r === 'capital' ? ' — '+areasTec(t).map(nomeArea).join('/') : ''}</option>`).join('');
  if (!compativeis.length) s.innerHTML = '<option value="">Nenhum técnico compatível cadastrado</option>';
  el('d-tit').textContent = '🚚 Despachar Chamado';
  el('btn-cf-dp').textContent = '🚚 Despachar';
  el('d-tr').classList.add('hidden');
  el('d-q').value = ''; el('d-m').value = '';
  el('m-dp').classList.add('a');
}

function opRedirecionar(id) {
  DPMODE = 'redirecionar'; CID = id;
  const c = D.ch.find(x => x.id === id);
  if (!c) return;
  el('d-in').innerHTML = `<b>${c.pr}</b> — ${c.si}<br><small>Técnico atual: ${c.te ? nt(c.te) : 'Nenhum'}</small>`;
  const compativeis = D.tc.filter(t => t.u !== c.te && tecnicoCompativel(t, c));
  el('d-te').innerHTML = '<option value="">Selecione o novo técnico...</option>' + compativeis.map(t => `<option value="${t.u}">${t.n} — ${skillsTec(t).map(nomeSkill).join('/')}${t.r === 'capital' ? ' — '+areasTec(t).map(nomeArea).join('/') : ''}</option>`).join('');
  if (!compativeis.length) el('d-te').innerHTML = '<option value="">Nenhum outro técnico compatível</option>';
  el('d-tit').textContent = '👷 Redirecionar Chamado';
  el('btn-cf-dp').textContent = '👷 Confirmar redirecionamento';
  el('d-tr').classList.add('hidden'); el('d-q').value = ''; el('d-m').value = '';
  el('m-dp').classList.add('a');
}

function excluirChamado(id) {
  const c = D.ch.find(x => x.id === id);
  if (!adminGeral()) { alert('Somente o Administrador Geral pode excluir chamados.'); return; }
  if (!c || !confirm(`Excluir permanentemente o chamado ${c.pr}?`)) return;
  D.ch = D.ch.filter(x => x.id !== id); sv(); rCh(); rAt(); rDb();
  alert('Chamado excluído com sucesso.');
}

function cfDp() {
  const tu = el('d-te').value;
  if (!tu) { alert('Selecione um técnico'); return; }
  const c = D.ch.find(x => x.id === CID);
  if(!c) return;
  const hoje = new Date().toISOString().split('T')[0];
  const ini = D.ch.filter(ch => ch.te === tu && ch.st === 'andamento' && ch.am && ch.am.startsWith(hoje)).length;
  let dt = null;
  if (ini >= 4) {
    const q = el('d-q').value.trim();
    const m = el('d-m').value.trim();
    if (!q || !m) {
      el('d-tr').classList.remove('hidden');
      alert('Trava de 4 chamados! Informe quem destravou e o motivo.');
      return;
    }
    dt = { q, m, d: ag() };
  }
  if (DPMODE === 'redirecionar') c.tr.push({ de: c.te, para: tu, m: 'Redirecionado pelo administrador', d: ag() });
  c.st = 'pendente'; c.te = tu; c.dt = dt; c.ae = null; c.am = null; c.mr = '';
  sv();
  el('m-dp').classList.remove('a');
  rCh();
  rAt(); rDb();
  alert(DPMODE === 'redirecionar' ? 'Chamado redirecionado com sucesso!' : 'Chamado despachado com sucesso!');
}

function opTr(id) {
  CID = id;
  const c = D.ch.find(x => x.id === id);
  if(!c) return;
  el('t-in').innerHTML = `<b>${c.pr}</b> — ${c.si}<br><small>Recusado por: ${nt(c.te)}</small>`;
  const s = el('t-te');
  s.innerHTML = '<option value="">Selecione...</option>' + D.tc.filter(t => t.u !== c.te).map(t => `<option value="${t.u}">${t.n}</option>`).join('');
  el('t-m').value = '';
  el('m-tr').classList.add('a');
}

function cfTr() {
  const tu = el('t-te').value;
  const m = el('t-m').value.trim();
  if (!tu) { alert('Selecione um técnico'); return; }
  const c = D.ch.find(x => x.id === CID);
  if(!c) return;
  c.tr.push({ de: c.te, para: tu, m, d: ag() });
  c.te = tu; c.st = 'pendente'; c.mr = '';
  sv();
  el('m-tr').classList.remove('a');
  rCh();
  alert('Chamado transferido com sucesso!');
}

async function rmTc(u) {
  if (!confirm('Remover técnico?')) return;
  if (!SB_PROFILE || SB_PROFILE.tipo !== 'admin') {
    alert('Somente administradores podem excluir técnicos.');
    return;
  }
  const tecnico = D.tc.find(t => t.u === u);
  if (!tecnico?._id) {
    alert('Não foi possível identificar o técnico no Supabase.');
    return;
  }
  try {
    const { error } = await SB.from('perfis').update({ ativo: false }).eq('id', tecnico._id);
    if (error) throw error;
    D.tc = D.tc.filter(t => t.u !== u);
    lsSet('dd', D);
    rTc();
    alert('Técnico excluído com sucesso.');
  } catch (err) {
    sbShowError('Não foi possível excluir o técnico', err);
    await sbLoadAll().catch(() => {});
    rTc();
  }
}
function rmAd(u) { if (!confirm('Remover administrador?')) return; D.ad = D.ad.filter(a => a.u !== u); sv(); rAd(); }

// ========== RENDER TÉCNICO ==========
function rTdb() {
  const dp = D.ch.filter(c => c.te === S.u && c.st === 'pendente').length;
  const a = D.ch.filter(c => c.te === S.u && c.st === 'andamento').length;
  const co = D.ch.filter(c => c.te === S.u && c.st === 'concluida').length;
  const sd = el('ts-d'), sa = el('ts-a'), sc = el('ts-c');
  if(sd) sd.textContent = dp; if(sa) sa.textContent = a; if(sc) sc.textContent = co;
  const list = D.ch.filter(c => c.te === S.u && c.st === 'andamento');
  const tmEl = el('t-tm');
  if(tmEl) tmEl.innerHTML = list.length ? list.map(c => {
    const t = tm(c.am, c.re);
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="timer ${t.c}">${t.t}</span></div><div class="os-r"><b>Site:</b> ${c.si}</div></div>`;
  }).join('') : '<div class="empty">Nenhum chamado em atendimento</div>';
}

function rTdp() {
  const list = D.ch.filter(c => c.te === S.u && c.st === 'pendente');
  const dl = el('t-dl');
  if(dl) dl.innerHTML = list.length ? list.map(c =>
    `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="badge b-pendente">Aguardando</span></div>
    ${dadosSite(c)}
    <div class="os-r"><b>Skill necessária:</b> ${nomeSkill(c.skill)}${c.re === 'capital' ? ` — <b>Área:</b> ${nomeArea(c.area)}` : ''}</div>
    <div class="os-r"><b>Descrição:</b> ${c.de}</div>
    ${infoReincidencia(c).html}
    <div style="margin-top:8px;display:flex;gap:6px">
      <button class="btn btn-g btn-ac" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">✅ Aceitar</button>
      <button class="btn btn-r btn-rc" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">❌ Recusar</button>
    </div></div>`
  ).join('') : '<div class="empty"><h3>Nenhum chamado despachado</h3></div>';
}

function rTat() {
  const list = D.ch.filter(c => c.te === S.u && c.st === 'andamento');
  const al = el('t-al');
  if(al) al.innerHTML = list.length ? list.map(c => {
    const t = tm(c.am, c.re);
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span><span class="timer ${t.c}">${t.t}</span></div>
    ${dadosSite(c)}
    <div class="os-r"><b>Skill necessária:</b> ${nomeSkill(c.skill)}${c.re === 'capital' ? ` — <b>Área:</b> ${nomeArea(c.area)}` : ''}</div>
    ${infoReincidencia(c).html}
    <div style="margin-top:8px"><button class="btn btn-p btn-ex" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">📝 Executar</button></div></div>`;
  }).join('') : '<div class="empty"><h3>Nenhum chamado em atendimento</h3></div>';
}

function rTco() {
  const list = D.ch.filter(c => c.te === S.u && c.st === 'concluida');
  const cl = el('t-cl');
  if(cl) cl.innerHTML = list.length ? list.map(c => {
    const rejeitado = c.ap && c.ap.status === 'rejeitado';
    const badge = rejeitado ? '<span class="badge b-rejeitado">Rejeitado pelo administrador</span>' : (c.ap && c.ap.status === 'aprovado' ? '<span class="badge b-aprovado">Aprovado</span>' : '<span class="badge b-pag-pendente">Aguardando análise</span>');
    return `<div class="os"><div class="os-h"><span class="os-id">${c.pr}</span>${badge}</div>
    <div class="os-r"><b>Site:</b> ${c.si}</div>
    <div class="os-r"><b>Valor Total:</b> ${c.ex && c.ex.total ? c.ex.total : '—'}</div>
    <div class="os-r"><b>Data:</b> ${c.cc || '—'}</div>
    ${rejeitado ? `<div class="trava" style="margin-top:8px"><b>Motivo da rejeição:</b><br>${valorInfo(c.ap.obs)}</div><button class="btn btn-y btn-ajustar" data-id="${c.id}" style="padding:6px 10px;font-size:.7rem">🔄 Reabrir e ajustar</button>` : ''}</div>`;
  }
  ).join('') : '<div class="empty"><h3>Nenhum chamado concluído</h3></div>';
}

function reabrirAjuste(id) {
  const c = D.ch.find(x => x.id === id && x.te === S.u);
  if (!c || c.st !== 'concluida' || !c.ap || c.ap.status !== 'rejeitado') return;
  if (!confirm('Reabrir este chamado para corrigir os itens rejeitados?')) return;
  c.apHistorico = c.apHistorico || [];
  c.apHistorico.push({ ...c.ap });
  c.ajuste = { motivo: c.ap.obs, reabertoEm: ag() };
  c.st = 'andamento'; c.am = new Date().toISOString(); c.cc = null;
  sv(); rTco(); rTat(); rTdb();
  opEx(id);
}

function rTar(dt1, dt2) {
  const tb = el('tb-ar-body');
  if(!tb) return;
  let list = D.ch.filter(c => c.te === S.u && c.st === 'concluida');
  if (dt1) {
    const d1 = new Date(dt1 + 'T00:00:00');
    list = list.filter(c => c.dtexec && new Date(c.dtexec) >= d1);
  }
  if (dt2) {
    const d2 = new Date(dt2 + 'T23:59:59');
    list = list.filter(c => c.dtexec && new Date(c.dtexec) <= d2);
  }
  if (list.length === 0) {
    tb.innerHTML = '<tr><td colspan="17" class="empty">Nenhuma atividade realizada no período</td></tr>';
    return;
  }
  let totalGeral = 0;
  const rows = list.map(c => {
    const ex = c.ex || {};
    const dtexec = c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : '—';
    const atvNome = ex.atv ? ex.atv.split('|')[0] : '—';
    const ap = c.ap || { status: 'pendente' };
    const apBadge = {
      pendente: '<span class="badge b-pag-pendente">Pendente</span>',
      aprovado: '<span class="badge b-aprovado">Aprovado</span>',
      rejeitado: '<span class="badge b-rejeitado">Rejeitado</span>'
    }[ap.status];
    let misc = '—';
    if (ex.utp || ex.cci || ex.can) {
      const parts = [];
      if (ex.utp) parts.push('UTP ' + ex.utp + 'm');
      if (ex.cci) parts.push('CCI ' + ex.cci + 'm');
      if (ex.can) parts.push('Canaleta ' + ex.can + 'm');
      misc = parts.join(', ');
    }
    let qtd = '—';
    if (ex.utp || ex.cci || ex.can) {
      const parts = [];
      if (ex.utp) parts.push(ex.utp);
      if (ex.cci) parts.push(ex.cci);
      if (ex.can) parts.push(ex.can);
      qtd = parts.join(' / ');
    }
    if (ex.total) {
      const v = parseFloat(ex.total.replace('R$ ', '').replace('.', '').replace(',', '.'));
      if (!isNaN(v)) totalGeral += v;
    }
    return `<tr><td>${c.pr}</td><td>${c.si}</td><td>${ex.co || '—'}</td><td>${ex.cd || '—'}</td><td>${ex.cr || '—'}</td><td>${dtexec}</td><td>${atvNome}</td><td>${misc}</td><td>${qtd}</td><td>${ex.km || '—'}</td><td>${ex.vkm || '—'}</td><td>—</td><td>${ex.tmat || '—'}</td><td>${ex.vatv || '—'}</td><td>${ex.total || '—'}</td><td>${valorInfo(ex.relatorio || ex.obs)}</td><td>${apBadge}</td></tr>`;
  }).join('');
  const totalStr = 'R$ ' + totalGeral.toFixed(2).replace('.', ',');
  tb.innerHTML = rows + `<tr style="background:#e8f5e9;font-weight:700"><td colspan="14" style="text-align:right">VALOR TOTAL:</td><td>${totalStr}</td><td colspan="2"></td></tr>`;
}

// ========== AÇÕES TÉCNICO ==========
function acCh(id) {
  const c = D.ch.find(x => x.id === id);
  if(!c) return;
  c.st = 'andamento'; c.ae = ag(); c.am = new Date().toISOString();
  sv();
  rTdp(); rTdb();
  alert('Chamado aceito! Timer iniciado.');
}

function opRc(id) {
  CID = id;
  const c = D.ch.find(x => x.id === id);
  if(!c) return;
  el('r-in').innerHTML = `<b>${c.pr}</b> — ${c.si}`;
  el('r-m').value = '';
  el('m-rc').classList.add('a');
}

function cfRc() {
  const m = el('r-m').value.trim();
  if (!m) { alert('Informe o motivo da recusa'); return; }
  const c = D.ch.find(x => x.id === CID);
  if(!c) return;
  c.st = 'recusado'; c.mr = m;
  sv();
  el('m-rc').classList.remove('a');
  rTdp(); rTdb();
  alert('Chamado recusado.');
}

// ========== CÁLCULOS ==========
function buscarDist(a, b) {
  if (!a || !b || a === b) return 0;
  if (distancias[a] && distancias[a][b]) return distancias[a][b];
  if (distancias[b] && distancias[b][a]) return distancias[b][a];
  return null;
}

function calcDist() {
  const o = el('ex-co').value;
  const d = el('ex-cd').value;
  const r = el('ex-cr').value;
  const k1 = buscarDist(o, d);
  const k2 = buscarDist(d, r);
  if (k1 === null || k2 === null) { alert('Distância não cadastrada entre essas cidades!'); return; }
  const total = k1 + k2;
  const exc = total > 40 ? total - 40 : 0;
  el('ex-km').value = total.toFixed(1);
  el('ex-vkm').value = 'R$ ' + exc.toFixed(2).replace('.', ',');
  const info = el('ex-dist-info');
  info.innerHTML = `${o} → ${d}: <b>${k1} km</b><br>${d} → ${r}: <b>${k2} km</b><br><strong>TOTAL: ${total} km</strong> (excedente: ${exc} km)`;
  info.classList.remove('hidden');
  calcTotal();
}

function calcAtv() {
  const esc = el('ex-atv').value;
  const box = el('ex-avulso-box');
  if (!esc) { el('ex-vatv').value = ''; box.classList.add('hidden'); calcTotal(); return; }
  const [nome, valor] = esc.split('|');
  if (valor === '0') { el('ex-vatv').value = ''; box.classList.remove('hidden'); }
  else { box.classList.add('hidden'); el('ex-vatv').value = valor; }
  calcTotal();
}

function usarAvulso() {
  const v = el('ex-avulso').value;
  el('ex-vatv').value = v || 0;
  calcTotal();
}

function calcMat() {
  const utp = parseFloat(el('ex-utp').value) || 0;
  const cci = parseFloat(el('ex-cci').value) || 0;
  const can = parseFloat(el('ex-can').value) || 0;
  const total = (utp * 1.50) + (cci * 1.00) + (can * 3.50);
  el('ex-tmat').value = 'R$ ' + total.toFixed(2).replace('.', ',');
  calcTotal();
}

function calcTotal() {
  const vkmTxt = (el('ex-vkm').value || '').replace('R$ ', '').replace(',', '.');
  const vkm = parseFloat(vkmTxt) || 0;
  const vatv = parseFloat(el('ex-vatv').value) || 0;
  const tmatTxt = (el('ex-tmat').value || '').replace('R$ ', '').replace(',', '.');
  const tmat = parseFloat(tmatTxt) || 0;
  const total = vkm + vatv + tmat;
  el('ex-total').textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
}

function mascaraEncerramento(c) {
  const agora = new Date();
  const data = agora.toLocaleDateString('pt-BR');
  const horario = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  return `NUMERO SDM : ${c.pr || ''}\nNUMERO MÉTODO: \nCLIENTE: ${c.si || ''}\nTÉCNICO: ${S && S.n ? S.n : ''}\nCAUSA RAÍZ: \nSOLUÇÃO TECNICA: \nDATA ENCERRAMENTO: ${data}\nHORARIO: ${horario}\nLOCAL: ${c.en || c.cid || ''}\nVALIDAÇÃO VECTRA : \nSENHA: \nMATERIAL: `;
}

function finalizarMascaraEncerramento() {
  const agora = new Date();
  let texto = el('ex-relatorio').value;
  texto = texto.replace(/^DATA ENCERRAMENTO:.*$/m, `DATA ENCERRAMENTO: ${agora.toLocaleDateString('pt-BR')}`);
  texto = texto.replace(/^HORARIO:.*$/m, `HORARIO: ${agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}`);
  const materiais = [];
  if (el('ex-utp').value) materiais.push(`Cabo UTP ${el('ex-utp').value}m`);
  if (el('ex-cci').value) materiais.push(`Cabo CCI ${el('ex-cci').value}m`);
  if (el('ex-can').value) materiais.push(`Canaleta ${el('ex-can').value}m`);
  if (/^MATERIAL:\s*$/m.test(texto)) texto = texto.replace(/^MATERIAL:\s*$/m, `MATERIAL: ${materiais.length ? materiais.join(', ') : 'Nenhum'}`);
  el('ex-relatorio').value = texto;
}

// ========== MODAL EXECUÇÃO ==========
function opEx(id) {
  EID = id;
  const c = D.ch.find(x => x.id === id);
  if(!c) return;
  const anterior = c.ex || {};
  el('ex-pr').textContent = c.pr;
  el('ex-si').textContent = c.si;
  el('ex-ci').textContent = c.ci || '—';
  el('ex-en').textContent = c.en;
  el('ex-de').textContent = c.de;
  const card = el('ex-pr').closest('.card');
  let extra = el('ex-site-extra');
  if (!extra) { extra = document.createElement('div'); extra.id = 'ex-site-extra'; card.insertBefore(extra, card.lastElementChild); }
  extra.innerHTML = `<div class="os-r"><b>Cidade:</b> ${valorInfo(c.cid)}</div><div class="os-r"><b>Contato:</b> ${valorInfo(c.contato)}</div><div class="os-r"><b>Horário:</b> ${valorInfo(c.horario)}</div><div class="grid-3"><div class="os-r"><b>Velocidade:</b> ${valorInfo(c.velocidade)}</div><div class="os-r"><b>PRTM:</b> ${valorInfo(c.prtm)}</div><div class="os-r"><b>PVF Total:</b> ${valorInfo(c.pvfTotal)}</div></div>`;

  const opts = '<option value="">Selecione...</option>' + cidades.map(ci => `<option>${ci}</option>`).join('');
  el('ex-co').innerHTML = opts;
  el('ex-cd').innerHTML = opts;
  el('ex-cr').innerHTML = opts;

  el('ex-co').value = anterior.co || ''; el('ex-cd').value = anterior.cd || ''; el('ex-cr').value = anterior.cr || '';
  el('ex-km').value = anterior.km || ''; el('ex-vkm').value = anterior.vkm || '';
  el('ex-atv').value = anterior.atv || ''; el('ex-vatv').value = anterior.vatv || '';
  el('ex-avulso').value = anterior.avulso || '';
  el('ex-avulso-box').classList.toggle('hidden', !(anterior.atv && anterior.atv.endsWith('|0')));
  el('ex-utp').value = anterior.utp || ''; el('ex-cci').value = anterior.cci || ''; el('ex-can').value = anterior.can || '';
  el('ex-tmat').value = anterior.tmat || ''; el('ex-obs').value = anterior.obs || '';
  el('ex-relatorio').value = anterior.relatorio || mascaraEncerramento(c);
  el('ex-total').textContent = anterior.total || 'R$ 0,00';
  el('ex-dist-info').classList.add('hidden');

  el('m-ex').classList.add('a');

  if (TI) clearInterval(TI);
  TI = setInterval(() => {
    const t = tm(c.am, c.re);
    const elm = el('ex-tm');
    if (elm) { elm.textContent = t.t; elm.className = 'timer ' + t.c; }
  }, 1000);
}

function clsEx() {
  el('m-ex').classList.remove('a');
  if (TI) clearInterval(TI);
}

async function cfEx() {
  const c = D.ch.find(x => x.id === EID);
  if(!c) return;
  const btn=el('btn-cf-ex'), textoBtn=btn?.textContent;
  const anterior={ex:c.ex,st:c.st,cc:c.cc,ap:c.ap,ajuste:c.ajuste};
  const eraAjuste = !!c.ajuste;
  finalizarMascaraEncerramento();
  const vkmTxt = (el('ex-vkm').value || '').replace('R$ ', '').replace(',', '.');
  const vkm = parseFloat(vkmTxt) || 0;
  const vatv = parseFloat(el('ex-vatv').value) || 0;
  const tmatTxt = (el('ex-tmat').value || '').replace('R$ ', '').replace(',', '.');
  const tmat = parseFloat(tmatTxt) || 0;
  const total = vkm + vatv + tmat;

  c.ex = {
    co: el('ex-co').value, cd: el('ex-cd').value, cr: el('ex-cr').value,
    km: el('ex-km').value, vkm: el('ex-vkm').value,
    atv: el('ex-atv').value, vatv: el('ex-vatv').value,
    avulso: el('ex-avulso').value,
    utp: el('ex-utp').value, cci: el('ex-cci').value, can: el('ex-can').value,
    tmat: el('ex-tmat').value, obs: el('ex-obs').value,
    relatorio: el('ex-relatorio').value,
    total: 'R$ ' + total.toFixed(2).replace('.', ',')
  };
  c.st = 'concluida'; c.cc = new Date().toISOString();
  if (eraAjuste) {
    c.ap = { status: 'pendente', obs: '', data: ag(), reenviado: true };
    c.ajuste = null;
  }
  try{
    if(btn){btn.disabled=true;btn.textContent='Salvando no Supabase...';}
    await sbPersistirFinalizacao(c);
    lsSet('dd',D);
    clsEx();
    rTat(); rTco(); rTdb();
    alert('Chamado encerrado e sincronizado com o administrador!');
  }catch(err){
    c.ex=anterior.ex;c.st=anterior.st;c.cc=anterior.cc;c.ap=anterior.ap;c.ajuste=anterior.ajuste;
    lsSet('dd',D);
    sbShowError('Não foi possível finalizar o chamado no servidor',err);
  }finally{
    if(btn){btn.disabled=false;btn.textContent=textoBtn||'✅ Encerrar Chamado';}
  }
}

// ========== EXPORTAÇÕES EXCEL ==========
function valorExcel(v) {
  if (v === null || v === undefined) return '';
  return String(v).replace(/\r?\n/g, ' | ');
}

function atividadesDoTecnicoAtual(dt1, dt2) {
  let list = D.ch.filter(c => c.te === S.u && c.st === 'concluida');
  if (dt1) {
    const d1 = new Date(dt1 + 'T00:00:00');
    list = list.filter(c => c.dtexec && new Date(c.dtexec) >= d1);
  }
  if (dt2) {
    const d2 = new Date(dt2 + 'T23:59:59');
    list = list.filter(c => c.dtexec && new Date(c.dtexec) <= d2);
  }
  return list;
}

function exportarAtividadesExcel() {
  if (!S || S.t !== 'tec') return;
  const dt1 = el('ar-dt1') ? el('ar-dt1').value : '';
  const dt2 = el('ar-dt2') ? el('ar-dt2').value : '';
  const list = atividadesDoTecnicoAtual(dt1, dt2);
  if (!list.length) {
    alert('Não existem atividades realizadas no período selecionado.');
    return;
  }

  const rows = list.map(c => {
    const ex = c.ex || {};
    return {
      'O.S': valorExcel(c.pr),
      'Site': valorExcel(c.si),
      'Circuito': valorExcel(c.ci),
      'Cidade': valorExcel(c.cid),
      'Endereço': valorExcel(c.en),
      'Origem': valorExcel(ex.co),
      'Destino': valorExcel(ex.cd),
      'Retorno': valorExcel(ex.cr),
      'Data da Execução': c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : '',
      'Atividade': valorExcel(ex.atv ? ex.atv.split('|')[0] : ''),
      'Miscelânea': valorExcel(
        [ex.utp && 'UTP ' + ex.utp + 'm', ex.cci && 'CCI ' + ex.cci + 'm', ex.can && 'Canaleta ' + ex.can + 'm']
        .filter(Boolean).join(', ')
      ),
      'Quantidade': valorExcel([ex.utp, ex.cci, ex.can].filter(Boolean).join(' / ')),
      'KM Total': valorExcel(ex.km),
      'Valor KM': valorExcel(ex.vkm),
      'Total Material': valorExcel(ex.tmat),
      'Valor Atividade': valorExcel(ex.vatv),
      'Valor Total': valorExcel(ex.total),
      'Relatório / Observação': valorExcel(ex.relatorio || ex.obs),
      'Status Pagamento': valorExcel(c.ap && c.ap.status ? c.ap.status : 'Pendente')
    };
  });

  const ws = XLSX.utils.json_to_sheet(rows);
  ws['!cols'] = Object.keys(rows[0]).map(k => ({ wch: Math.min(Math.max(k.length + 2, 14), 40) }));
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Atividades Realizadas');

  const nomeTec = (S.n || 'tecnico').replace(/[\\/:*?"<>|]/g, '_').trim();
  const periodo = (dt1 || 'inicio') + '_a_' + (dt2 || 'fim');
  XLSX.writeFile(wb, 'Atividades_' + nomeTec + '_' + periodo + '.xlsx');
}

function exportarServicoAprovadoExcel() {
  if (!adminGeral() || !PLU) return;
  const tec = D.tc.find(x => x.u === PLU);
  const nomeTec = tec ? tec.n : nt(PLU);

  // Somente serviços concluídos e efetivamente aprovados pelo administrador.
  const list = D.ch.filter(c =>
    c.te === PLU &&
    c.st === 'concluida' &&
    c.ap &&
    c.ap.status === 'aprovado'
  );

  if (!list.length) {
    alert('Este técnico ainda não possui serviço aprovado para exportação.');
    return;
  }

  const rows = list.map(c => {
    const ex = c.ex || {};
    return {
      'Técnico': nomeTec,
      'O.S': valorExcel(c.pr),
      'Protocolo / Circuito': valorExcel(c.ci),
      'Site': valorExcel(c.si),
      'Cidade': valorExcel(c.cid),
      'Endereço': valorExcel(c.en),
      'Região': valorExcel(c.regiaoOperacional),
      'Quem abriu': valorExcel(c.abertura),
      'Data Execução': c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : '',
      'Atividade': valorExcel(ex.atv ? ex.atv.split('|')[0] : ''),
      'Origem': valorExcel(ex.co),
      'Destino': valorExcel(ex.cd),
      'Retorno': valorExcel(ex.cr),
      'KM Total': valorExcel(ex.km),
      'Valor KM': valorExcel(ex.vkm),
      'Material': valorExcel(
        [ex.utp && 'UTP ' + ex.utp + 'm', ex.cci && 'CCI ' + ex.cci + 'm', ex.can && 'Canaleta ' + ex.can + 'm']
        .filter(Boolean).join(', ')
      ),
      'Total Material': valorExcel(ex.tmat),
      'Valor Atividade': valorExcel(ex.vatv),
      'Valor Total': valorExcel(ex.total),
      'Relatório do Serviço Executado': valorExcel(ex.relatorio || ex.obs),
      'Aprovado em': valorExcel(c.ap.data),
      'Aprovado por': valorExcel(c.ap.admin)
    };
  });

  const ws = XLSX.utils.json_to_sheet(rows);
  ws['!cols'] = Object.keys(rows[0]).map(k => ({ wch: Math.min(Math.max(k.length + 2, 14), 42) }));
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Serviço Aprovado');

  const safe = nomeTec.replace(/[\\/:*?"<>|]/g, '_').trim();
  XLSX.writeFile(wb, 'Servico_Aprovado_' + safe + '.xlsx');
}

// ========== EXPORTAR CSV ==========
function expCSV() {
  let csv = 'O.S;SITE;ORIGEM;DESTINO;RETORNO;DATA;ATIVIDADE;MISCELANEA;QTD;KM TOTAL;VALOR KM;VALOR MATERIAL;TOTAL MATERIAL;VALOR ATIVIDADE;VALOR TOTAL;OBSERVACAO\n';
  D.ch.filter(c => c.st === 'concluida').forEach(c => {
    const ex = c.ex || {};
    const dtexec = c.dtexec ? new Date(c.dtexec).toLocaleDateString('pt-BR') : '';
    const atvNome = ex.atv ? ex.atv.split('|')[0] : '';
    const km = ex.km || '';
    const vkm = ex.vkm ? ex.vkm.replace('R$ ', '').replace(',', '.') : '';
    const tmat = ex.tmat ? ex.tmat.replace('R$ ', '').replace(',', '.') : '';
    const vatv = ex.vatv || '';
    const total = ex.total ? ex.total.replace('R$ ', '').replace(',', '.') : '';
    const utp = ex.utp || '';
    const cci = ex.cci || '';
    const can = ex.can || '';
    let misc = '';
    if (utp) misc += 'UTP ' + utp + 'm ';
    if (cci) misc += 'CCI ' + cci + 'm ';
    if (can) misc += 'Canaleta ' + can + 'm';
    let qtd = '';
    if (utp || cci || can) {
      const parts = [];
      if (utp) parts.push(utp);
      if (cci) parts.push(cci);
      if (can) parts.push(can);
      qtd = parts.join(' / ');
    }
    csv += '"' + (c.pr || '') + '";' + '"' + (c.si || '') + '";' + '"' + (ex.co || '') + '";' + '"' + (ex.cd || '') + '";' + '"' + (ex.cr || '') + '";' + '"' + dtexec + '";' + '"' + atvNome + '";' + '"' + misc.trim() + '";' + '"' + qtd + '";' + '"' + km + '";' + '"' + vkm + '";' + '"";' + '"' + tmat + '";' + '"' + vatv + '";' + '"' + total + '";' + '"' + (ex.relatorio || ex.obs || '') + '"\n';
  });
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'planilha_pagamento.csv';
  link.click();
}

// ========== LOOP DE ATUALIZAÇÃO ==========
function startLoop() {
  setInterval(() => {
    if (S && S.t === 'adm') { rAt(); rDb(); if(el('v-ml') && !el('v-ml').classList.contains('hidden')) rMl(); }
    if (S && S.t === 'tec') { rTdb(); rTat(); if(el('t-mt') && !el('t-mt').classList.contains('hidden')) rTmat(); }
  }, 5000);
}

// ========== EVENT LISTENERS ==========
document.addEventListener('DOMContentLoaded', function() {
  // Importa os 126 materiais da planilha MATERIAL LOGISTICO.xlsx
  // sem apagar materiais já cadastrados manualmente.
  inicializarMateriaisPlanilha();

  // Tela inicial
  const cardTec = el('card-tec');
  const cardAdm = el('card-adm');
  const cardLog = el('card-log');
  // Os cards já possuem acionamento direto no HTML. Estes listeners são apenas
  // uma proteção para versões antigas do arquivo que ainda não tenham onclick.
  if(cardTec && !cardTec.onclick) cardTec.addEventListener('click', function() { showLogin('tec'); });
  if(cardAdm && !cardAdm.onclick) cardAdm.addEventListener('click', function() { showLogin('adm'); });
  if(cardLog && !cardLog.onclick) cardLog.addEventListener('click', function() { showLogin('log'); });

  // Login
  const btnLogin = el('btn-login');
  const btnVoltar = el('btn-voltar');
  const btnEsqueceu = el('btn-esqueceu');
  if(btnLogin) btnLogin.addEventListener('click', doLogin);
  if(btnVoltar) btnVoltar.addEventListener('click', goHome);
  if(btnEsqueceu) btnEsqueceu.addEventListener('click', function() { const v=(el('lu')?.value||'').trim(); el('rec-e').value = v.includes('@') ? v : ''; el('m-rec').classList.add('a'); setTimeout(()=>el('rec-e')?.focus(),50); });
  el('lp').addEventListener('keypress', function(e) { if(e.key === 'Enter') doLogin(); });

  document.querySelectorAll('.btn-minha-senha').forEach(btn => btn.addEventListener('click', abrirMinhaSenha));
  el('cls-senha').addEventListener('click', function() { el('m-senha').classList.remove('a'); });
  el('can-senha').addEventListener('click', function() { el('m-senha').classList.remove('a'); });
  el('cf-senha').addEventListener('click', salvarMinhaSenha);
  el('cls-rec').addEventListener('click', function() { el('m-rec').classList.remove('a'); });
  el('can-rec').addEventListener('click', function() { el('m-rec').classList.remove('a'); });
  el('cf-rec').addEventListener('click', recuperarSenha);

  // Sair
  const btnSairAdm = el('btn-sair-adm');
  const btnSairTec = el('btn-sair-tec');
  const btnSairLog = el('btn-sair-log');
  if(btnSairAdm) btnSairAdm.addEventListener('click', logout);
  if(btnSairTec) btnSairTec.addEventListener('click', logout);
  if(btnSairLog) btnSairLog.addEventListener('click', logout);

  // Abas admin
  document.querySelectorAll('#nv button').forEach(btn => {
    btn.addEventListener('click', function() { admTab(this, this.dataset.tab); });
  });

  // Abas técnico
  document.querySelectorAll('#nv2 button').forEach(btn => {
    btn.addEventListener('click', function() { tecTab(this, this.dataset.tab); });
  });

  // Cadastros
  const btnAddTec = el('btn-add-tec');
  const btnAddAdm = el('btn-add-adm');
  const btnAddLog = el('btn-add-log');
  const btnAddCh = el('btn-add-ch');
  if(btnAddTec) btnAddTec.addEventListener('click', addTec);
  if(btnAddAdm) btnAddAdm.addEventListener('click', addAdm);
  if(btnAddLog) btnAddLog.addEventListener('click', addLog);
  if(btnAddCh) btnAddCh.addEventListener('click', addCh);
  const btnAddMaterial=el('btn-add-material'); if(btnAddMaterial) btnAddMaterial.addEventListener('click',addMaterial);
  const btnAjuste=el('btn-ml-ajuste'); if(btnAjuste) btnAjuste.addEventListener('click',ajusteEstoque); const selEst=el('ml-estoque-material'); if(selEst) selEst.addEventListener('change',function(){ const m=materialById(this.value); const q=el('ml-estoque-qtd'); if(q) q.value=(m&&m.estoque!=null)?m.estoque:''; });
  const btnLgAjuste=el('btn-lg-ajuste'); if(btnLgAjuste) btnLgAjuste.addEventListener('click',ajusteEstoqueLogistica); const selLgEst=el('lg-estoque-material'); if(selLgEst) selLgEst.addEventListener('change',function(){ const m=materialById(this.value); const q=el('lg-estoque-qtd'); if(q) q.value=(m&&m.estoque!=null)?m.estoque:''; });
  const btnSolic=el('btn-tm-solicitar'); if(btnSolic) btnSolic.addEventListener('click',solicitarMaterial);
  let circuitoDescricaoTimer=null;
  el('c-descricao-colada').addEventListener('input',function(){
    clearTimeout(circuitoDescricaoTimer);
    circuitoDescricaoTimer=setTimeout(buscarCircuitoNaDescricao,180);
  });
  el('c-descricao-colada').addEventListener('change',buscarCircuitoNaDescricao);
  el('c-opcoes').addEventListener('change',function(){ selecionarCircuitoDaDescricao(this.value); });
  el('t-r').addEventListener('change', atualizarCamposRegiao);
  if(el('t-cep')){el('t-cep').addEventListener('input',function(){this.value=formatarCEP(this.value);});el('t-cep').addEventListener('blur',buscarCEPFormulario);}
  el('t-multi').addEventListener('change', function() {
    document.querySelectorAll('input[name="t-sk"]').forEach(x => { x.checked = this.checked; });
  });
  document.querySelectorAll('input[name="t-sk"]').forEach(x => x.addEventListener('change', function() {
    el('t-multi').checked = Array.from(document.querySelectorAll('input[name="t-sk"]')).every(i => i.checked);
  }));
  el('c-re').addEventListener('change', atualizarCamposRegiao);
  el('c-sk').addEventListener('change', atualizarTecnicosChamado);
  el('c-area').addEventListener('change', atualizarTecnicosChamado);
  el('c-liberar-area').addEventListener('change', atualizarTecnicosChamado);
  atualizarCamposRegiao();

  // Modais - fechar
  const clsDp = el('cls-dp');
  const clsRc = el('cls-rc');
  const clsTr = el('cls-tr');
  const clsExBtn = el('cls-ex');
  const canDp = el('btn-can-dp');
  const canRc = el('btn-can-rc');
  const canTr = el('btn-can-tr');
  const canEx = el('btn-can-ex');
  if(clsDp) clsDp.addEventListener('click', function() { el('m-dp').classList.remove('a'); });
  if(clsRc) clsRc.addEventListener('click', function() { el('m-rc').classList.remove('a'); });
  if(clsTr) clsTr.addEventListener('click', function() { el('m-tr').classList.remove('a'); });
  if(clsExBtn) clsExBtn.addEventListener('click', clsEx);
  if(canDp) canDp.addEventListener('click', function() { el('m-dp').classList.remove('a'); });
  if(canRc) canRc.addEventListener('click', function() { el('m-rc').classList.remove('a'); });
  if(canTr) canTr.addEventListener('click', function() { el('m-tr').classList.remove('a'); });
  if(canEx) canEx.addEventListener('click', clsEx);

  // Modais - confirmar
  const btnCfDp = el('btn-cf-dp');
  const btnCfRc = el('btn-cf-rc');
  const btnCfTr = el('btn-cf-tr');
  const btnCfEx = el('btn-cf-ex');
  if(btnCfDp) btnCfDp.addEventListener('click', cfDp);
  if(btnCfRc) btnCfRc.addEventListener('click', cfRc);
  if(btnCfTr) btnCfTr.addEventListener('click', cfTr);
  if(btnCfEx) btnCfEx.addEventListener('click', cfEx);

  // Execução - selects e inputs
  el('ex-atv').addEventListener('change', calcAtv);
  el('ex-avulso').addEventListener('input', usarAvulso);
  el('ex-utp').addEventListener('input', calcMat);
  el('ex-cci').addEventListener('input', calcMat);
  el('ex-can').addEventListener('input', calcMat);
  el('btn-calc-dist').addEventListener('click', calcDist);

  // Exportar CSV
  const btnExp = el('btn-exp-csv');
  if(btnExp) btnExp.addEventListener('click', expCSV);
  const btnExpPerdas=el('btn-exp-perdas');
  if(btnExpPerdas) btnExpPerdas.addEventListener('click',()=>exportarRelatorioQualidade('perdas'));
  const btnExpReinc=el('btn-exp-reincidencias');
  if(btnExpReinc) btnExpReinc.addEventListener('click',()=>exportarRelatorioQualidade('reincidencias'));

  // Filtros de período - Admin
  const btnFilRl = el('btn-fil-rl');
  if(btnFilRl) btnFilRl.addEventListener('click', function() {
    const dt1 = el('rl-dt1').value;
    const dt2 = el('rl-dt2').value;
    rRl(dt1, dt2);
  });

  // Filtros de período - Técnico
  const btnExpArXlsx = el('btn-exp-ar-xlsx');
  if(btnExpArXlsx) btnExpArXlsx.addEventListener('click', exportarAtividadesExcel);

  const btnExpServXlsx = el('btn-exp-serv-xlsx');
  if(btnExpServXlsx) btnExpServXlsx.addEventListener('click', exportarServicoAprovadoExcel);

  const btnFilAr = el('btn-fil-ar');
  if(btnFilAr) btnFilAr.addEventListener('click', function() {
    const dt1 = el('ar-dt1').value;
    const dt2 = el('ar-dt2').value;
    rTar(dt1, dt2);
  });

  // Modal planilha
  const clsPl = el('cls-pl');
  const canPl = el('btn-can-pl');
  const btnApvPl = el('btn-apv-pl');
  const btnRejPl = el('btn-rej-pl');
  if(clsPl) clsPl.addEventListener('click', function() { el('m-pl').classList.remove('a'); });
  if(canPl) canPl.addEventListener('click', function() { el('m-pl').classList.remove('a'); });
  if(btnApvPl) btnApvPl.addEventListener('click', function() { opApv('aprovado'); });
  if(btnRejPl) btnRejPl.addEventListener('click', function() { opApv('rejeitado'); });

  // Modal confirmação aprovação
  const clsAp = el('cls-ap');
  const canAp = el('btn-can-ap');
  const cfApBtn = el('btn-cf-ap');
  if(clsAp) clsAp.addEventListener('click', function() { el('m-ap').classList.remove('a'); });
  if(canAp) canAp.addEventListener('click', function() { el('m-ap').classList.remove('a'); });
  if(cfApBtn) cfApBtn.addEventListener('click', cfAp);

  // Delegação de eventos para botões dinâmicos
  document.addEventListener('click', function(e) {
    const t = e.target.closest('.btn-ver-pl, .btn-dp, .btn-tr, .btn-redir, .btn-del-ch, .btn-ac, .btn-rc, .btn-ex, .btn-ajustar, .btn-reset-senha, .btn-rm-tec, .btn-rm-adm, .btn-endereco-tec, .btn-mat-direcionar, .btn-mat-separar, .btn-mat-entregar, .btn-log-enviar, .btn-log-liberar, .btn-tech-aceitar-material, .btn-correios, .btn-rm-mat') || e.target;
    if(t.classList.contains('btn-ver-pl')) { opPl(t.dataset.u); }
    if(t.classList.contains('btn-dp')) { opDp(t.dataset.id); }
    if(t.classList.contains('btn-tr')) { opTr(t.dataset.id); }
    if(t.classList.contains('btn-redir')) { opRedirecionar(t.dataset.id); }
    if(t.classList.contains('btn-del-ch')) { excluirChamado(t.dataset.id); }
    if(t.classList.contains('btn-ac')) { acCh(t.dataset.id); }
    if(t.classList.contains('btn-rc')) { opRc(t.dataset.id); }
    if(t.classList.contains('btn-ex')) { opEx(t.dataset.id); }
    if(t.classList.contains('btn-ajustar')) { reabrirAjuste(t.dataset.id); }
    if(t.classList.contains('btn-reset-senha')) { enviarRedefinicaoSenhaAdmin(t.dataset.u, t.dataset.email); }
    if(t.classList.contains('btn-rm-tec')) { rmTc(t.dataset.u); }
    if(t.classList.contains('btn-endereco-tec')) { editarEnderecoTecnico(t.dataset.u); }
    if(t.classList.contains('btn-rm-adm')) { rmAd(t.dataset.u); }
    if(t.classList.contains('btn-mat-direcionar')) { direcionarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-mat-separar')) { separarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-mat-entregar')) { entregarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-log-enviar')) { enviarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-log-liberar')) { liberarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-tech-aceitar-material')) { aceitarMaterial(t.dataset.id); }
    if(t.classList.contains('btn-correios')) { consultarCorreiosOficial(t.dataset.id); }
    if(t.classList.contains('btn-rm-mat')) { const m=materialById(t.dataset.id); if(m && confirm('Excluir este material?')) { D.mat=D.mat.filter(x=>x.id!==m.id); sv(); rMl(); } }
  });

  // Auto login
  if (S) {
    if (S.t === 'adm') enterAdm();
    else if (S.t === 'tec') enterTec();
  }
});
</script>

<script id="base-material-planilha-v9">
window.MATERIAIS_PLANILHA_V9 = ["ABRAÇADEIRA DE NYLON GRANDE 4,5 MM X 300 MM", "ABRAÇADEIRA DE NYLON MÉDIA 4,5MM X 200MM", "ABRAÇADEIRA DE NYLON PEQUENA 4,5 MM X 100MM", "ABRAÇADEIRA TIPO CUNHA 1.1/2", "ABRAÇADEIRA TIPO CUNHA 3/4", "ALÇA PARA CCE", "ALIGERA AG500", "BASE AMPLIFICADORA A601", "ANEL GUIA C/ BASE", "TELEFONE COM FIO PLENO PRETO INTELBRAS", "APARELHO TELEFONE S/FIO INTELBRAS TS 2510", "APARELHO TELEFONE S/FIO INTELBRAS TS 2511", "AUDIOTRIX C2 WITH 2 FXS", "BANCO DE BATERIA 4K", "BANCO DE BATERIA OSBIZ X8", "BARRA FIXAÇÃO DO GABINETE", "BARRAMENTO DE TERRA", "TELEFONE PROFISSIONAL TU-220 COM HEADSET HTU-310 (BASE DISC. + HEADSET )", "BASTIDOR P/1 BLOCO BARGOA", "BASTIDOR P/10 BLOCO BARGOA", "BLOCO BARGOA", "BUCHA Nº 06", "BUCHA Nº 8", "BUCHA Nº 10", "CABO CI 50.30 PARES", "CABO CONECTIVO AMARELO 1.5 M", "CABO CONECTIVO AZUL CAT5E_x000D_\n1.5 M", "CABO CONECTIVO CAT5E CINZA_x000D_\n2.0 M", "CABO CONECTIVO CAT6 1.5 AZUL", "CABO CONECTIVO CAT6 2.5M", "CABO FLEX ELÉTRICO AZUL", "CABO FLEX ELÉTRICO PRETO", "CABO FLEX ELÉTRICO VERDE", "CABO FLEXÍVEL 3X2,5MM 1KV PRETO", "CABO LISO CINZA 1.5M", "CABO LISO PRETO 1.5M", "CABO TELEFONICO CTP APL 50 X 20P", "CAIXA 3X3 ALTA 75X75X41", "CAIXA 3X3 BAIXA 75X75X31", "CAIXA DE SOBREPOR 2P + T 10A 250V BRANCA", "CAIXA MULTIUSO S/FURAÇÕES 104 X 104 X 54", "CAIXA TERMINAL ÓPTICA FIBRACEM", "CANALETA SISTEMA X 50X20X2000 C/ FITA DUPLA FACE", "CANALETA SITEMA X 20X10 C/ FITA DUPLA FACE ADESIVA", "CARTÃO DE MEMORIA MMC 16G 1PF30152-P1649-P1-16", "CENTRAL 4K", "CONVERSOR DE MÍDIA", "CORDÃO ÓPTICO DUPLEX (SC) - 2,5 METROS", "CORDÃO ÓPTICO SIMPLEX (SC)_x000D_\n- 20,0 METROS", "CORDÃO ÓPTICO SIMPLEX (SC)_x000D_\n- 2,0 METROS", "OPENSCAPE DESK PHONE CP 400", "CURVA PVC P/ELETRODUTO 3/4", "DAISA DAILET MULTIPLO 3/4 X S/TAMPA DM034-X", "DAISA DAILET MÚLTIPLO 1.1/2 X C/TAMPA DM1 12-X", "DAISA TAMPA DAILET 3/4 CEGA TM034", "DAISA TAMPÃO PVC DAILET_x000D_\n1.1/2 MT112", "DESK PHONE IP 35G ECO TEXT", "OPENSTAGE DESK PHONE IP 35G", "ELETRODUTO PVC 1.1/2", "ESPELHO 3X3 SISTEMA X 1 SAÍDA RJ FÊMEA", "ESPUMA PARA HEADSET FONE DE OUVIDO", "ESTABILIZADOR", "ESTICADOR DROP PRETO PARA FIO", "ESTICADOR P/ CABO DROP ÓPTICO ABERTURA LATERAL LARANJA", "ESTICADOR P/ CABO DROP ÓPTICO ABERTURA LATERAL PRETO", "FANVIL", "FITA ISOLANTE", "FONTE GPI 130", "FONTE CHAVEADA 5V 02A", "FONTE CHAVEADA 12V 1 A", "FONTE CHAVEADA 12V - 1 A", "FONTE CHAVEADA 48V 05A POE", "FONTE LUNA - 2", "FORTI AP 234F", "FORTI AP - 431F", "FORTI GATE 60E", "FORTI GATE 200E", "FORTI GATE 401F", "FORTI GATE - 600E", "ROTEADOR CPE FORTINET FS108EPOE", "FORTI SWITCH 108F", "FORTI SWITCH 108F - POE", "FORTI SWITCH 108F-FPOE", "ROTEADOR CPE FORTINET FS124EFPOE", "FORTIAP 221E", "FORTIAP 223E", "HASTE DE ATERRAMENTO", "HEADSET - UNIXTRON -MICRO C/ESPUMA", "HEADSET - UNIXTRON MICRO - S/ ESPUMA", "OPENSTAGE KEY MODULE 15 LAVA", "LUVA PVC P/ELETRODUTO 3/4", "MEDIATRIX 4108", "MEDIATRIX C-710", "MEDIATRIX C-711", "MEDIATRIX C-4102", "MEDIATRIX C-4104", "MEDIATRIX S716 16H", "MEDIATRIX S7 24FXS 15 DSP", "MEDIATRIX S7 24FXS 75 SRV", "MEDIATRIX S7 24FXS 100 SRV", "MODULO OCCB3", "OPENSCAPE DESK PHONE CP 205", "OPENSTAGE 15 T LAVA", "OPENSTAGE DESK PHONE CP100", "OSBIZ X8", "PARAFUSO Nº 10", "PARAFUSO Nº 06", "PARAFUSO Nº 8", "PLACA DIUT2", "PLACA OCCBL MODULE", "PLACA SLMAC 4K", "PLACA SLMAV24 4K", "PLACA SLMAV24N OSBIZ X8", "PLACA SLMU OSBIZ X8", "PLACA TME1", "BLACKWIRE C3220 FONE DE OUVIDO C/ CONECTO ( HEADSET PLANTRONICS )", "ROSETA OPTICA 2P 4X2 SOBREPOR BRANCO", "ROTEADOR CPE SYNWAY 1E1 GATEWAY (ALIGERA)", "ROTEADOR CPE SYNWAY 2E1 GATEWAY (ALIGERA)", "SILVER PACK", "TOMADA 2P + T 10A 250V BRANCA", "TOMADA 2P+T VERTICAL 10A/250VCA SEM PLACA MILLENIUN (39013)", "VOICE PANEL 50 PORTAS CAT3", "APARELHO TELEFONE S/FIO INTELBRAS TS 2512", "RACK 5U", "NO-BREAK"];

(function() {
  function instalarBaseMateriais() {
    return; // A base principal já preserva os IDs usados pelo estoque e pelas solicitações.
    const lista = window.MATERIAIS_PLANILHA_V9 || [];
    if (!lista.length) return;

    // Procura todos os selects que tenham material no id/name.
    document.querySelectorAll('select').forEach(function(sel) {
      const id = (sel.id || '').toLowerCase();
      const name = (sel.name || '').toLowerCase();
      if (!id.includes('material') && !name.includes('material')) return;

      const atual = sel.value;
      const placeholder = Array.from(sel.options).find(o =>
        !o.value || /selecione|selecionar|escolha/i.test(o.textContent)
      );

      sel.innerHTML = '';
      if (placeholder) {
        const p = document.createElement('option');
        p.value = '';
        p.textContent = placeholder.textContent || 'Selecione...';
        sel.appendChild(p);
      } else {
        const p = document.createElement('option');
        p.value = '';
        p.textContent = 'Selecione...';
        sel.appendChild(p);
      }

      lista.forEach(function(nome) {
        const o = document.createElement('option');
        o.value = nome;
        o.textContent = nome;
        sel.appendChild(o);
      });

      if (atual && lista.includes(atual)) sel.value = atual;
    });
  }

  function configurarBusca() {
    return; // A pesquisa única é configurada no início da aplicação para admin e técnico.
    const busca = document.getElementById('busca-material-estoque');
    if (!busca || busca.dataset.v9 === '1') return;

    const select = Array.from(document.querySelectorAll('select')).find(function(s) {
      const id = (s.id || '').toLowerCase();
      return id.includes('material');
    });
    if (!select) return;

    busca.dataset.v9 = '1';

    let box = document.getElementById('resultado-material-v9');
    if (!box) {
      box = document.createElement('div');
      box.id = 'resultado-material-v9';
      box.style.cssText = 'position:absolute;left:0;right:0;top:100%;background:#fff;border:1px solid #bbb;border-radius:6px;max-height:240px;overflow:auto;z-index:10000;display:none;';
      busca.parentElement.style.position = 'relative';
      busca.parentElement.appendChild(box);
    }

    function pesquisar() {
      const termo = busca.value.trim().toLowerCase();
      box.innerHTML = '';
      if (!termo) {
        box.style.display = 'none';
        return;
      }

      const encontrados = (window.MATERIAIS_PLANILHA_V9 || []).filter(function(m) {
        return m.toLowerCase().includes(termo);
      });

      if (!encontrados.length) {
        box.innerHTML = '<div style="padding:10px;color:#777;">Material não encontrado na planilha.</div>';
      } else {
        encontrados.slice(0, 100).forEach(function(nome) {
          const item = document.createElement('div');
          item.textContent = nome;
          item.style.cssText = 'padding:10px;cursor:pointer;border-bottom:1px solid #eee;';
          item.addEventListener('click', function() {
            // O ponto principal da correção: carregar o valor diretamente no select.
            select.value = nome;
            busca.value = nome;
            box.style.display = 'none';

            // Dispara change para carregar quantidade/estoque.
            select.dispatchEvent(new Event('change', {bubbles:true}));
          });
          box.appendChild(item);
        });
      }
      box.style.display = 'block';
    }

    busca.addEventListener('input', pesquisar);
    busca.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const primeiro = box.querySelector('div[style*="cursor:pointer"]');
        if (primeiro) primeiro.click();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    instalarBaseMateriais();
    configurarBusca();
  });

  // Reaplica em momentos controlados, evitando observar o DOM continuamente
  // e entrar em ciclo quando o próprio carregamento dos materiais altera o select.
  setTimeout(function(){ instalarBaseMateriais(); configurarBusca(); }, 300);
  setTimeout(function(){ instalarBaseMateriais(); configurarBusca(); }, 1200);
})();
</script>

<script id="supabase-integration-v11">
/* ============================================================
   INTEGRAÇÃO SUPABASE - DESPACHO TÉCNICO v11
   Usa somente Publishable Key no navegador. Segurança via RLS.
   ============================================================ */
const SUPABASE_URL = 'https://hxbuoqxojwpsreakmfdc.supabase.co';
const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_8TfOJdgLoppVWJWjpfQwkw_bzIFuRyW';
const SB = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, {
  auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true },
  db: { schema: 'public' }
});
window.SB = SB;
window.__DT_PASSWORD_RECOVERY = false;
SB.auth.onAuthStateChange((event) => {
  if(event === 'PASSWORD_RECOVERY') window.__DT_PASSWORD_RECOVERY = true;
});
let SB_PROFILE = null;
let SB_SYNC_TIMER = null;
let SB_SYNCING = false;
let SB_SYNC_AGAIN = false;
let SB_LOADED_CH = new Set();
let SB_LOADED_MAT = new Set();
let SB_LOADED_MR = new Set();

function sbUUID(v){ return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(String(v||'')); }
function sbNum(v){ if(v===null||v===undefined||v==='') return 0; const s=String(v).replace(/R\$\s?/g,'').replace(/\./g,'').replace(',','.').replace(/[^0-9.-]/g,''); return Number(s)||0; }
function sbIso(v){ if(!v) return null; const d=new Date(v); return isNaN(d)?null:d.toISOString(); }
function sbIdByUser(u){ const p=[...(D.tc||[]),...(D.ad||[])].find(x=>x.u===u); return p?._id||null; }
function sbUserById(id){ const p=[...(D.tc||[]),...(D.ad||[])].find(x=>x._id===id); return p?.u||''; }
function sbNameById(id){ const p=[...(D.tc||[]),...(D.ad||[])].find(x=>x._id===id); return p?.n||''; }
function sbShowError(prefix, err){ console.error(prefix, err); alert(prefix + (err?.message ? ': '+err.message : '')); }

function sbSetConnectionBadge(text, ok=true){
  let b=document.getElementById('supabase-status-badge');
  if(!b){
    b=document.createElement('div'); b.id='supabase-status-badge';
    b.style.cssText='position:fixed;right:12px;bottom:12px;z-index:99999;padding:7px 10px;border-radius:999px;font:600 11px Arial;background:#fff;box-shadow:0 2px 10px #0002;border:1px solid #ddd';
    document.body.appendChild(b);
  }
  b.textContent=(ok?'● ':'● ')+text; b.style.color=ok?'#15803d':'#b91c1c';
}

// Impede que o carregamento inicial volte a semear o localStorage.
inicializarMateriaisPlanilha = function(){ return; };

async function sbLoadAll(){
  if(!SB_PROFILE) return;
  sbSetConnectionBadge('Sincronizando Supabase...', true);
  const [pR,cR,eR,aR,tR,mR,sR] = await Promise.all([
    SB.from('perfis').select('*').eq('ativo',true).order('nome'),
    SB.from('chamados').select('*').order('criado_em',{ascending:true}),
    SB.from('execucoes').select('*'),
    SB.from('aprovacoes').select('*'),
    SB.from('chamado_transferencias').select('*').order('criado_em',{ascending:true}),
    SB.from('materiais').select('*').eq('ativo',true).order('nome'),
    SB.from('solicitacoes_material').select('*').order('solicitado_em',{ascending:true})
  ]);
  for(const r of [pR,cR,eR,aR,tR,mR,sR]) if(r.error) throw r.error;

  D.tc=[]; D.ad=[];
  (pR.data||[]).forEach(p=>{
    const x={_id:p.id,n:p.nome,u:p.usuario,e:p.email||'',r:p.regiao||'',sk:p.skills||[],ar:p.areas||[],p:!!p.admin_geral,tipo:p.tipo,c:p.criado_em};
    if(p.tipo==='admin'||p.tipo==='logistica') D.ad.push(x); else D.tc.push(x);
  });

  const exMap=new Map((eR.data||[]).map(x=>[x.chamado_id,x]));
  const apMap=new Map((aR.data||[]).map(x=>[x.chamado_id,x]));
  const trMap=new Map();
  (tR.data||[]).forEach(x=>{ if(!trMap.has(x.chamado_id)) trMap.set(x.chamado_id,[]); trMap.get(x.chamado_id).push(x); });
  D.ch=(cR.data||[]).map(c=>{
    const ex=exMap.get(c.id), ap=apMap.get(c.id), trRows=trMap.get(c.id)||[];
    const legacy={
      id:c.id, pr:c.protocolo, sdm:c.sdm||'', abertura:c.abertura_origem||'', si:c.site_nome||'', ci:c.circuito||'',
      re:c.regiao, skill:c.skill, area:c.area||'', en:c.endereco||'', de:c.descricao||'', dtexec:c.data_execucao||'',
      regiaoOperacional:c.regiao_operacional||'', tecnicosIndicados:c.tecnicos_indicados||'', cid:c.cidade||'', contato:c.contato||'', horario:c.horario_expediente||'',
      velocidade:c.velocidade||'', prtm:c.prtm||'', pvfTotal:c.pvf_total??'', st:c.status, te:sbUserById(c.tecnico_id), mr:c.motivo_recusa||'',
      dt:c.liberacao_area?{tipo:'liberacao-area',admin:sbNameById(c.liberacao_area_admin),d:c.liberacao_area_em,area:c.area,regiaoOperacional:c.regiao_operacional}:null,
      cr:c.criado_em, ae:c.aceito_em, am:c.iniciado_em, cc:c.concluido_em,
      tr:trRows.map(x=>({de:sbUserById(x.de_tecnico_id),para:sbUserById(x.para_tecnico_id),m:x.motivo||'',d:x.criado_em,_dbid:x.id})),
      ex:null, ap:null
    };
    legacy._trLoadedCount=legacy.tr.length;
    if(ex) legacy.ex={co:ex.cidade_origem||'',cd:ex.cidade_destino||'',cr:ex.cidade_retorno||'',km:String(ex.km_total??''),vkm:'R$ '+Number(ex.valor_km||0).toFixed(2).replace('.',','),atv:ex.atividade||'',vatv:String(ex.valor_atividade??''),avulso:String(ex.valor_avulso??''),utp:String(ex.utp_metros??''),cci:String(ex.cci_metros??''),can:String(ex.canaleta_metros??''),tmat:'R$ '+Number(ex.valor_materiais||0).toFixed(2).replace('.',','),obs:ex.observacao||'',relatorio:ex.relatorio_encerramento||'',total:'R$ '+Number(ex.valor_total||0).toFixed(2).replace('.',',')};
    if(ap) legacy.ap={status:ap.status,obs:ap.observacao||'',data:ap.atualizado_em,admin:sbNameById(ap.administrador_id),reenviado:!!ap.reenviado};
    return legacy;
  });

  D.mat=(mR.data||[]).map(m=>({id:m.id,nome:m.nome,unidade:m.unidade,estoque:Number(m.estoque||0),c:m.criado_em}));
  D.mr=(sR.data||[]).map(r=>({id:r.id,chamadoId:r.chamado_id,tecnico:sbUserById(r.tecnico_id),materialId:r.material_id,qtdSolicitada:Number(r.quantidade_solicitada||0),qtdSeparada:Number(r.quantidade_separada||0),qtdEntregue:Number(r.quantidade_entregue||0),status:r.status,obs:r.observacao||'',data:r.solicitado_em,direcionadoEm:r.direcionado_em,separadoEm:r.separado_em,entregueEm:r.entregue_em,responsavel:sbNameById(r.responsavel_id)}));

  SB_LOADED_CH=new Set(D.ch.map(x=>x.id)); SB_LOADED_MAT=new Set(D.mat.map(x=>x.id)); SB_LOADED_MR=new Set(D.mr.map(x=>x.id));
  lsSet('dd',D);
  sbSetConnectionBadge('Supabase conectado', true);
}

async function sbSeedMaterialsIfNeeded(){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='admin') return;
  const {count,error}=await SB.from('materiais').select('*',{count:'exact',head:true});
  if(error) throw error;
  if((count||0)>0 || !Array.isArray(MATERIAIS_PLANILHA) || !MATERIAIS_PLANILHA.length) return;
  const rows=MATERIAIS_PLANILHA.map((nome,i)=>({codigo:'MAT-PLAN-'+String(i+1).padStart(3,'0'),nome,unidade:'UN',estoque:0}));
  const {error:insErr}=await SB.from('materiais').insert(rows);
  if(insErr) throw insErr;
}

function sbChamadoRow(c){
  return {
    protocolo:c.pr, sdm:c.sdm||null, abertura_origem:c.abertura||null, circuito:c.ci||'', site_nome:c.si||null, cidade:c.cid||null,
    endereco:c.en||null, contato:c.contato||null, horario_expediente:c.horario||null, velocidade:c.velocidade||null, prtm:c.prtm||null,
    pvf_total:c.pvfTotal===''?null:Number(c.pvfTotal)||null, regiao_operacional:c.regiaoOperacional||null, tecnicos_indicados:c.tecnicosIndicados||null,
    regiao:c.re, skill:c.skill, area:c.re==='capital'?(c.area||null):null, tecnico_id:sbIdByUser(c.te), criado_por:SB_PROFILE?.id||null,
    descricao:c.de||null, data_execucao:c.dtexec||null, status:c.st||'pendente', motivo_recusa:c.mr||null,
    liberacao_area:!!c.dt, liberacao_area_admin:c.dt?SB_PROFILE?.id:null, liberacao_area_em:c.dt?sbIso(c.dt.d):null,
    criado_em:sbIso(c.cr)||new Date().toISOString(), aceito_em:sbIso(c.ae), iniciado_em:sbIso(c.am), concluido_em:sbIso(c.cc), atualizado_em:new Date().toISOString()
  };
}

async function sbDirecionarMaterial(solicitacao){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='admin') throw new Error('Somente administradores podem direcionar materiais.');
  if(!sbUUID(solicitacao.id)) throw new Error('A solicitação ainda não possui identificação válida no servidor.');
  const agora=new Date().toISOString();
  const {data,error}=await SB.from('solicitacoes_material').update({
    status:'direcionado',
    responsavel_id:SB_PROFILE.id,
    direcionado_em:agora,
    atualizado_em:agora
  }).eq('id',solicitacao.id).select('id,status,direcionado_em').single();
  if(error) throw error;
  if(!data || data.status!=='direcionado') throw new Error('O servidor não confirmou o direcionamento.');
  sbSetConnectionBadge('Direcionamento sincronizado',true);
  return data;
}

async function sbPersistirAprovacoes(chamados,status,observacao){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='admin') throw new Error('Somente administradores podem aprovar serviços.');
  const ids=chamados.filter(c=>sbUUID(c.id)).map(c=>c.id);
  if(!ids.length || ids.length!==chamados.length) throw new Error('Um ou mais serviços ainda não possuem identificação válida no servidor.');
  const atualizadoEm=new Date().toISOString();
  const rows=ids.map(id=>({
    chamado_id:id,
    status,
    observacao:observacao||null,
    administrador_id:SB_PROFILE.id,
    reenviado:false,
    atualizado_em:atualizadoEm
  }));
  const {data,error}=await SB.from('aprovacoes').upsert(rows,{onConflict:'chamado_id'}).select('chamado_id,status');
  if(error) throw error;
  const confirmados=new Set((data||[]).filter(x=>x.status===status).map(x=>x.chamado_id));
  if(ids.some(id=>!confirmados.has(id))) throw new Error('O servidor não confirmou todos os serviços selecionados.');
  sbSetConnectionBadge(status==='aprovado'?'Aprovação sincronizada':'Rejeição sincronizada',true);
  return atualizadoEm;
}

async function sbPersistirFinalizacao(c){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='tecnico') throw new Error('Sessão do técnico inválida.');
  if(!sbUUID(c.id)) throw new Error('Chamado ainda não possui identificação válida no servidor.');
  if(c.te!==SB_PROFILE.usuario) throw new Error('Este chamado não está atribuído ao técnico conectado.');
  const execucao={
    chamado_id:c.id,
    tecnico_id:SB_PROFILE.id,
    cidade_origem:c.ex?.co||null,
    cidade_destino:c.ex?.cd||null,
    cidade_retorno:c.ex?.cr||null,
    km_total:sbNum(c.ex?.km),
    valor_km:sbNum(c.ex?.vkm),
    atividade:c.ex?.atv||null,
    valor_atividade:sbNum(c.ex?.vatv),
    valor_avulso:sbNum(c.ex?.avulso),
    utp_metros:sbNum(c.ex?.utp),
    cci_metros:sbNum(c.ex?.cci),
    canaleta_metros:sbNum(c.ex?.can),
    valor_materiais:sbNum(c.ex?.tmat),
    observacao:c.ex?.obs||null,
    relatorio_encerramento:c.ex?.relatorio||null,
    valor_total:sbNum(c.ex?.total),
    atualizado_em:new Date().toISOString()
  };
  const {error:execErr}=await SB.from('execucoes').upsert(execucao,{onConflict:'chamado_id'});
  if(execErr) throw execErr;
  const {data,error}=await SB.from('chamados').update({
    status:'concluida',
    concluido_em:sbIso(c.cc)||new Date().toISOString(),
    atualizado_em:new Date().toISOString()
  }).eq('id',c.id).eq('tecnico_id',SB_PROFILE.id).select('id,status,concluido_em').single();
  if(error) throw error;
  if(!data || data.status!=='concluida') throw new Error('O servidor não confirmou a conclusão do chamado.');
  sbSetConnectionBadge('Finalização sincronizada',true);
  return data;
}

async function sbSyncTecnico(){
  // O técnico nunca sincroniza cadastros ou registros administrativos.
  for(const c of D.ch.filter(x=>sbUUID(x.id) && x.te===SB_PROFILE.usuario)){
    const {error}=await SB.from('chamados').update({
      status:c.st||'pendente',
      motivo_recusa:c.mr||null,
      aceito_em:sbIso(c.ae),
      iniciado_em:sbIso(c.am),
      concluido_em:sbIso(c.cc),
      atualizado_em:new Date().toISOString()
    }).eq('id',c.id).eq('tecnico_id',SB_PROFILE.id);
    if(error) throw new Error('Chamado: '+error.message);
  }
  for(const c of D.ch.filter(x=>sbUUID(x.id) && x.te===SB_PROFILE.usuario && x.ex)){
    const row={chamado_id:c.id,tecnico_id:SB_PROFILE.id,cidade_origem:c.ex.co||null,cidade_destino:c.ex.cd||null,cidade_retorno:c.ex.cr||null,km_total:sbNum(c.ex.km),valor_km:sbNum(c.ex.vkm),atividade:c.ex.atv||null,valor_atividade:sbNum(c.ex.vatv),valor_avulso:sbNum(c.ex.avulso),utp_metros:sbNum(c.ex.utp),cci_metros:sbNum(c.ex.cci),canaleta_metros:sbNum(c.ex.can),valor_materiais:sbNum(c.ex.tmat),observacao:c.ex.obs||null,relatorio_encerramento:c.ex.relatorio||null,valor_total:sbNum(c.ex.total),atualizado_em:new Date().toISOString()};
    const {error}=await SB.from('execucoes').upsert(row,{onConflict:'chamado_id'});
    if(error) throw new Error('Execução: '+error.message);
  }
  for(const r of D.mr.filter(x=>!sbUUID(x.id) && x.tecnico===SB_PROFILE.usuario)){
    const {data,error}=await SB.from('solicitacoes_material').insert({chamado_id:r.chamadoId,tecnico_id:SB_PROFILE.id,material_id:r.materialId,quantidade_solicitada:Number(r.qtdSolicitada||0),quantidade_separada:0,quantidade_entregue:0,status:'solicitado',observacao:r.obs||null,solicitado_em:sbIso(r.data)||new Date().toISOString()}).select('id').single();
    if(error) throw new Error('Solicitação de material: '+error.message);
    r.id=data.id;
  }
  SB_LOADED_CH=new Set(D.ch.filter(x=>sbUUID(x.id)).map(x=>x.id));
  SB_LOADED_MR=new Set(D.mr.filter(x=>sbUUID(x.id)).map(x=>x.id));
  lsSet('dd',D);
  sbSetConnectionBadge('Supabase sincronizado',true);
}

async function sbSyncAll(){
  if(!SB_PROFILE) return;
  if(SB_SYNCING){ SB_SYNC_AGAIN=true; return; }
  SB_SYNCING=true;
  try{
    if(SB_PROFILE.tipo==='tecnico'){
      await sbSyncTecnico();
      return;
    }
    if(SB_PROFILE.tipo==='logistica') return;
    // Novos chamados com IDs locais -> INSERT e troca pelo UUID retornado.
    for(const c of D.ch.filter(x=>!sbUUID(x.id))){
      const old=c.id; const {data,error}=await SB.from('chamados').insert(sbChamadoRow(c)).select('id').single(); if(error) throw error; c.id=data.id;
      (D.mr||[]).forEach(r=>{if(r.chamadoId===old) r.chamadoId=data.id;});
    }
    if(SB_PROFILE.tipo==='admin'){
      const chRows=D.ch.filter(x=>sbUUID(x.id)).map(c=>({id:c.id,...sbChamadoRow(c)}));
      if(chRows.length){ const {error}=await SB.from('chamados').upsert(chRows,{onConflict:'id'}); if(error) throw error; }
    }else{
      for(const c of D.ch.filter(x=>sbUUID(x.id) && x.te===SB_PROFILE.usuario)){
        const {error}=await SB.from('chamados').update({
          status:c.st||'pendente',
          motivo_recusa:c.mr||null,
          aceito_em:sbIso(c.ae),
          iniciado_em:sbIso(c.am),
          concluido_em:sbIso(c.cc),
          atualizado_em:new Date().toISOString()
        }).eq('id',c.id).eq('tecnico_id',SB_PROFILE.id);
        if(error) throw error;
      }
    }
    if(SB_PROFILE.tipo==='admin'){
      const nowIds=new Set(D.ch.filter(x=>sbUUID(x.id)).map(x=>x.id)); const deleted=[...SB_LOADED_CH].filter(id=>!nowIds.has(id));
      if(deleted.length){ const {error}=await SB.from('chamados').delete().in('id',deleted); if(error) throw error; }
    }

    // Execuções e aprovações.
    const exRows=[]; const apRows=[];
    for(const c of D.ch){
      if(!sbUUID(c.id)) continue;
      if(c.ex) exRows.push({chamado_id:c.id,tecnico_id:sbIdByUser(c.te),cidade_origem:c.ex.co||null,cidade_destino:c.ex.cd||null,cidade_retorno:c.ex.cr||null,km_total:sbNum(c.ex.km),valor_km:sbNum(c.ex.vkm),atividade:c.ex.atv||null,valor_atividade:sbNum(c.ex.vatv),valor_avulso:sbNum(c.ex.avulso),utp_metros:sbNum(c.ex.utp),cci_metros:sbNum(c.ex.cci),canaleta_metros:sbNum(c.ex.can),valor_materiais:sbNum(c.ex.tmat),observacao:c.ex.obs||null,relatorio_encerramento:c.ex.relatorio||null,valor_total:sbNum(c.ex.total),atualizado_em:new Date().toISOString()});
      if(c.ap) apRows.push({chamado_id:c.id,status:c.ap.status||'pendente',observacao:c.ap.obs||null,administrador_id:SB_PROFILE.tipo==='admin'?SB_PROFILE.id:null,reenviado:!!c.ap.reenviado,atualizado_em:sbIso(c.ap.data)||new Date().toISOString()});
      const start=Number(c._trLoadedCount||0); const novos=(c.tr||[]).slice(start);
      for(const tr of novos){ const {error}=await SB.from('chamado_transferencias').insert({chamado_id:c.id,de_tecnico_id:sbIdByUser(tr.de),para_tecnico_id:sbIdByUser(tr.para),motivo:tr.m||null,realizado_por:SB_PROFILE.id,criado_em:sbIso(tr.d)||new Date().toISOString()}); if(error) throw error; }
      c._trLoadedCount=(c.tr||[]).length;
    }
    if(exRows.length){ const {error}=await SB.from('execucoes').upsert(exRows,{onConflict:'chamado_id'}); if(error) throw error; }
    if(apRows.length && SB_PROFILE.tipo==='admin'){ const {error}=await SB.from('aprovacoes').upsert(apRows,{onConflict:'chamado_id'}); if(error) throw error; }

    // Materiais: novos e existentes.
    for(const m of D.mat.filter(x=>!sbUUID(x.id))){
      const old=m.id; const {data,error}=await SB.from('materiais').insert({nome:m.nome,unidade:m.unidade||'UN',estoque:Number(m.estoque||0)}).select('id').single(); if(error) throw error; m.id=data.id;
      (D.mr||[]).forEach(r=>{if(r.materialId===old) r.materialId=data.id;});
    }
    if(D.mat.length && SB_PROFILE.tipo==='admin'){
      const rows=D.mat.filter(x=>sbUUID(x.id)).map(m=>({id:m.id,nome:m.nome,unidade:m.unidade||'UN',estoque:Number(m.estoque||0),ativo:true,atualizado_em:new Date().toISOString()}));
      const {error}=await SB.from('materiais').upsert(rows,{onConflict:'id'}); if(error) throw error;
      const nowIds=new Set(rows.map(x=>x.id)); const deleted=[...SB_LOADED_MAT].filter(id=>!nowIds.has(id)); if(deleted.length){ const {error:dErr}=await SB.from('materiais').update({ativo:false}).in('id',deleted); if(dErr) throw dErr; }
    }

    // Solicitações de material.
    for(const r of D.mr.filter(x=>!sbUUID(x.id))){
      const {data,error}=await SB.from('solicitacoes_material').insert({chamado_id:r.chamadoId,tecnico_id:sbIdByUser(r.tecnico)||SB_PROFILE.id,material_id:r.materialId,quantidade_solicitada:Number(r.qtdSolicitada||0),quantidade_separada:Number(r.qtdSeparada||0),quantidade_entregue:Number(r.qtdEntregue||0),status:r.status||'solicitado',observacao:r.obs||null,solicitado_em:sbIso(r.data)||new Date().toISOString()}).select('id').single(); if(error) throw error; r.id=data.id;
    }
    const mrRows=D.mr.filter(x=>sbUUID(x.id)).map(r=>({id:r.id,chamado_id:r.chamadoId,tecnico_id:sbIdByUser(r.tecnico)||SB_PROFILE.id,material_id:r.materialId,quantidade_solicitada:Number(r.qtdSolicitada||0),quantidade_separada:Number(r.qtdSeparada||0),quantidade_entregue:Number(r.qtdEntregue||0),status:r.status||'solicitado',observacao:r.obs||null,responsavel_id:SB_PROFILE.tipo==='admin'&&['direcionado','separado','entregue'].includes(r.status)?SB_PROFILE.id:null,direcionado_em:sbIso(r.direcionadoEm),separado_em:sbIso(r.separadoEm),entregue_em:sbIso(r.entregueEm),atualizado_em:new Date().toISOString()}));
    if(mrRows.length){ const {error}=await SB.from('solicitacoes_material').upsert(mrRows,{onConflict:'id'}); if(error) throw error; }

    SB_LOADED_CH=new Set(D.ch.filter(x=>sbUUID(x.id)).map(x=>x.id)); SB_LOADED_MAT=new Set(D.mat.filter(x=>sbUUID(x.id)).map(x=>x.id)); SB_LOADED_MR=new Set(D.mr.filter(x=>sbUUID(x.id)).map(x=>x.id));
    lsSet('dd',D); sbSetConnectionBadge('Supabase sincronizado', true);
  }catch(err){
    console.error('Erro de sincronização Supabase:',err);
    const detalhe=String(err?.message||'Falha desconhecida').slice(0,90);
    sbSetConnectionBadge('Erro: '+detalhe,false);
  }
  finally{ SB_SYNCING=false; if(SB_SYNC_AGAIN){SB_SYNC_AGAIN=false; sbSyncAll();} }
}

// Mantém compatibilidade com todas as funções antigas que já chamam sv().
sv = function(){
  lsSet('dd',D); // cache offline, não é mais a fonte principal.
  if(!SB_PROFILE) return;
  clearTimeout(SB_SYNC_TIMER); SB_SYNC_TIMER=setTimeout(sbSyncAll,250);
};
ss = function(){ lsSet('ss',S); };

showLogin = (function(original){
  return function(t){ original(t); const lu=el('lu'); if(lu){lu.type='email'; lu.placeholder='E-mail'; const lab=lu.closest('.form-group')?.querySelector('.label'); if(lab) lab.textContent='E-mail';} if(el('ls')) el('ls').textContent='Entre com seu e-mail e senha do Supabase'; };
})(showLogin);

doLogin = async function(){
  const email=el('lu').value.trim().toLowerCase(), senha=el('lp').value;
  el('le').style.display='none';
  if(!email || !senha || !email.includes('@')){ el('le').textContent='Informe o e-mail cadastrado no Supabase e a senha.'; el('le').style.display='block'; return; }
  const btn=el('btn-login'); if(btn){btn.disabled=true;btn.textContent='Entrando...';}
  try{
    const {data,error}=await SB.auth.signInWithPassword({email,password:senha}); if(error) throw error;
    const {data:p,error:pErr}=await SB.from('perfis').select('*').eq('id',data.user.id).single(); if(pErr) throw pErr;
    if(!p.ativo) throw new Error('Usuário desativado.');
    const temLogistica=p.tipo==='logistica'||(Array.isArray(p.areas)&&p.areas.includes('logistica'));
    if(loginType==='adm' && p.tipo!=='admin') throw new Error('Este usuário não possui perfil de administrador.');
    if(loginType==='log' && !temLogistica) throw new Error('Este usuário não possui acesso à área logística.');
    if(loginType==='tec' && p.tipo!=='tecnico') throw new Error('Este usuário não possui perfil de técnico.');
    SB_PROFILE=p;await sbSeedMaterialsIfNeeded();await sbLoadAll();
    if(loginType==='log') S={t:'log',n:p.nome,u:p.usuario,_id:p.id};
    else if(p.tipo==='admin') S={t:'adm',n:p.nome,u:p.usuario,p:!!p.admin_geral,_id:p.id};
    else S={t:'tec',n:p.nome,u:p.usuario,r:p.regiao,_id:p.id};
    localStorage.setItem('dt_portal',loginType);ss();
    if(S.t==='log')enterLog();else if(S.t==='adm')enterAdm();else enterTec();
  }catch(err){ await SB.auth.signOut().catch(()=>{}); SB_PROFILE=null; el('le').textContent=err?.message||'Falha no login'; el('le').style.display='block'; sbSetConnectionBadge('Não autenticado', false); }
  finally{ if(btn){btn.disabled=false;btn.textContent='Entrar';} }
};

logout = async function(){ await SB.auth.signOut(); SB_PROFILE=null; S=null; lsRemove('ss'); localStorage.removeItem('dt_portal'); goHome(); sbSetConnectionBadge('Desconectado', false); };

salvarMinhaSenha = async function(){
  if(!SB_PROFILE) return;
  const nova=el('ms-nova').value, conf=el('ms-conf').value;
  if(nova.length<6){alert('A nova senha deve ter pelo menos 6 caracteres');return;} if(nova!==conf){alert('A confirmação da nova senha não confere');return;}
  const {error}=await SB.auth.updateUser({password:nova}); if(error){sbShowError('Não foi possível alterar a senha',error);return;}
  el('m-senha').classList.remove('a');
  if(window.__DT_PASSWORD_RECOVERY){
    window.__DT_PASSWORD_RECOVERY=false;
    try{ history.replaceState(null,'',window.location.pathname + window.location.search); }catch(e){}
    if(el('ms-atual')) el('ms-atual').closest('.form-group').style.display='';
  }
  alert('Senha atualizada com sucesso no Supabase Auth.');
};

recuperarSenha = async function(){
  const email=el('rec-e').value.trim().toLowerCase(); if(!emailValido(email)){alert('Informe o e-mail cadastrado');return;}
  const redirectTo=window.location.origin + window.location.pathname;
  const {error}=await SB.auth.resetPasswordForEmail(email,{redirectTo}); if(error){sbShowError('Não foi possível enviar a recuperação',error);return;}
  el('m-rec').classList.remove('a'); alert('Solicitação enviada. Verifique o e-mail e clique no link para cadastrar uma nova senha.');
};

async function enviarRedefinicaoSenhaAdmin(usuario,email){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='admin'){ alert('Somente administradores podem enviar redefinição de senha.'); return; }
  email=String(email||'').trim().toLowerCase();
  if(!emailValido(email)){ alert('Este usuário não possui um e-mail válido cadastrado.'); return; }
  const nome=usuario||email;
  if(!confirm(`Enviar um link de redefinição de senha para ${nome} (${email})?`)) return;
  const redirectTo=window.location.origin + window.location.pathname;
  const {error}=await SB.auth.resetPasswordForEmail(email,{redirectTo});
  if(error){ sbShowError('Não foi possível enviar a redefinição de senha',error); return; }
  alert(`Link de redefinição enviado para ${email}. A senha atual não fica visível para o administrador.`);
}

// Cliente auxiliar para criar uma nova conta sem substituir a sessão do administrador logado.
// A conta Auth é criada pelo endpoint público de signup; o perfil é inserido pelo cliente principal,
// que continua autenticado como administrador e portanto respeita a policy perfis_admin_insert.
const SB_ACCOUNT_CREATOR = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, {
  auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false},
  global:{headers:{'X-Client-Info':'despacho-tecnico-account-creator'}}
});

async function sbCriarContaPerfil({nome,usuario,email,senha,tipo,regiao=null,skills=[],areas=[],adminGeral=false,enderecoEntrega=null}){
  if(!SB_PROFILE || SB_PROFILE.tipo!=='admin') throw new Error('Somente um administrador autenticado pode criar novas contas.');

  // Verifica perfis ativos e também permite reativar uma conta excluída.
  const {data:existentes,error:buscaErr}=await SB.from('perfis')
    .select('id,usuario,email,ativo')
    .or(`usuario.eq.${usuario},email.eq.${email}`)
    .limit(5);
  if(buscaErr) throw buscaErr;
  const usuarioNormalizado=usuario.toLowerCase(), emailNormalizado=email.toLowerCase();
  const mesmoUsuario=(existentes||[]).find(x=>String(x.usuario||'').toLowerCase()===usuarioNormalizado);
  const mesmoEmail=(existentes||[]).find(x=>String(x.email||'').toLowerCase()===emailNormalizado);
  const perfilExcluido=(existentes||[]).find(x=>
    x.ativo===false &&
    String(x.usuario||'').toLowerCase()===usuarioNormalizado &&
    String(x.email||'').toLowerCase()===emailNormalizado
  );
  if(perfilExcluido){
    const atualizacao={
      nome, usuario, email, tipo,
      admin_geral:tipo==='admin' ? !!adminGeral : false,
      regiao:tipo==='tecnico' ? regiao : null,
      skills:tipo==='tecnico' ? skills : [],
      areas:(tipo==='tecnico'||(tipo==='admin'&&areas.includes('logistica'))) ? (tipo==='tecnico'?areasComEndereco(areas,enderecoEntrega):areas) : [],
      ativo:true
    };
    const {error:reativarErr}=await SB.from('perfis').update(atualizacao).eq('id',perfilExcluido.id);
    if(reativarErr) throw reativarErr;
    const redirectTo=window.location.origin + window.location.pathname;
    const {error:senhaErr}=await SB.auth.resetPasswordForEmail(email,{redirectTo});
    if(senhaErr){
      await SB.from('perfis').update({ativo:false}).eq('id',perfilExcluido.id);
      throw new Error('O perfil foi localizado, mas não foi possível enviar a redefinição de senha: '+senhaErr.message);
    }
    return {reativado:true,perfil:{id:perfilExcluido.id,...atualizacao}};
  }
  if(mesmoUsuario) throw new Error('Este usuário já está cadastrado.');
  if(mesmoEmail) throw new Error('Este e-mail já está cadastrado.');

  const {data:authData,error:authErr}=await SB_ACCOUNT_CREATOR.auth.signUp({
    email,
    password:senha,
    options:{data:{nome,usuario,tipo}}
  });
  if(authErr) throw authErr;
  const novoUsuario=authData?.user;
  if(!novoUsuario?.id) throw new Error('O Supabase Auth não retornou o ID da nova conta. Verifique se novos cadastros estão habilitados em Authentication.');

  const perfil={
    id:novoUsuario.id,
    nome,
    usuario,
    email,
    tipo,
    admin_geral:tipo==='admin' ? !!adminGeral : false,
    regiao:tipo==='tecnico' ? regiao : null,
    skills:tipo==='tecnico' ? skills : [],
    areas:(tipo==='tecnico'||(tipo==='admin'&&areas.includes('logistica'))) ? (tipo==='tecnico'?areasComEndereco(areas,enderecoEntrega):areas) : [],
    ativo:true
  };
  const {error:perfilErr}=await SB.from('perfis').insert(perfil);
  if(perfilErr){
    throw new Error(`A conta foi criada no Auth, mas não foi possível gravar o perfil: ${perfilErr.message}. Não crie outra conta com o mesmo e-mail; corrija o perfil no Supabase.`);
  }
  await SB_ACCOUNT_CREATOR.auth.signOut().catch(()=>{});
  return {user:novoUsuario,perfil,confirmacaoPendente:!authData.session};
}

addTec = async function(){
  const n=el('t-n').value.trim(), u=el('t-u').value.trim(), e=el('t-e').value.trim().toLowerCase();
  const s=el('t-s').value, sc=el('t-sc').value, r=el('t-r').value;
  const sk=selecionados('t-sk'), ar=selecionados('t-ar');
  const enderecoEntrega=enderecoEntregaFormulario();
  if(!n||!u||!e||!s||!sc){alert('Preencha todos os campos');return;}
  if(!emailValido(e)){alert('Informe um e-mail válido');return;}
  if(s.length<6){alert('A senha deve ter pelo menos 6 caracteres');return;}
  if(s!==sc){alert('A confirmação da senha não confere');return;}
  if(!sk.length){alert('Selecione pelo menos uma skill para o técnico');return;}
  if(!ar.length){alert('Selecione pelo menos uma área de atendimento');return;}
  if((r==='interior'||r==='noronha')&&(limparCEP(enderecoEntrega.cep).length!==8||!enderecoEntrega.endereco||!enderecoEntrega.cidade||!enderecoEntrega.contato)){alert('Para técnico do Interior ou Fernando de Noronha, informe CEP, endereço, cidade/UF e contato para entrega.');return;}
  const btn=el('btn-add-tec'); const txt=btn?.innerHTML;
  if(btn){btn.disabled=true;btn.textContent='Criando conta...';}
  try{
    const res=await sbCriarContaPerfil({nome:n,usuario:u,email:e,senha:s,tipo:'tecnico',regiao:r,skills:sk,areas:ar,enderecoEntrega:(r==='capital'?null:enderecoEntrega)});
    await sbLoadAll(); rTc(); atualizarTecnicosChamado();
    el('t-n').value=''; el('t-u').value=''; el('t-e').value=''; el('t-s').value=''; el('t-sc').value='';
    limparEnderecoEntregaFormulario();
    document.querySelectorAll('input[name="t-sk"],input[name="t-ar"]').forEach(x=>x.checked=false);
    if(el('t-multi')) el('t-multi').checked=false;
    alert(res.reativado
      ? 'Técnico reativado com sucesso. Enviamos um link para o e-mail cadastrado definir uma nova senha.'
      : (res.confirmacaoPendente
        ? 'Conta e perfil do técnico criados. O Supabase pode exigir confirmação do e-mail antes do primeiro acesso.'
        : 'Conta e perfil do técnico criados com sucesso!'));
  }catch(err){sbShowError('Não foi possível criar a conta do técnico',err);}
  finally{if(btn){btn.disabled=false;btn.innerHTML=txt||'👤 Criar conta e perfil';}}
};

addAdm = async function(){
  const n=el('a-n').value.trim(), u=el('a-u').value.trim(), e=el('a-e').value.trim().toLowerCase();
  const s=el('a-s').value, sc=el('a-sc').value;
  if(!n||!u||!e||!s||!sc){alert('Preencha todos os campos');return;}
  if(!emailValido(e)){alert('Informe um e-mail válido');return;}
  if(s.length<6){alert('A senha deve ter pelo menos 6 caracteres');return;}
  if(s!==sc){alert('A confirmação da senha não confere');return;}
  const btn=el('btn-add-adm'); const txt=btn?.innerHTML;
  if(btn){btn.disabled=true;btn.textContent='Criando conta...';}
  try{
    const res=await sbCriarContaPerfil({nome:n,usuario:u,email:e,senha:s,tipo:'admin',adminGeral:false});
    await sbLoadAll(); rAd();
    el('a-n').value=''; el('a-u').value=''; el('a-e').value=''; el('a-s').value=''; el('a-sc').value='';
    alert(res.confirmacaoPendente
      ? 'Conta e perfil do administrador criados. O Supabase pode exigir confirmação do e-mail antes do primeiro acesso.'
      : 'Conta e perfil do administrador criados com sucesso!');
  }catch(err){sbShowError('Não foi possível criar a conta do administrador',err);}
  finally{if(btn){btn.disabled=false;btn.innerHTML=txt||'🛡️ Criar conta e perfil';}}
};

addLog = async function(){
  const n=el('l-n').value.trim(),u=el('l-u').value.trim(),e=el('l-e').value.trim().toLowerCase(),s=el('l-s').value,sc=el('l-sc').value;
  if(!n||!u||!e||!s||!sc){alert('Preencha todos os campos do perfil logístico');return;}
  if(!emailValido(e)){alert('Informe um e-mail válido');return;}if(s.length<6){alert('A senha deve ter pelo menos 6 caracteres');return;}if(s!==sc){alert('A confirmação da senha não confere');return;}
  const btn=el('btn-add-log'),txt=btn?.innerHTML;if(btn){btn.disabled=true;btn.textContent='Configurando acesso...';}
  try{
    const {data:existente,error:buscaErr}=await SB.from('perfis').select('*').ilike('email',e).maybeSingle();
    if(buscaErr)throw buscaErr;
    if(existente){
      if(existente.tipo==='admin'){
        const areas=Array.from(new Set([...(existente.areas||[]),'logistica']));
        const {error:updateErr}=await SB.from('perfis').update({areas,atualizado_em:new Date().toISOString()}).eq('id',existente.id);
        if(updateErr)throw updateErr;
        await sbLoadAll();rAd();['l-n','l-u','l-e','l-s','l-sc'].forEach(id=>el(id).value='');
        alert('Acesso logístico adicionado à conta de administrador existente. Use o mesmo e-mail e a mesma senha na Área Logística.');
        return;
      }
      if(existente.tipo==='logistica') throw new Error('Este e-mail já possui um perfil logístico. Entre na Área Logística com a senha já cadastrada.');
      throw new Error('Este e-mail pertence a um técnico e não pode ser reutilizado como responsável logístico.');
    }
    const res=await sbCriarContaPerfil({nome:n,usuario:u,email:e,senha:s,tipo:'logistica',areas:[],adminGeral:false});
    await sbLoadAll();rAd();['l-n','l-u','l-e','l-s','l-sc'].forEach(id=>el(id).value='');
    alert(res.reativado?'Perfil logístico reativado. Foi enviado um link para redefinir a senha.':'Perfil logístico criado com sucesso.');
  }catch(err){sbShowError('Não foi possível configurar o acesso logístico',err);}
  finally{if(btn){btn.disabled=false;btn.innerHTML=txt||'🚚 Criar perfil logístico';}}
};

async function sbRestoreSession(){
  try{
    const {data:{session}}=await SB.auth.getSession();
    if(!session){ S=null; lsRemove('ss'); sbSetConnectionBadge('Aguardando login', true); return; }
    const {data:p,error}=await SB.from('perfis').select('*').eq('id',session.user.id).single(); if(error) throw error;
    SB_PROFILE=p; await sbLoadAll();
    const temLogistica=p.tipo==='logistica'||(Array.isArray(p.areas)&&p.areas.includes('logistica'));
    const portal=localStorage.getItem('dt_portal');
    if(portal==='log'&&temLogistica) S={t:'log',n:p.nome,u:p.usuario,_id:p.id};
    else if(p.tipo==='admin') S={t:'adm',n:p.nome,u:p.usuario,p:!!p.admin_geral,_id:p.id};
    else if(p.tipo==='logistica') S={t:'log',n:p.nome,u:p.usuario,_id:p.id};
    else S={t:'tec',n:p.nome,u:p.usuario,r:p.regiao,_id:p.id};
    ss();
    setTimeout(()=>{
      if(S.t==='log') enterLog(); else if(S.t==='adm') enterAdm(); else enterTec();
      if(window.__DT_PASSWORD_RECOVERY){
        setTimeout(()=>{
          try{
            abrirMinhaSenha();
            if(el('ms-atual')) el('ms-atual').closest('.form-group').style.display='none';
            alert('Recuperação de senha autorizada. Digite e confirme sua nova senha.');
          }catch(e){ console.error(e); }
        },250);
      }
    },0);
  }catch(err){ console.error(err); SB_PROFILE=null; S=null; lsRemove('ss'); sbSetConnectionBadge('Sessão inválida', false); }
}

let SB_REFRESHING=false;
function sbRenderizarTelas(){
  try{
    if(S?.t==='adm'){rDb();rAt();rCh();rRl();rTc();rMl();}
    else if(S?.t==='tec'){rTdb();rTdp();rTat();rTco();rTar();rTmat();}
    else if(S?.t==='log'){rLog();}
  }catch(e){console.error('Erro ao atualizar telas:',e);}
}
async function sbRecarregarDados(){
  if(!SB_PROFILE || SB_SYNCING || SB_REFRESHING) return;
  SB_REFRESHING=true;
  try{await sbLoadAll();sbRenderizarTelas();}
  catch(err){console.error('Erro ao recarregar dados:',err);sbSetConnectionBadge('Erro ao atualizar dados',false);}
  finally{SB_REFRESHING=false;}
}

document.addEventListener('DOMContentLoaded',()=>{
  // Remove eventual auto-login do cache antigo: a sessão válida agora é do Supabase Auth.
  S=null; lsRemove('ss');
  setTimeout(sbRestoreSession,0);

  // Realtime: recarrega os dados quando outro navegador altera tabelas operacionais.
  SB.channel('despacho-tecnico-realtime')
    .on('postgres_changes',{event:'*',schema:'public',table:'chamados'},sbRecarregarDados)
    .on('postgres_changes',{event:'*',schema:'public',table:'execucoes'},sbRecarregarDados)
    .on('postgres_changes',{event:'*',schema:'public',table:'aprovacoes'},sbRecarregarDados)
    .on('postgres_changes',{event:'*',schema:'public',table:'materiais'},sbRecarregarDados)
    .on('postgres_changes',{event:'*',schema:'public',table:'solicitacoes_material'},sbRecarregarDados)
    .subscribe();

  // Segurança adicional: o administrador confere o servidor a cada 10 segundos,
  // mesmo quando o navegador não recebe um evento Realtime.
  setInterval(()=>{
    if(SB_PROFILE?.tipo==='admin' && document.visibilityState!=='hidden') sbRecarregarDados();
  },10000);
  document.addEventListener('visibilitychange',()=>{
    if(document.visibilityState==='visible' && SB_PROFILE?.tipo==='admin') sbRecarregarDados();
  });
});

</script>
</body>
</html>
