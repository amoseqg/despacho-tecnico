<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#0b172a">
<title>NexoField</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
function fixarSelecaoMaterial(selectId, valor) {
  const s = document.getElementById(selectId);
  if (!s) return;
  const v = String(valor ?? '');
  s.value = v;
  // Se a lista foi reconstruída, garante que a opção continue disponível.
  if (v && !Array.from(s.options).some(o => o.value === v)) {
    const opt = document.createElement('option');
    opt.value = v;
    opt.textContent = v;
    s.appendChild(opt);
    s.value = v;
  }
}


(function(){
  function iniciarBuscaMaterial(inputId, selectId, resultadosId){
    const busca = document.getElementById(inputId);
    const select = document.getElementById(selectId);
    if(!busca || !select || busca.dataset.ready) return;
    busca.dataset.ready = '1';

    let resultados = document.getElementById(resultadosId);
    if(!resultados){
      resultados = document.createElement('div');
      resultados.id = resultadosId;
      resultados.style.cssText =
        'display:none;background:#fff;border:1px solid #cfd6df;border-radius:8px;' +
        'margin-top:4px;max-height:240px;overflow-y:auto;box-shadow:0 4px 12px rgba(0,0,0,.12);position:relative;z-index:9999;';
      busca.parentNode.appendChild(resultados);
    }

    function obterMateriais(){
      if (typeof D !== 'undefined' && Array.isArray(D.mat) && D.mat.length) return D.mat;
      return Array.from(select.options)
        .filter(o => o.value)
        .map(o => ({id:o.value,nome:o.textContent.replace(/\s*\([^)]*\)\s*$/,''),unidade:''}));
    }

    function selecionar(id, nome){
      select.value = String(id);
      busca.value = nome;
      resultados.style.display = 'none';
      select.dispatchEvent(new Event('change', {bubbles:true}));
      select.dispatchEvent(new Event('input', {bubbles:true}));
      const qtd = selectId === 'ml-estoque-material' ? document.getElementById('ml-estoque-qtd')
        : (selectId === 'lg-estoque-material' ? document.getElementById('lg-estoque-qtd') : null);
      if(qtd && typeof D !== 'undefined' && typeof materialById === 'function'){
        const m = materialById(id);
        if(m) qtd.value = m.estoque || 0;
      }
    }

    function mostrar(){
      const termo = busca.value.trim().toLowerCase();
      const materiais = obterMateriais();
      resultados.innerHTML = '';

      if(!termo){
        resultados.style.display = 'none';
        return;
      }

      const encontrados = materiais.filter(m =>
        String(m.nome || '').toLowerCase().includes(termo)
      );

      if(!encontrados.length){
        resultados.innerHTML = '<div style="padding:10px;color:#777">Nenhum material encontrado na planilha.</div>';
        resultados.style.display = 'block';
        return;
      }

      encontrados.slice(0,100).forEach(m=>{
        const item=document.createElement('div');
        item.textContent = m.nome;
        item.style.cssText='padding:10px 12px;cursor:pointer;border-bottom:1px solid #eee;';
        item.addEventListener('mouseenter',()=>item.style.background='#f4f7fa');
        item.addEventListener('mouseleave',()=>item.style.background='#fff');
        item.addEventListener('mousedown',e=>{
          e.preventDefault();
          selecionar(m.id,m.nome);
        });
        resultados.appendChild(item);
      });
      resultados.style.display='block';
    }

    busca.addEventListener('input', function(){
      const valor=this.value.trim().toLowerCase();
      const materiais=obterMateriais();
      const exato=materiais.find(m=>String(m.nome).trim().toLowerCase()===valor);
      if(exato) selecionar(exato.id,exato.nome);
      else mostrar();
    });
    busca.addEventListener('focus', mostrar);
    busca.addEventListener('keydown', function(e){
      if(e.key==='Enter'){
        const materiais=obterMateriais();
        const valor=this.value.trim().toLowerCase();
        const m=materiais.find(x=>String(x.nome).toLowerCase()===valor) ||
                materiais.find(x=>String(x.nome).toLowerCase().startsWith(valor));
        if(m){e.preventDefault();selecionar(m.id,m.nome);}
      }
    });
    document.addEventListener('click',e=>{
      if(!busca.contains(e.target) && !resultados.contains(e.target))
        resultados.style.display='none';
    });

    // Quando a tela reconstruir o select, restaura o material atualmente selecionado.
    const obs=new MutationObserver(()=>{
      if(select.value){
        const m=obterMateriais().find(x=>String(x.id)===String(select.value));
        if(m && !busca.value) busca.value=m.nome;
      }
    });
    obs.observe(select,{childList:true});
  }
  document.addEventListener('DOMContentLoaded',function(){
    iniciarBuscaMaterial('busca-material-estoque','ml-estoque-material','resultados-busca-material-estoque');
    iniciarBuscaMaterial('busca-material-logistica','lg-estoque-material','resultados-busca-material-logistica');
    iniciarBuscaMaterial('busca-material-tecnico','tm-material','resultados-busca-material-tecnico');
  });
})();

</script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--p:#0f172a;--a:#3b82f6;--g:#22c55e;--y:#f59e0b;--r:#ef4444;--gr:#64748b;--l:#f8fafc;--b:#e2e8f0}
body{font-family:system-ui,-apple-system,sans-serif;background:#f1f5f9;min-height:100vh}
.btn{padding:8px 14px;border:none;border-radius:8px;font-size:.8rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:.2s}
.btn-p{background:var(--a);color:#fff}.btn-p:hover{background:#2563eb}
.btn-s{background:#fff;color:var(--gr);border:1px solid var(--b)}.btn-s:hover{background:var(--l)}
.btn-g{background:var(--g);color:#fff}.btn-g:hover{background:#16a34a}
.btn-r{background:var(--r);color:#fff}.btn-r:hover{background:#dc2626}
.btn-y{background:var(--y);color:#fff}.btn-y:hover{background:#d97706}
.card{background:#fff;border-radius:12px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);border:1px solid var(--b);margin-bottom:10px}
.input{width:100%;padding:8px 10px;border:1px solid var(--b);border-radius:8px;font-size:.8rem;outline:none;transition:.2s}
.input:focus{border-color:var(--a);box-shadow:0 0 0 2px rgba(59,130,246,.1)}
.label{display:block;font-size:.65rem;font-weight:600;color:var(--p);margin-bottom:3px;text-transform:uppercase;letter-spacing:.5px}
.badge{padding:3px 8px;border-radius:20px;font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.3px}
.b-pendente{background:#fef3c7;color:#92400e}
.b-andamento{background:#dbeafe;color:#1e40af}
.b-concluida{background:#dcfce7;color:#166534}
.b-recusado{background:#fee2e2;color:#991b1b}
.b-capital{background:#ede9fe;color:#5b21b6}
.b-interior{background:#d1fae5;color:#065f46}
.nav{display:flex;gap:3px;padding:10px 12px;background:#fff;border-bottom:1px solid var(--b);overflow-x:auto;position:sticky;top:0;z-index:50;-webkit-overflow-scrolling:touch}
.nav button{padding:6px 10px;border:none;background:transparent;color:var(--gr);font-size:.7rem;font-weight:500;border-radius:6px;cursor:pointer;white-space:nowrap;transition:.2s}
.nav button.a{background:var(--p);color:#fff}
.nav button:hover:not(.a){background:var(--l)}
.header{background:var(--p);color:#fff;padding:12px 16px}
.header h1{font-size:1rem;display:flex;align-items:center;gap:6px}
.header .sub{font-size:.65rem;opacity:.7}
.content{padding:12px;max-width:1100px;margin:0 auto}
.grid-2{display:grid;grid-template-columns:1fr;gap:10px}
@media(min-width:640px){.grid-2{grid-template-columns:1fr 1fr}}
.grid-3{display:grid;grid-template-columns:1fr;gap:10px}
@media(min-width:640px){.grid-3{grid-template-columns:repeat(3,1fr)}}
.grid-4{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:640px){.grid-4{grid-template-columns:repeat(4,1fr)}}
.stat{border-left:3px solid var(--a);padding:12px}
.stat.g{border-left-color:var(--g)}.stat.y{border-left-color:var(--y)}.stat.r{border-left-color:var(--r)}
.stat .v{font-size:1.5rem;font-weight:700;color:var(--p)}
.stat .l{font-size:.6rem;color:var(--gr);text-transform:uppercase;letter-spacing:.5px}
.os{background:#fff;border-radius:10px;padding:12px;border:1px solid var(--b);margin-bottom:8px;transition:.2s}
.os:hover{box-shadow:0 4px 12px rgba(0,0,0,.08)}
.os-h{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.os-id{font-weight:700;color:var(--p);font-size:.85rem}
.os-r{font-size:.75rem;color:var(--gr);margin-bottom:3px;line-height:1.4}
.os-r b{color:var(--p);font-weight:500}
.timer{font-family:monospace;font-size:.8rem;font-weight:700;padding:3px 8px;border-radius:6px;display:inline-block}
.t-g{background:#dcfce7;color:#166534}
.t-y{background:#fef3c7;color:#92400e}
.t-r{background:#fee2e2;color:#991b1b}
.t-c{background:var(--r);color:#fff;animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:none;align-items:center;justify-content:center;padding:12px}
.modal.a{display:flex}
.modal-box{background:#fff;border-radius:14px;width:100%;max-width:650px;max-height:92vh;overflow-y:auto;animation:slideUp .3s ease}
@keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.modal-hd{padding:14px 16px;border-bottom:1px solid var(--b);display:flex;justify-content:space-between;align-items:center}
.modal-hd h3{font-size:.9rem;color:var(--p)}
.modal-bd{padding:14px 16px}
.modal-ft{padding:12px 16px;border-top:1px solid var(--b);display:flex;gap:6px;justify-content:flex-end}
.close{background:none;border:none;font-size:1.3rem;color:var(--gr);cursor:pointer;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:6px}
.close:hover{background:var(--l)}
.table{width:100%;border-collapse:collapse;font-size:.75rem}
.table th{text-align:left;padding:8px;color:var(--gr);font-weight:600;border-bottom:2px solid var(--b);white-space:nowrap}
.table td{padding:8px;border-bottom:1px solid var(--b);vertical-align:middle}
.empty{text-align:center;padding:30px 16px;color:var(--gr);font-size:.8rem}
.empty h3{color:var(--p);margin-bottom:4px;font-size:1rem}
.login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f172a,#1e293b);padding:12px}
.login-box{background:#fff;border-radius:14px;padding:24px;width:100%;max-width:380px;box-shadow:0 20px 40px rgba(0,0,0,.3)}
.login-box h2{text-align:center;color:var(--p);font-size:1.1rem}
.login-box p{text-align:center;color:var(--gr);font-size:.75rem;margin-bottom:18px}
.area-card{background:#fff;border-radius:14px;padding:22px;text-align:center;cursor:pointer;transition:.2s;border:2px solid transparent;box-shadow:0 4px 12px rgba(0,0,0,.1)}
.area-card:hover{border-color:var(--a);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.15)}
.area-card .icon{font-size:2rem;margin-bottom:8px}
.area-card h3{color:var(--p);font-size:1rem;margin-bottom:3px}
.area-card p{color:var(--gr);font-size:.7rem}
.form-group{margin-bottom:10px}
.select{width:100%;padding:8px 10px;border:1px solid var(--b);border-radius:8px;font-size:.8rem;outline:none;background:#fff}
.select:focus{border-color:var(--a);box-shadow:0 0 0 2px rgba(59,130,246,.1)}
.user-bar{background:#1e293b;color:#fff;padding:6px 12px;font-size:.65rem;display:flex;justify-content:space-between;align-items:center}
.user-bar button{background:transparent;border:1px solid rgba(255,255,255,.2);color:#fff;padding:3px 8px;border-radius:5px;cursor:pointer;font-size:.6rem;transition:.2s}
.user-bar button:hover{background:rgba(255,255,255,.1)}
.info{background:#dbeafe;border:1px solid #bfdbfe;border-radius:6px;padding:8px;margin-bottom:10px;color:#1e40af;font-size:.75rem;line-height:1.4}
.trava{background:#fee2e2;border:1px solid #fecaca;border-radius:6px;padding:8px;margin-bottom:10px;color:#991b1b;font-size:.75rem;line-height:1.4}
.hidden{display:none!important}
.total-box{background:#e8f5e9;border:1px solid #a5d6a7;border-radius:8px;padding:12px;margin-top:12px}
.total-box strong{color:#166534;font-size:1rem}
.info-dist{background:#e3f2fd;border-left:3px solid #2196f3;padding:10px;border-radius:4px;margin:8px 0;color:#1565c0;font-size:.75rem}
.pl-card-mini{background:#fff;border-radius:14px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.06);border:1px solid var(--b);cursor:pointer;transition:.2s;text-align:center}
.pl-card-mini:hover{border-color:var(--a);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.1)}
.pl-card-mini .icon{font-size:2.2rem;margin-bottom:8px}
.pl-card-mini h3{font-size:1rem;color:var(--p);margin-bottom:4px}
.pl-card-mini .reg{font-size:.7rem;color:var(--gr);margin-bottom:8px}
.pl-card-mini .tot{font-size:1.3rem;font-weight:700;color:var(--p);margin:8px 0}
.pl-card-mini .qtd{font-size:.7rem;color:var(--gr)}
.pl-table{width:100%;border-collapse:collapse;font-size:.72rem;margin-top:8px}
.pl-table th{text-align:left;padding:6px 4px;color:var(--gr);font-weight:600;border-bottom:2px solid var(--b);white-space:nowrap}
.pl-table td{padding:6px 4px;border-bottom:1px solid var(--b);vertical-align:middle}
.pl-table tr:hover{background:var(--l)}
.pl-ft{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px;padding-top:10px;border-top:1px solid var(--b)}
.pl-resumo{display:flex;gap:16px;flex-wrap:wrap;font-size:.75rem;color:var(--gr)}
.pl-resumo b{color:var(--p)}
.b-aprovado{background:#dcfce7;color:#166534}
.b-rejeitado{background:#fee2e2;color:#991b1b}
.b-pag-pendente{background:#fef3c7;color:#92400e}

/* Identidade NexoField mantida diretamente no código-fonte. */
.nf-logo{width:30px;height:30px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#2563eb,#60a5fa);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:-.03em;box-shadow:0 6px 16px rgba(37,99,235,.28);vertical-align:middle}
.header h1 .nf-brand-name{font-weight:800;letter-spacing:-.02em}
#t0 .nf-login-brand{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:7px}
#t0 .nf-login-brand .nf-logo{width:44px;height:44px;border-radius:13px;font-size:.9rem}
#t0 .nf-login-brand .nf-brand-name{color:#fff;font-size:1.55rem;font-weight:800;letter-spacing:-.035em}

/* ===== NEXOFIELD DESIGN SYSTEM 2.0 ===== */
:root{
  --p:#10213d;--a:#2563eb;--g:#16a34a;--y:#d97706;--r:#dc2626;--gr:#64748b;
  --l:#f8fafc;--b:#dbe3ee;--nf-bg:#eef3f9;--nf-card:#ffffff;
  --nf-navy:#0b172a;--nf-blue:#2563eb;--nf-cyan:#0ea5e9;
  --nf-text:#14233b;--nf-muted:#66758b;--nf-ring:rgba(37,99,235,.16);
  --nf-shadow:0 10px 30px rgba(15,35,65,.08);--nf-shadow-lg:0 24px 70px rgba(5,18,38,.22);
}
html{scroll-behavior:smooth}
body{color:var(--nf-text);background:
  radial-gradient(circle at 8% 0%,rgba(37,99,235,.09),transparent 25rem),
  linear-gradient(180deg,#f5f8fc 0%,var(--nf-bg) 100%);font-size:15px}
button,input,select,textarea{font:inherit}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
  outline:3px solid var(--nf-ring);outline-offset:2px
}
.hidden{display:none!important}

/* Entrada e autenticação */
.login-screen{position:relative;isolation:isolate;overflow:hidden;min-height:100dvh;
  background:linear-gradient(145deg,#081426 0%,#10284b 58%,#17457c 100%);padding:clamp(20px,5vw,64px)}
.login-screen:before,.login-screen:after{content:"";position:absolute;z-index:-1;border-radius:999px;filter:blur(2px)}
.login-screen:before{width:460px;height:460px;right:-150px;top:-170px;background:rgba(56,189,248,.12)}
.login-screen:after{width:380px;height:380px;left:-160px;bottom:-190px;background:rgba(37,99,235,.18)}
.nf-login-brand{margin-bottom:10px!important}.nf-login-brand .nf-logo{
  background:linear-gradient(135deg,#3b82f6,#06b6d4)!important;box-shadow:0 14px 35px rgba(14,165,233,.3)!important
}
#t0 .nf-login-brand .nf-brand-name{font-size:clamp(1.7rem,4vw,2.3rem);letter-spacing:-.055em}
#t0 .nf-login-brand+ p{font-size:.82rem!important;letter-spacing:.03em;color:#a9bed8!important}
#t0 .grid-3{gap:14px;margin-top:28px}
.area-card{position:relative;overflow:hidden;min-height:176px;padding:26px 22px;border:1px solid rgba(255,255,255,.7);
  border-radius:20px;background:linear-gradient(160deg,rgba(255,255,255,.98),rgba(244,248,253,.96));
  box-shadow:0 16px 45px rgba(2,12,27,.18);display:flex;flex-direction:column;align-items:center;justify-content:center}
.area-card:before{content:"";position:absolute;inset:0 0 auto;height:4px;background:linear-gradient(90deg,#2563eb,#06b6d4);
  transform:scaleX(0);transform-origin:left;transition:transform .25s ease}
.area-card:hover,.area-card:focus-visible{border-color:#7db2ff;transform:translateY(-6px);box-shadow:0 24px 60px rgba(2,12,27,.28)}
.area-card:hover:before,.area-card:focus-visible:before{transform:scaleX(1)}
.area-card .icon{width:52px;height:52px;margin:0 0 13px;border-radius:16px;background:#eaf2ff;display:grid;place-items:center;font-size:1.7rem}
.area-card h3{font-size:1rem;letter-spacing:-.015em}.area-card p{max-width:230px;line-height:1.45;color:var(--nf-muted)}
.login-box{max-width:420px;padding:30px;border:1px solid rgba(255,255,255,.75);border-radius:22px;box-shadow:var(--nf-shadow-lg)}
.login-box h2{font-size:1.3rem;letter-spacing:-.025em}.login-box p{margin-top:5px;margin-bottom:22px}

/* Estrutura dos painéis */
.header{position:relative;padding:18px clamp(16px,3vw,32px);background:linear-gradient(110deg,#0b172a,#15345e);
  box-shadow:0 8px 24px rgba(6,22,45,.18)}
.header:after{content:"";position:absolute;inset:auto 0 0;height:2px;background:linear-gradient(90deg,#2563eb,#22d3ee,transparent)}
.header h1{font-size:1.08rem;gap:10px}.header .sub{margin-top:2px;font-size:.68rem;color:#bbcee4;opacity:1;letter-spacing:.04em}
.nf-logo{flex:0 0 auto;background:linear-gradient(135deg,#2563eb,#0ea5e9);box-shadow:0 8px 20px rgba(37,99,235,.3)}
.user-bar{padding:8px clamp(16px,3vw,32px);background:#10213d;border-bottom:1px solid rgba(255,255,255,.08);color:#dbeafe}
.user-bar button{padding:6px 10px;border-color:rgba(255,255,255,.18);border-radius:8px}
.nav{top:0;gap:6px;padding:10px clamp(12px,3vw,30px);background:rgba(255,255,255,.94);
  border-bottom:1px solid rgba(203,213,225,.8);box-shadow:0 6px 22px rgba(15,35,65,.07);backdrop-filter:blur(14px)}
.nav button{padding:9px 13px;border-radius:10px;color:#52627a;font-size:.72rem;font-weight:650}
.nav button.a{background:linear-gradient(135deg,#173f77,#2563eb);color:#fff;box-shadow:0 7px 18px rgba(37,99,235,.22)}
.nav button:hover:not(.a){background:#edf4ff;color:#174ea6}
.content{max-width:1240px;padding:clamp(14px,2.5vw,28px)}

/* Superfícies, métricas e listas */
.card,.os,.pl-card-mini{border:1px solid rgba(203,213,225,.75);background:rgba(255,255,255,.96);box-shadow:var(--nf-shadow)}
.card{padding:clamp(15px,2vw,21px);border-radius:16px;margin-bottom:14px}
.os{padding:15px;border-radius:14px;margin-bottom:10px}
.os:hover{transform:translateY(-2px);border-color:#aac8f4;box-shadow:0 14px 35px rgba(15,35,65,.11)}
.grid-2,.grid-3,.grid-4{gap:14px}
.stat{position:relative;overflow:hidden;min-height:112px;padding:18px;border:0!important;border-radius:15px;
  background:linear-gradient(145deg,#fff,#f7faff);box-shadow:inset 0 0 0 1px #dde7f3,var(--nf-shadow)}
.stat:before{content:"";position:absolute;left:0;top:18px;bottom:18px;width:4px;border-radius:0 8px 8px 0;background:var(--a)}
.stat.g:before{background:var(--g)}.stat.y:before{background:var(--y)}.stat.r:before{background:var(--r)}
.stat .v{font-size:1.75rem;letter-spacing:-.05em}.stat .l{font-size:.63rem;line-height:1.4;color:#708096;font-weight:700}
.pl-card-mini{border-radius:17px}.pl-card-mini:hover{border-color:#8db7f2;box-shadow:0 16px 36px rgba(15,35,65,.12)}
.empty{padding:42px 18px}.empty h3{font-size:1.05rem}

/* Formulários e botões */
.label{margin-bottom:6px;color:#34445d;font-size:.64rem;font-weight:750;letter-spacing:.065em}
.input,.select{min-height:40px;padding:9px 12px;border-color:#cbd7e6;border-radius:10px;background:#fff;color:var(--nf-text)}
textarea.input{min-height:92px;line-height:1.5;resize:vertical}
.input:hover,.select:hover{border-color:#9fb5d0}
.input:focus,.select:focus{border-color:#3b82f6;box-shadow:0 0 0 4px var(--nf-ring)}
.form-group{margin-bottom:14px}
.btn{min-height:36px;padding:8px 14px;border-radius:10px;font-weight:700;box-shadow:0 2px 5px rgba(15,35,65,.06)}
.btn:hover{transform:translateY(-1px)}
.btn-p{background:linear-gradient(135deg,#2563eb,#1d4ed8);box-shadow:0 8px 18px rgba(37,99,235,.2)}
.btn-g{background:linear-gradient(135deg,#16a34a,#15803d)}
.btn-r{background:linear-gradient(135deg,#ef4444,#dc2626)}
.btn-y{background:linear-gradient(135deg,#f59e0b,#d97706)}
.btn-s{background:#fff;color:#44556d;border-color:#cbd7e6}
.badge{padding:4px 9px;border-radius:999px;font-size:.59rem;font-weight:750}

/* Tabelas e mensagens */
.table,.pl-table{border-collapse:separate;border-spacing:0;width:100%}
.table th,.pl-table th{padding:10px 9px;background:#f3f7fc;color:#52627a;font-size:.64rem;text-transform:uppercase;letter-spacing:.04em;
  border-top:1px solid #dce5f0;border-bottom:1px solid #dce5f0}
.table th:first-child,.pl-table th:first-child{border-left:1px solid #dce5f0;border-radius:9px 0 0 9px}
.table th:last-child,.pl-table th:last-child{border-right:1px solid #dce5f0;border-radius:0 9px 9px 0}
.table td,.pl-table td{padding:11px 9px;border-bottom-color:#e7edf5}
.table tbody tr:hover,.pl-table tbody tr:hover{background:#f7faff}
.stat[data-db-filter]{cursor:pointer;text-align:left;width:100%;font:inherit;transition:transform .15s ease,box-shadow .15s ease}
.stat[data-db-filter]:hover,.stat[data-db-filter]:focus-visible{transform:translateY(-2px);box-shadow:0 10px 24px #1e3a5f20;outline:2px solid #2563eb55;outline-offset:2px}
.stat[data-db-filter]::after{content:'Clique para visualizar';display:block;margin-top:8px;font-size:.58rem;color:var(--gr);font-weight:600}
.info,.trava,.info-dist,.total-box{padding:11px 13px;border-radius:10px;line-height:1.5}
.info{background:#edf5ff;border-color:#c9e0ff}.trava{background:#fff0f0;border-color:#fecaca}

/* Modais */
.modal{padding:16px;background:rgba(4,14,30,.66);backdrop-filter:blur(8px)}
.modal-box{max-height:90dvh;border-radius:20px;border:1px solid rgba(255,255,255,.7);box-shadow:var(--nf-shadow-lg)}
.modal-hd{padding:17px 20px;background:linear-gradient(180deg,#fff,#f8fafc)}
.modal-hd h3{font-size:1rem;letter-spacing:-.015em}.modal-bd{padding:18px 20px}.modal-ft{padding:14px 20px;background:#f8fafc}
.close{border-radius:9px}

/* Logística ganha navegação visual consistente */
#plog>.content{max-width:1240px}
#plog .grid-2>.card{height:100%}

/* Responsividade */
@media(max-width:760px){
  body{font-size:14px}
  .login-screen{align-items:flex-start;padding:34px 14px}
  #t0 .grid-3{grid-template-columns:1fr;max-width:460px;margin:24px auto 0}
  .area-card{min-height:128px;padding:18px;display:grid;grid-template-columns:54px 1fr;text-align:left;column-gap:14px}
  .area-card .icon{grid-row:1/3;margin:0}.area-card h3,.area-card p{text-align:left;max-width:none}
  .header{padding:14px 16px}.user-bar{padding:7px 12px}.nav{padding:8px 10px}
  .nav button{padding:8px 10px}
  .content{padding:12px}
  .card{padding:14px;border-radius:14px}
  .grid-4{grid-template-columns:1fr 1fr}
  .table,.pl-table{min-width:680px}
  .card:has(>.table),.card:has(>.pl-table){overflow-x:auto}
  .modal{padding:8px;align-items:flex-end}.modal-box{max-height:94dvh;border-radius:20px 20px 0 0}
  .modal-bd{padding:15px}.modal-ft{position:sticky;bottom:0;z-index:2}
}
@media(max-width:420px){
  .grid-2,.grid-3,.grid-4{grid-template-columns:1fr}
  .stat{min-height:96px}.btn{width:100%;justify-content:center}
  .modal-ft{flex-direction:column-reverse}
}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}


/* ===== NEXOFIELD HUMAN & REAL ASSETS ===== */
.role-photo{width:calc(100% + 44px);height:130px;margin:-26px -22px 18px;background-size:cover;background-position:center;background-repeat:no-repeat;background-color:#dbeafe;box-shadow:inset 0 -35px 35px rgba(7,22,45,.08)}
.role-photo-tec{background-image:url("data:image/webp;base64,")}.role-photo-adm{background-image:url("data:image/webp;base64,")}.role-photo-log{background-image:url("data:image/webp;base64,")}
.area-card{justify-content:flex-start;min-height:282px}.area-card h3{margin-top:0}
.nf-dashboard-hero{position:relative;isolation:isolate;overflow:hidden;min-height:172px;margin-bottom:18px;border-radius:18px;
  background-size:cover;background-position:center;background-repeat:no-repeat;background-color:#0b172a;box-shadow:0 18px 42px rgba(9,29,58,.18)}
.nf-dashboard-admin{background-image:linear-gradient(90deg,rgba(5,18,38,.92) 0%,rgba(10,35,67,.78) 48%,rgba(10,35,67,.15) 100%),url("data:image/webp;base64,")}.nf-dashboard-tech{background-image:linear-gradient(90deg,rgba(5,18,38,.92) 0%,rgba(10,35,67,.78) 48%,rgba(10,35,67,.15) 100%),url("data:image/webp;base64,")}.nf-dashboard-log{background-image:linear-gradient(90deg,rgba(5,18,38,.92) 0%,rgba(10,35,67,.78) 48%,rgba(10,35,67,.15) 100%),url("data:image/webp;base64,")}
.nf-dashboard-hero>div{position:absolute;z-index:1;left:clamp(18px,4vw,42px);top:50%;transform:translateY(-50%);max-width:470px;color:#fff}
.nf-dashboard-hero span{display:block;margin-bottom:7px;color:#7dd3fc;font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em}
.nf-dashboard-hero strong{display:block;font-size:clamp(1.25rem,2.6vw,2rem);line-height:1.08;letter-spacing:-.035em}
.nf-dashboard-hero small{display:block;margin-top:9px;color:#d7e5f5;font-size:.78rem;line-height:1.5}
#plog>.content{padding-top:clamp(14px,2.5vw,28px)}
@media(max-width:760px){
  .area-card{display:flex;min-height:235px;text-align:center;padding:18px}
  .role-photo{width:calc(100% + 36px);height:112px;margin:-18px -18px 15px;border-radius:18px 18px 11px 11px}
  .area-card h3,.area-card p{text-align:center}
  .nf-dashboard-hero{min-height:145px;border-radius:14px;background-size:cover;background-position:center}
  .nf-dashboard-hero>div{left:18px;right:18px}.nf-dashboard-hero small{max-width:78%}
}


/* ===== NEXOFIELD IMAGE FRAMING FIX ===== */
.role-photo{
  height:auto;
  aspect-ratio:1/1;
  background-size:contain;
  background-position:center;
  background-repeat:no-repeat;
  box-shadow:none;
}
.area-card{
  min-height:0;
  height:auto;
  padding-bottom:24px;
}
.nf-dashboard-hero{
  min-height:240px;
  background-size:100% 100%,auto 100%;
  background-position:center,right center;
  background-repeat:no-repeat;
}
@media(max-width:760px){
  .role-photo{
    height:auto;
    aspect-ratio:1/1;
    background-size:contain;
  }
  .area-card{min-height:0}
  .nf-dashboard-hero{
    min-height:180px;
    background-size:100% 100%,auto 100%;
    background-position:center,right center;
  }
  .nf-dashboard-hero>div{max-width:62%}
  .nf-dashboard-hero small{max-width:100%}
}

</style>
<base target="_blank">
<base target="_blank">
<link rel="stylesheet" href="/appearance.css?v=1">
<link rel="stylesheet" href="/admin-alerts.css?v=1">
</head>
<body>

<!-- TELA INICIAL -->
<div id="t0">
  <div class="login-screen">
    <div style="width:100%;max-width:700px">
      <div style="text-align:center;margin-bottom:24px">
        <div class="nf-login-brand"><span class="nf-logo">NF</span><span class="nf-brand-name">NexoField</span></div>
        <p style="color:#94a3b8;font-size:.75rem">Gestão Inteligente de Operações de Campo</p>
      </div>
      <div class="grid-3">
        <div class="area-card" id="card-tec" role="button" tabindex="0" onclick="showLogin('tec')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showLogin('tec')}">
          <div class="role-photo role-photo-tec" role="img" aria-label="Técnico de campo com equipamentos de rede"></div>
          <h3>Área do Técnico</h3>
          <p>Acesse seus chamados e execute serviços</p>
        </div>
        <div class="area-card" id="card-adm" role="button" tabindex="0" onclick="showLogin('adm')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showLogin('adm')}">
          <div class="role-photo role-photo-adm" role="img" aria-label="Administradora em central de operações"></div>
          <h3>Área Administrador</h3>
          <p>Painel de gestão, despacho e relatórios</p>
        </div>
        <div class="area-card" id="card-log" role="button" tabindex="0" onclick="showLogin('log')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showLogin('log')}">
          <div class="role-photo role-photo-log" role="img" aria-label="Profissional de logística em armazém"></div>
          <h3>Área Logística</h3>
          <p>Separação, rastreamento e entrega de materiais</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- LOGIN -->
<div id="t1" class="hidden">
  <div class="login-screen">
    <div class="login-box">
      <div style="text-align:center;margin-bottom:16px">
        <div id="li" style="font-size:2rem;margin-bottom:4px">🛡️</div>
        <h2 id="lt">Área Administrador</h2>
        <p id="ls">Entre com suas credenciais</p>
      </div>
      <div class="form-group"><label class="label">Usuário</label><input type="text" id="lu" class="input" placeholder="Usuário"></div>
      <div class="form-group"><label class="label">Senha</label><input type="password" id="lp" class="input" placeholder="Senha"></div>
      <button class="btn btn-p" id="btn-login" style="width:100%;justify-content:center;margin-top:4px">Entrar</button>
      <button class="btn btn-s" id="btn-esqueceu" style="width:100%;justify-content:center;margin-top:6px">🔑 Esqueci minha senha</button>
      <button class="btn btn-s" id="btn-voltar" style="width:100%;justify-content:center;margin-top:6px">← Voltar</button>
      <div id="le" style="color:var(--r);font-size:.7rem;text-align:center;margin-top:8px;display:none">Usuário ou senha incorretos</div>
    </div>
  </div>
</div>

<!-- ADMIN -->
<div id="pa" class="hidden">
  <div class="user-bar"><span>🛡️ <b>Admin</b> — <span id="an"></span></span><div style="display:flex;gap:5px"><button class="btn-minha-senha">Alterar senha</button><button id="btn-sair-adm">Sair</button></div></div>
  <div class="header"><h1><span class="nf-logo">NF</span><span class="nf-brand-name">NexoField</span></h1><div class="sub">Painel Administrativo</div></div>
  <div class="nav" id="nv">
    <button class="a" data-tab="db">📊 Dashboard</button>
    <button data-tab="tc">👷 Técnicos</button>
    <button data-tab="ch">📞 Chamados</button>
    <button data-tab="at">⏱️ Atendimento</button>
    <button data-tab="rl">📊 Relatório</button>
     <button data-tab="ml">📦 Material Logístico</button>
    <button data-tab="vi">📄 Relatórios de vistorias</button>
    <button data-tab="ft">📷 Registros fotográficos</button>
    <button data-tab="aq">🗃️ Chamados excluídos</button>
    <button data-tab="ad">🔐 Admins</button>
  </div>
  <div class="content">
    <section class="nf-dashboard-hero nf-dashboard-admin" aria-label="Visão administrativa">
      <div><span>Central de operações</span><strong>Gestão em tempo real</strong><small>Chamados, equipes, prazos e indicadores em um só lugar.</small></div>
    </section>
    <div id="v-vi" class="hidden"><div class="card"><h3>Relatórios de vistorias</h3><label class="label" for="busca-vistorias-admin">Buscar por chamado, site ou técnico</label><input class="input" id="busca-vistorias-admin" type="search"><div id="vistorias-admin"></div></div></div>
    <div id="v-ft" class="hidden"><div class="card"><h3>Registros fotográficos dos chamados encerrados</h3><label class="label" for="busca-fotos-admin">Buscar por chamado, site ou técnico</label><input class="input" id="busca-fotos-admin" type="search" placeholder="Digite para localizar as fotos"><div id="fotos-admin"></div></div></div>
    <div id="v-aq" class="hidden"><div class="card"><h3>Chamados excluídos da lista</h3><p>Os chamados, históricos e valores continuam salvos. Digite no campo abaixo para consultar.</p><label class="label" for="busca-arquivados-admin">Buscar por chamado, site ou técnico</label><input class="input" id="busca-arquivados-admin" type="search" placeholder="Digite para localizar um chamado excluído"><div style="margin:8px 0"><button type="button" class="btn btn-p" id="btn-exportar-arquivados">📥 Exportar chamados excluídos</button></div><div id="lista-arquivados"></div></div></div>
    <div id="v-db">
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-bottom:10px"><span style="font-size:.65rem;color:var(--gr)">Indicadores de qualidade referentes ao mês atual.</span><button type="button" class="btn btn-s" id="btn-limpar-indicadores">🧹 Limpar indicadores</button></div>
      <div class="card" style="margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px"><h3 style="font-size:.85rem;color:var(--p)">📁 Base de chamados fechados</h3><span style="font-size:.65rem;color:var(--gr)">A exportação inclui quem abriu cada chamado.</span></div>
        <div class="grid-3" style="gap:8px"><div class="form-group"><label class="label">Data inicial do fechamento (opcional)</label><input type="date" id="db-base-dt1" class="input"></div><div class="form-group"><label class="label">Data final do fechamento (opcional)</label><input type="date" id="db-base-dt2" class="input"></div><div class="form-group" style="display:flex;align-items:flex-end"><button type="button" class="btn btn-p" id="btn-db-exp-base-fechados" style="width:100%">📥 Extrair base fechada</button></div></div>
      </div>
      <div class="grid-4" style="margin-bottom:14px">
        <button type="button" class="card stat" data-db-filter="pendente"><div class="l">Pendentes</div><div class="v" id="s-p">0</div></button>
        <button type="button" class="card stat y" data-db-filter="andamento"><div class="l">Andamento</div><div class="v" id="s-a">0</div></button>
        <button type="button" class="card stat g" data-db-filter="concluida"><div class="l">Concluídas</div><div class="v" id="s-c">0</div></button>
        <button type="button" class="card stat r" data-db-filter="recusado"><div class="l">Recusados</div><div class="v" id="s-r">0</div></button>
      </div>
      <div class="grid-3" style="margin-bottom:14px">
        <button type="button" class="card stat g" data-db-filter="dentro-prazo"><div class="l">Dentro do prazo (até 5h)</div><div class="v" id="s-prazo">0</div></button>
        <button type="button" class="card stat r" data-db-filter="perda-prazo"><div class="l">Perda de prazo (acima de 5h)</div><div class="v" id="s-perda">0</div></button>
        <button type="button" class="card stat y" data-db-filter="reincidencia"><div class="l">Reincidências</div><div class="v" id="s-reincidencia">0</div></button>
      </div>
      <div class="grid-2" style="margin-bottom:14px">
        <div class="card"><h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">⏱️ Top 5 — técnicos com perda de prazo</h3><div id="db-prazo-detalhes"></div></div>
        <div class="card"><h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">🔁 Top 5 — técnicos que geraram reincidência</h3><div id="db-reincidencias"></div></div>
      </div>
      <div class="card hidden" id="db-card-detalhes">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px"><h3 id="db-detalhes-titulo" style="font-size:.85rem;color:var(--p)">📋 Chamados</h3><button type="button" class="btn btn-s" id="btn-fechar-db-detalhes">Fechar</button></div>
        <div id="db-periodo-concluidos" class="hidden" style="padding:10px;background:#f8fafc;border-radius:10px;margin-bottom:10px">
          <div class="grid-3" style="gap:8px"><div class="form-group"><label class="label">Data inicial do encerramento</label><input type="date" id="db-dt1" class="input"></div><div class="form-group"><label class="label">Data final do encerramento</label><input type="date" id="db-dt2" class="input"></div><div class="form-group" style="display:flex;align-items:flex-end"><button type="button" class="btn btn-p" id="btn-db-exp-concluidos" style="width:100%">📥 Extrair concluídos</button></div></div>
        </div>
        <div id="db-lista-chamados"></div>
      </div>
    </div>
    <div id="v-tc" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">➕ Criar conta de Técnico</h3>
        <div class="grid-2">
          <div class="form-group"><label class="label">Nome</label><input type="text" id="t-n" class="input" placeholder="João Silva"></div>
          <div class="form-group"><label class="label">Usuário</label><input type="text" id="t-u" class="input" placeholder="joao.silva"></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">E-mail</label><input type="email" id="t-e" class="input" placeholder="tecnico@empresa.com"></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Defina a senha</label><input type="password" id="t-s" class="input" placeholder="Mínimo de 6 caracteres"></div>
          <div class="form-group"><label class="label">Confirme a senha</label><input type="password" id="t-sc" class="input" placeholder="Repita a senha"></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Região</label>
            <select id="t-r" class="select"><option value="capital">🏙️ Capital (6h)</option><option value="interior">🌾 Interior (8h)</option><option value="noronha">🏝️ Fernando de Noronha (6h)</option></select>
          </div>
        </div>
        <div id="t-entrega-box" class="card" style="margin:0 0 12px;padding:12px;background:#f8fafc">
          <h4 style="font-size:.78rem;color:var(--p);margin-bottom:9px">📍 Endereço para recebimento de materiais</h4>
          <div class="grid-2">
            <div class="form-group"><label class="label">CEP</label><input type="text" id="t-cep" class="input" inputmode="numeric" maxlength="9" placeholder="00000-000"></div>
            <div class="form-group"><label class="label">Cidade / UF</label><input type="text" id="t-cidade-entrega" class="input" placeholder="Cidade - PE"></div>
          </div>
          <div class="grid-2">
            <div class="form-group"><label class="label">Endereço</label><input type="text" id="t-endereco-entrega" class="input" placeholder="Rua, avenida ou sítio"></div>
            <div class="form-group"><label class="label">Número / Complemento</label><input type="text" id="t-complemento-entrega" class="input" placeholder="Número, bairro e referência"></div>
          </div>
          <div class="form-group"><label class="label">Contato para entrega</label><input type="text" id="t-contato-entrega" class="input" placeholder="Telefone do técnico ou responsável"></div>
          <div style="font-size:.64rem;color:var(--gr)">Obrigatório para técnicos do Interior e Fernando de Noronha.</div>
        </div>
        <div class="form-group"><label class="label">Skills do Técnico (selecione uma ou mais)</label>
          <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:.78rem"><label><input type="checkbox" id="t-multi" value="multi"> Multi-skill</label><label><input type="checkbox" name="t-sk" value="voz"> Voz</label><label><input type="checkbox" name="t-sk" value="dados"> Dados</label><label><input type="checkbox" name="t-sk" value="infra"> Infra</label></div>
        </div>
        <div class="form-group" id="t-areas-box"><label class="label">Áreas de atendimento</label>
          <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:.78rem"><label><input type="checkbox" name="t-ar" value="norte"> Norte</label><label><input type="checkbox" name="t-ar" value="leste"> Leste</label><label><input type="checkbox" name="t-ar" value="sul"> Sul</label><label><input type="checkbox" name="t-ar" value="oeste"> Oeste</label><label><input type="checkbox" name="t-ar" value="interior"> Interior</label><label><input type="checkbox" name="t-ar" value="noronha"> Fernando de Noronha</label></div>
        </div>
        <button class="btn btn-p" id="btn-add-tec">👤 Criar conta e perfil</button>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">👷 Técnicos Cadastrados</h3>
        <div class="form-group" style="margin-bottom:10px"><label class="label">Pesquisar técnico cadastrado</label><input type="search" id="tc-pesquisa" class="input" autocomplete="off" placeholder="Digite o nome do técnico..."><div id="tc-pesquisa-status" style="font-size:.65rem;color:var(--gr);margin-top:5px">A lista está oculta. Digite um nome para consultar o cadastro.</div></div>
        <div id="tc-resultados" class="hidden" style="overflow-x:auto"><table class="table">
          <thead><tr><th>Nome</th><th>Usuário</th><th>E-mail</th><th>Região</th><th>Endereço de entrega</th><th>Skills</th><th>Áreas</th><th>Ativas</th><th></th></tr></thead>
          <tbody id="tb-tc"></tbody>
        </table></div>
      </div>
    </div>
    <div id="v-ch" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📞 Novo Chamado</h3>
        <div class="form-group">
          <label class="label">Cole a descrição do chamado</label>
          <textarea id="c-descricao-colada" class="input" rows="5" placeholder="Cole aqui todo o texto do chamado. O sistema localizará automaticamente a designação do circuito na base."></textarea>
          <select id="c-opcoes" class="select hidden" style="margin-top:5px"></select>
          <div id="c-status" style="font-size:.65rem;margin-top:4px;color:var(--gr)">Cole a descrição para localizar automaticamente o circuito e carregar os dados do site.</div>
          <input type="hidden" id="c-ci">
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Protocolo</label><input type="text" id="c-pr" class="input" autocomplete="off" placeholder="Preenchido pela descrição ou digitado manualmente"></div>
          <div class="form-group"><label class="label">SDM</label><input type="text" id="c-sdm" class="input" autocomplete="off" placeholder="Preenchido pela descrição ou digitado manualmente"></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Quem abriu o chamado</label><select id="c-abertura" class="select"><option value="">Selecione...</option><option value="Vectra">Vectra</option><option value="Método">Método</option><option value="Umtelecom">Umtelecom</option></select></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Site / Cliente</label><input type="text" id="c-si" class="input" readonly></div>
          <div class="form-group"><label class="label">Cidade</label><input type="text" id="c-cd" class="input" readonly></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Contato</label><textarea id="c-co" class="input" rows="3" readonly></textarea></div>
          <div class="form-group"><label class="label">Horário de Expediente</label><textarea id="c-ho" class="input" rows="3" readonly></textarea></div>
        </div>
        <div class="grid-3">
          <div class="form-group"><label class="label">Velocidade</label><input type="text" id="c-ve" class="input" readonly></div>
          <div class="form-group"><label class="label">PRTM</label><input type="text" id="c-pt" class="input" readonly></div>
          <div class="form-group"><label class="label">PVF Total</label><input type="text" id="c-pv" class="input" readonly></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Endereço</label><input type="text" id="c-en" class="input" readonly></div>
          <div class="form-group"><label class="label">Região</label>
            <select id="c-re" class="select" disabled><option value="capital">🏙️ Capital — SLA 6 horas</option><option value="interior">🌾 Interior — SLA 8 horas</option><option value="noronha">🏝️ Fernando de Noronha — SLA 6 horas</option></select>
          </div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Região operacional da planilha</label><input type="text" id="c-regiao-planilha" class="input" readonly></div>
          <div class="form-group"><label class="label">Técnicos indicados pela planilha</label><input type="text" id="c-tecnicos-planilha" class="input" readonly></div>
        </div>
        <div class="grid-2">
          <div class="form-group"><label class="label">Skill necessária</label><select id="c-sk" class="select"><option value="">Selecione...</option><option value="voz">Voz</option><option value="dados">Dados</option><option value="infra">Infra</option></select></div>
          <div class="form-group" id="c-area-box"><label class="label">Área de atendimento na Capital</label><select id="c-area" class="select"><option value="">Selecione...</option><option value="norte">Área Norte</option><option value="leste">Área Leste</option><option value="sul">Área Sul</option><option value="oeste">Área Oeste</option></select></div>
        </div>
        <div class="form-group"><label class="label">Técnico que atende a região</label><select id="c-tecnico" class="select"><option value="">Selecione primeiro a skill e a área...</option></select><div id="c-tecnico-status" style="font-size:.65rem;margin-top:4px;color:var(--gr)"></div></div>
        <div class="form-group"><label style="font-size:.75rem;color:var(--r)"><input type="checkbox" id="c-liberar-area"> Liberar excepcionalmente técnico de outra área de cobertura</label><div style="font-size:.62rem;color:var(--gr);margin-top:3px">A liberação ficará registrada com o nome do administrador.</div></div>
        <div class="form-group"><label class="label">Motivo do chamado</label><input type="text" id="c-motivo" class="input" placeholder="Capturado da descrição ou informado manualmente"></div>
        <div class="form-group"><label class="label">Descrição</label><textarea id="c-de" class="input" rows="3" placeholder="Descreva o problema..."></textarea></div>
        <div class="form-group"><label class="label">Data de Execução da Atividade</label><input type="date" id="c-dtexec" class="input"></div>
        <button class="btn btn-p" id="btn-add-ch">📞 Criar Chamado</button>
      </div>
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📋 Chamados em Aberto</h3><div id="l-ab"></div>
      </div>
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">👷 Chamados Direcionados</h3><div id="l-di"></div>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">❌ Chamados Recusados</h3><div id="l-re"></div>
      </div>
    </div>
    <div id="v-at" class="hidden">
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">⏱️ Chamados em Atendimento</h3>
        <div style="overflow-x:auto"><table class="table">
          <thead><tr><th>Protocolo</th><th>Site</th><th>Técnico</th><th>Região</th><th>Timer</th><th>Ações</th></tr></thead>
          <tbody id="tb-at"></tbody>
        </table></div>
      </div>
    </div>
    <div id="v-rl" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:10px"><h3 style="font-size:.85rem;color:var(--p)">✅ Extrair chamados encerrados por período</h3><button type="button" class="btn btn-p" id="btn-rl-exp-encerrados">📥 Exportar Excel</button></div>
        <div class="grid-2" style="gap:8px"><div class="form-group"><label class="label">Data inicial do encerramento</label><input type="date" id="rl-enc-dt1" class="input"></div><div class="form-group"><label class="label">Data final do encerramento</label><input type="date" id="rl-enc-dt2" class="input"></div></div>
      </div>
      <div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:10px">
          <h3 style="font-size:.85rem;color:var(--p)">📊 Planilhas de Pagamento por Técnico</h3>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            <button class="btn btn-p" id="btn-exp-consolidado">📊 Exportar Consolidado Excel</button>
            <button class="btn btn-s" id="btn-exp-csv">📥 Exportar CSV</button>
            <button class="btn btn-r" id="btn-limpar-rl-cards">🧹 Limpar Cards</button>
          </div>
        </div>
        <div class="grid-3" style="gap:8px">
          <div class="form-group"><label class="label">Data Inicial</label><input type="date" id="rl-dt1" class="input"></div>
          <div class="form-group"><label class="label">Data Final</label><input type="date" id="rl-dt2" class="input"></div>
          <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-p" id="btn-fil-rl" style="width:100%">🔍 Filtrar Período</button></div>
        </div>
      </div>
      <div id="rl-cards"></div>
    </div>
    <div id="v-ml" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px"><h3 style="font-size:.85rem;color:var(--p)">📦 Material Logístico — Solicitações</h3><button type="button" class="btn btn-p btn-exp-materiais-liberados">📥 Exportar demandas com material liberado</button><button type="button" class="btn btn-y btn-historico-materiais" aria-pressed="false">Ver histórico de itens apagados</button></div>
        <div class="form-group"><label class="label" for="busca-solicitacoes-material">Localizar solicitação</label><input type="search" id="busca-solicitacoes-material" class="input" placeholder="Digite o nome do técnico ou o protocolo" autocomplete="off"></div>
        <div class="info">Materiais disponíveis para solicitação: lista importada da planilha <b>MATERIAL LOGISTICO.xlsx</b>. Estoque inicial dos itens importados: 0.</div>
        <div class="info">Os técnicos solicitam materiais vinculados a um protocolo. O administrador analisa a solicitação e a direciona para a separação no estoque.</div>
        <div id="ml-solicitacoes"></div>
      </div>
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">🚚 Rastreamento de Materiais do Interior</h3>
        <div class="info">Acompanhe o trâmite completo: solicitação, direcionamento, separação, transporte para a localidade e entrega ao técnico.</div>
        <div id="ml-rastreio-lista"></div>
      </div>
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📦 Estoque Logístico</h3>
        <div class="grid-3">
          <div class="form-group"><label class="label">Material</label>
<div class="material-busca-rapida" style="margin:8px 0;">
  <input id="busca-material-estoque" type="text"
         placeholder="🔎 Digite o nome/modelo do material para localizar..."
         autocomplete="off"
         style="width:100%;padding:10px;border:1px solid #ccc;border-radius:8px;">
</div>
<select id="ml-estoque-material" class="hidden" aria-hidden="true" tabindex="-1" onchange="fixarSelecaoMaterial('ml-estoque-material', this.value)"></select></div>
          <div class="form-group"><label class="label">Quantidade em estoque</label><input type="number" min="0" id="ml-estoque-qtd" class="input" placeholder="0"></div>
          <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-p" id="btn-ml-ajuste" style="width:100%">💾 Salvar Quantidade</button></div>
        </div>
        <div id="ml-estoque-lista"></div>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">➕ Cadastro de Material</h3>
        <div class="grid-3">
          <div class="form-group"><label class="label">Modelo / Material</label><input id="mat-nome" class="input" placeholder="Ex.: FortiAP, cabo UTP..."></div>
          <div class="form-group"><label class="label">Unidade</label><select id="mat-un" class="select" onchange="fixarSelecaoMaterial('mat-un', this.value)"><option value="UN">UN</option><option value="M">M</option><option value="KIT">KIT</option><option value="CX">CX</option><option value="OUTRO">OUTRO</option></select></div>
          <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-g" id="btn-add-material" style="width:100%">➕ Cadastrar Material</button></div>
        </div>
        <div id="mat-cadastro-lista"></div>
      </div>
    </div>
    <div id="v-ad" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">🚚 Criar conta de Responsável Logístico</h3>
        <div class="grid-2">
          <div class="form-group"><label class="label">Nome</label><input type="text" id="l-n" class="input" placeholder="Responsável pela logística"></div>
          <div class="form-group"><label class="label">Usuário</label><input type="text" id="l-u" class="input" placeholder="responsavel.logistica"></div>
        </div>
        <div class="form-group"><label class="label">E-mail</label><input type="email" id="l-e" class="input" placeholder="logistica@empresa.com"></div>
        <div class="grid-2"><div class="form-group"><label class="label">Defina a senha</label><input type="password" id="l-s" class="input" placeholder="Mínimo de 6 caracteres"></div><div class="form-group"><label class="label">Confirme a senha</label><input type="password" id="l-sc" class="input" placeholder="Repita a senha"></div></div>
        <button class="btn btn-p" id="btn-add-log">🚚 Criar perfil logístico</button>
      </div>
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">➕ Criar conta de Administrador</h3>
        <div class="grid-2">
          <div class="form-group"><label class="label">Nome</label><input type="text" id="a-n" class="input" placeholder="Carlos Manager"></div>
          <div class="form-group"><label class="label">Usuário</label><input type="text" id="a-u" class="input" placeholder="carlos.admin"></div>
        </div>
        <div class="form-group"><label class="label">E-mail</label><input type="email" id="a-e" class="input" placeholder="administrador@empresa.com"></div>
        <div class="grid-2"><div class="form-group"><label class="label">Defina a senha</label><input type="password" id="a-s" class="input" placeholder="Mínimo de 6 caracteres"></div><div class="form-group"><label class="label">Confirme a senha</label><input type="password" id="a-sc" class="input" placeholder="Repita a senha"></div></div>
        <button class="btn btn-p" id="btn-add-adm">🛡️ Criar conta e perfil</button>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📋 Administradores</h3>
        <div style="overflow-x:auto"><table class="table">
          <thead><tr><th>Nome</th><th>Usuário</th><th>E-mail</th><th></th></tr></thead>
          <tbody id="tb-ad"></tbody>
        </table></div>
      </div>
    </div>
  </div>
</div>

<!-- TÉCNICO -->
<div id="pt" class="hidden">
  <div class="user-bar"><span>👷 <b>Técnico</b> — <span id="tn"></span> <span id="tr"></span></span><div style="display:flex;gap:5px"><button class="btn-minha-senha">Alterar senha</button><button id="btn-sair-tec">Sair</button></div></div>
  <div class="header"><h1><span class="nf-logo">NF</span><span class="nf-brand-name">NexoField</span></h1><div class="sub">Área do Técnico</div></div>
  <div class="nav" id="nv2">
    <button class="a" data-tab="db">📊 Dashboard</button>
    <button data-tab="dp">📥 Despachados</button>
    <button data-tab="at">⏱️ Atendimento</button>
    <button data-tab="co">✅ Concluídos</button>
    <button data-tab="ar">📋 Atividades Realizadas</button>
     <button data-tab="mt">📦 Material</button>
  </div>
  <div class="content">
    <section class="nf-dashboard-hero nf-dashboard-tech" aria-label="Operação técnica">
      <div><span>Operação de campo</span><strong>Seu trabalho, mais conectado</strong><small>Rotas, atendimentos, escolas, materiais e evidências organizados.</small></div>
    </section>
    <div id="t-db">
      <div class="grid-3" style="margin-bottom:14px">
        <div class="card stat"><div class="l">Despachados</div><div class="v" id="ts-d">0</div></div>
        <div class="card stat y"><div class="l">Andamento</div><div class="v" id="ts-a">0</div></div>
        <div class="card stat g"><div class="l">Concluídos</div><div class="v" id="ts-c">0</div></div>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">⏱️ Seus Timers</h3>
        <div id="t-tm"></div>
      </div>
    </div>
    <div id="t-dp" class="hidden">
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📥 Chamados Despachados para Você</h3>
        <div id="t-dl"></div>
      </div>
    </div>
    <div id="t-at" class="hidden">
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">⏱️ Chamados em Atendimento</h3>
        <div id="t-al"></div>
      </div>
    </div>
    <div id="t-co" class="hidden">
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">✅ Chamados Concluídos</h3>
        <div id="t-cl"></div>
      </div>
    </div>
    <div id="t-mt" class="hidden">
      <div class="card" style="margin-bottom:12px">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📦 Solicitar Material</h3>
        <div class="info">A lista abaixo contém os materiais cadastrados na planilha logística.</div>
        <div class="grid-3">
          <div class="form-group"><label class="label">Protocolo do chamado</label><select id="tm-protocolo" class="select"></select></div>
          <div class="form-group"><label class="label">Material / Modelo</label><div class="material-busca-rapida" style="position:relative"><input id="busca-material-tecnico" type="text" class="input" placeholder="🔎 Digite o nome/modelo do material..." autocomplete="off"></div><select id="tm-material" class="hidden" aria-hidden="true" tabindex="-1" onchange="fixarSelecaoMaterial('tm-material', this.value)"></select></div>
          <div class="form-group"><label class="label">Quantidade</label><input type="number" min="1" id="tm-qtd" class="input" placeholder="Quantidade"></div>
        </div>
        <div class="form-group"><label class="label">Observação / finalidade</label><textarea id="tm-obs" class="input" rows="2" placeholder="Informe para qual atividade o material será utilizado"></textarea></div>
        <button class="btn btn-p" id="btn-tm-solicitar">📤 Solicitar Material</button>
      </div>
      <div class="card">
        <h3 style="font-size:.85rem;color:var(--p);margin-bottom:10px">📋 Meus Materiais Solicitados e Entregues</h3>
        <div id="tm-lista"></div>
      </div>
    </div>
    <div id="t-ar" class="hidden">
