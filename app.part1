        <div class="grid-3" style="gap:8px;margin-bottom:12px">
          <div class="form-group"><label class="label">Data Inicial</label><input type="date" id="ar-dt1" class="input"></div>
          <div class="form-group"><label class="label">Data Final</label><input type="date" id="ar-dt2" class="input"></div>
          <div class="form-group" style="display:flex;align-items:flex-end;gap:6px"><button class="btn btn-p" id="btn-fil-ar" style="width:100%">🔍 Filtrar Período</button></div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin:8px 0 10px">
          <button class="btn btn-g" id="btn-exp-ar-xlsx">📊 Exportar Atividades em Excel</button>
        </div>
        <div style="overflow-x:auto"><table class="table" id="tb-ar">
          <thead><tr><th>O.S</th><th>Site</th><th>Origem</th><th>Destino</th><th>Retorno</th><th>Data</th><th>Atividade</th><th>Miscelânea</th><th>Qtd</th><th>KM Total</th><th>Valor KM</th><th>Valor Mat.</th><th>Total Mat.</th><th>Valor Ativ.</th><th>Valor Total</th><th>Observação</th><th>Status Pag.</th></tr></thead>
          <tbody id="tb-ar-body"></tbody>
        </table></div>
      </div>
    </div>
