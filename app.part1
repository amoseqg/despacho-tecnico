<!-- LOGÍSTICA -->
<div id="plog" class="hidden">
  <div class="user-bar"><span>🚚 <b>Logística</b> — <span id="ln"></span></span><div style="display:flex;gap:5px"><button class="btn-minha-senha">Alterar senha</button><button id="btn-sair-log">Sair</button></div></div>
  <div class="header"><h1>📦 Gestão Logística</h1><div class="sub">Separação, expedição, rastreamento e entrega</div></div>
  <div class="content">
    <section class="nf-dashboard-hero nf-dashboard-log" aria-label="Operação logística">
      <div><span>Fluxo logístico</span><strong>Materiais sob controle</strong><small>Separação, rastreamento e entrega com visão operacional completa.</small></div>
    </section>
    <div class="card">
      <details id="lg-tramite">
        <summary style="font-size:.9rem;color:var(--p);font-weight:700;cursor:pointer;padding:8px 0">🚚 Trâmite dos materiais</summary>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin:10px 0">
          <button type="button" class="btn btn-p btn-exp-materiais-liberados">📥 Exportar demandas com material liberado</button><button type="button" class="btn btn-y btn-historico-materiais" aria-pressed="false">Ver histórico de itens apagados</button>
          <button type="button" class="btn btn-y" id="btn-limpar-entregues">🧹 Limpar itens entregues</button>
        </div>
        <div class="info">Capital: separação → aguardando aceite → entregue. Interior/Noronha: separação → em trânsito com rastreio e previsão → aceite do técnico → entregue. A limpeza remove os entregues desta lista e mantém o histórico na exportação.</div>
        <div id="lg-list"></div>
      </details>
    </div>
    <div class="card" style="margin-top:12px">
      <h3 style="font-size:.9rem;color:var(--p);margin-bottom:10px">🚚 Rastreamento de Materiais do Interior</h3>
      <div class="info">Trâmite: solicitado → direcionado → separado → em transporte → recebido pelo técnico.</div>
      <div id="lg-rastreio-lista"></div>
    </div>
    <div class="card" style="margin-top:12px">
      <h3 style="font-size:.9rem;color:var(--p);margin-bottom:10px">📦 Estoque Logístico</h3>
      <div class="grid-3">
        <div class="form-group"><label class="label">Material</label>
          <div class="material-busca-rapida" style="margin:8px 0">
            <input id="busca-material-logistica" type="text" class="input" placeholder="🔎 Digite o nome/modelo do material para localizar..." autocomplete="off">
          </div>
          <select id="lg-estoque-material" class="hidden" aria-hidden="true" tabindex="-1"></select>
        </div>
        <div class="form-group"><label class="label">Quantidade em estoque</label><input type="number" min="0" id="lg-estoque-qtd" class="input" placeholder="0"></div>
        <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-p" id="btn-lg-ajuste" style="width:100%">💾 Salvar Quantidade</button></div>
      </div>
      <div id="lg-estoque-lista"></div>
    </div>
    <div class="card" style="margin-top:12px">
      <h3 style="font-size:.9rem;color:var(--p);margin-bottom:10px">➕ Cadastro de Materiais</h3>
      <div class="info">Cadastre novos itens ou remova materiais que não devem mais aparecer no estoque.</div>
      <div class="grid-3">
        <div class="form-group"><label class="label">Modelo / Material</label><input id="lg-mat-nome" class="input" placeholder="Ex.: FortiAP, cabo UTP..."></div>
        <div class="form-group"><label class="label">Unidade</label><select id="lg-mat-un" class="select"><option value="UN">UN</option><option value="M">M</option><option value="KIT">KIT</option><option value="CX">CX</option><option value="OUTRO">OUTRO</option></select></div>
        <div class="form-group" style="display:flex;align-items:flex-end"><button class="btn btn-g" id="btn-lg-add-material" style="width:100%">➕ Cadastrar Material</button></div>
      </div>
      <div id="lg-mat-cadastro-lista"></div>
    </div>
  </div>
</div>

<!-- MODAIS -->
<div class="modal" id="m-senha"><div class="modal-box" style="max-width:430px"><div class="modal-hd"><h3>🔐 Meus dados de acesso</h3><button class="close" id="cls-senha">×</button></div><div class="modal-bd"><div class="form-group"><label class="label">E-mail para recuperação</label><input type="email" id="ms-email" class="input"></div><div class="form-group"><label class="label">Senha atual</label><input type="password" id="ms-atual" class="input"></div><div class="form-group"><label class="label">Nova senha</label><input type="password" id="ms-nova" class="input" placeholder="Mínimo de 6 caracteres"></div><div class="form-group"><label class="label">Confirmar nova senha</label><input type="password" id="ms-conf" class="input"></div></div><div class="modal-ft"><button class="btn btn-s" id="can-senha">Cancelar</button><button class="btn btn-p" id="cf-senha">Salvar dados</button></div></div></div>

<div class="modal" id="m-rec"><div class="modal-box" style="max-width:430px"><div class="modal-hd"><h3>🔑 Recuperar acesso</h3><button class="close" id="cls-rec">×</button></div><div class="modal-bd"><div class="info">Informe o e-mail cadastrado no sistema. Você receberá uma mensagem do Supabase com um link seguro para definir uma nova senha.</div><div class="form-group"><label class="label">E-mail cadastrado</label><input type="email" id="rec-e" class="input" placeholder="seuemail@exemplo.com" autocomplete="email"></div></div><div class="modal-ft"><button class="btn btn-s" id="can-rec">Cancelar</button><button class="btn btn-p" id="cf-rec">Enviar link de recuperação</button></div></div></div>

<div class="modal" id="m-dp">
  <div class="modal-box">
    <div class="modal-hd"><h3 id="d-tit">🚚 Despachar Chamado</h3><button class="close" id="cls-dp">×</button></div>
    <div class="modal-bd">
      <div class="info" id="d-in"></div>
      <div class="form-group"><label class="label">Técnico</label><select id="d-te" class="select"></select></div>
      <div class="trava hidden" id="d-tr"><b>⚠️ Trava de 4 chamados!</b><br>Este técnico já tem 4 iniciados hoje.
        <div class="form-group" style="margin-top:6px"><input type="text" id="d-q" class="input" placeholder="Quem destravou?"></div>
        <div class="form-group"><input type="text" id="d-m" class="input" placeholder="Motivo"></div>
      </div>
    </div>
    <div class="modal-ft"><button class="btn btn-s" id="btn-can-dp">Cancelar</button><button class="btn btn-p" id="btn-cf-dp">🚚 Despachar</button></div>
  </div>
</div>

<div class="modal" id="m-rc">
  <div class="modal-box">
    <div class="modal-hd"><h3>❌ Recusar Chamado</h3><button class="close" id="cls-rc">×</button></div>
    <div class="modal-bd">
      <div class="info" id="r-in"></div>
      <div class="form-group"><label class="label">Motivo da Recusa</label><textarea id="r-m" class="input" rows="2" placeholder="Informe o motivo..."></textarea></div>
    </div>
    <div class="modal-ft"><button class="btn btn-s" id="btn-can-rc">Cancelar</button><button class="btn btn-r" id="btn-cf-rc">❌ Recusar</button></div>
  </div>
</div>

<div class="modal" id="m-tr">
  <div class="modal-box">
    <div class="modal-hd"><h3>🔄 Transferir Chamado</h3><button class="close" id="cls-tr">×</button></div>
    <div class="modal-bd">
      <div class="info" id="t-in"></div>
      <div class="form-group"><label class="label">Transferir para</label><select id="t-te" class="select"></select></div>
      <div class="form-group"><label class="label">Motivo</label><textarea id="t-m" class="input" rows="2" placeholder="Motivo da transferência..."></textarea></div>
    </div>
    <div class="modal-ft"><button class="btn btn-s" id="btn-can-tr">Cancelar</button><button class="btn btn-p" id="btn-cf-tr">🔄 Transferir</button></div>
  </div>
</div>

<!-- MODAL DETALHES PLANILHA -->
<div class="modal" id="m-pl">
  <div class="modal-box" style="max-width:1100px">
    <div class="modal-hd"><h3 id="pl-tit">📋 Planilha do Técnico</h3><button class="close" id="cls-pl">×</button></div>
    <div class="modal-bd">
      <div class="info" id="pl-in"></div>
      <div style="overflow-x:auto"><table class="pl-table" id="pl-tb">
        <thead><tr><th>O.S</th><th>Site</th><th>Origem</th><th>Destino</th><th>Retorno</th><th>Data</th><th>Atividade</th><th>Miscelânea</th><th>Qtd</th><th>KM Total</th><th>Valor KM</th><th>Valor Mat.</th><th>Total Mat.</th><th>Valor Ativ.</th><th>Valor Total</th><th>Observação</th><th>Status Pag.</th></tr></thead>
        <tbody id="pl-tb-body"></tbody>
      </table></div>
      <div class="pl-ft" style="margin-top:12px">
        <div class="pl-resumo" id="pl-res"></div>
        <div style="text-align:right">
          <div class="pl-total" id="pl-tot"></div>
        </div>
      </div>
    </div>
    <div class="modal-ft">
      <button class="btn btn-s" id="btn-can-pl">Fechar</button>
      <button class="btn btn-r" id="btn-rej-pl">❌ Rejeitar</button>
      <button class="btn btn-g" id="btn-apv-pl">✅ Aprovar</button>
      <button class="btn btn-p hidden" id="btn-exp-serv-xlsx">📊 Exportar Serviço Aprovado</button>
    </div>
  </div>
</div>

<!-- MODAL CONFIRMAÇÃO APROVAÇÃO/REJEIÇÃO -->
<div class="modal" id="m-ap">
  <div class="modal-box" style="max-width:450px">
    <div class="modal-hd"><h3 id="ap-tit">📝 Confirmar Ação</h3><button class="close" id="cls-ap">×</button></div>
    <div class="modal-bd">
      <div class="info" id="ap-in"></div>
      <div class="form-group hidden" id="ap-obs-box"><label class="label">Motivo da Rejeição</label><textarea id="ap-obs" class="input" rows="2" placeholder="Informe o motivo..."></textarea></div>
    </div>
    <div class="modal-ft">
      <button class="btn btn-s" id="btn-can-ap">Cancelar</button>
      <button class="btn btn-p" id="btn-cf-ap">Confirmar</button>
    </div>
  </div>
</div>

<!-- MODAL EXECUÇÃO -->
<div class="modal" id="m-ex">
  <div class="modal-box" style="max-width:650px">
    <div class="modal-hd" style="position:relative">
      <div style="display:flex;justify-content:space-between;align-items:center;width:100%">
        <h3>📝 Executar Serviço</h3>
        <div id="ex-tm" class="timer t-g" style="margin-right:28px">00:00:00</div>
      </div>
      <button class="close" id="cls-ex">×</button>
    </div>
    <div class="modal-bd">
      <div class="card" style="margin-bottom:12px;background:var(--l)">
        <div style="font-size:.6rem;color:var(--gr);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px">📋 Dados do Chamado (Somente Leitura)</div>
        <div class="grid-2"><div class="os-r"><b>Protocolo:</b> <span id="ex-pr"></span></div><div class="os-r"><b>Site:</b> <span id="ex-si"></span></div></div>
        <div class="os-r"><b>Circuito:</b> <span id="ex-ci"></span></div>
        <div class="os-r"><b>Endereço:</b> <span id="ex-en"></span></div>
        <div class="os-r"><b>Descrição:</b> <span id="ex-de"></span></div>
      </div>
      <div style="font-size:.6rem;color:var(--gr);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">🚗 Distância - Origem / Destino / Retorno</div>
      <div class="grid-3">
        <div class="form-group"><label class="label">Origem</label><select id="ex-co" class="select"></select></div>
        <div class="form-group"><label class="label">Destino</label><input id="ex-cd" class="input" list="lista-cidades-rota" placeholder="Selecione uma cidade ou pesquise a escola abaixo"></div>
        <div class="form-group"><label class="label">Retorno</label><select id="ex-cr" class="select"></select></div>
      </div>
      <datalist id="lista-cidades-rota"></datalist>
      <div id="ex-escolas-box" class="card hidden" style="margin:0 0 10px;background:#f8fafc;border:1px solid #cbd5e1">
        <div style="font-size:.65rem;font-weight:700;margin-bottom:8px">🏫 Procurar escola do destino</div>
        <div class="form-group">
          <label class="label">Nome da escola</label>
          <input id="ex-esc-d" class="input" list="lista-escolas-pe" placeholder="Digite o nome da escola de destino">
          <small id="ex-esc-d-info"></small>
          <button type="button" class="btn btn-p" id="btn-aplicar-escola-destino" style="margin-top:7px;padding:6px 10px;font-size:.7rem">📍 Carregar endereço no Destino</button>
        </div>
        <input type="hidden" id="ex-esc-o"><input type="hidden" id="ex-esc-r">
        <span id="ex-esc-o-info" class="hidden"></span><span id="ex-esc-r-info" class="hidden"></span>
        <datalist id="lista-escolas-pe"></datalist>
        <small>Ao selecionar a escola, o endereço completo aparece automaticamente no campo Destino. Escolha normalmente a Origem e o Retorno para calcular a rota completa.</small>
      </div>
      <button class="btn btn-p" id="btn-calc-dist" style="padding:6px 10px;font-size:.7rem;margin-bottom:8px">🧮 Calcular Distâncias</button>
      <div class="info-dist hidden" id="ex-dist-info"></div>
      <div class="grid-2">
        <div class="form-group"><label class="label">Distância Total (km)</label><input type="number" step="0.1" id="ex-km" class="input" readonly></div>
        <div class="form-group"><label class="label">Valor Km Excedente</label><input type="text" id="ex-vkm" class="input" readonly style="color:var(--r);font-weight:700"></div>
      </div>
      <div style="font-size:.65rem;color:var(--gr);margin-bottom:10px"><small>(Total - 40km = R$ 1,00/km)</small></div>
      <div style="font-size:.6rem;color:var(--gr);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">🔧 Atividade Realizada</div>
      <div class="grid-2">
        <div class="form-group"><label class="label">Tipo de Atividade</label>
          <select id="ex-atv" class="select">
            <option value="">Selecione...</option>
            <option value="Incidente de voz capital|100.00">Incidente de voz capital - R$ 100,00</option>
            <option value="Incidente de dados capital|120.00">Incidente de dados capital - R$ 120,00</option>
            <option value="Serviço de analista centrais|200.00">Serviço de analista centrais - R$ 200,00</option>
            <option value="Incidente voz interior|150.00">Incidente voz interior - R$ 150,00</option>
            <option value="Incidente de dados interior|150.00">Incidente de dados interior - R$ 150,00</option>
            <option value="Instalação|150.00">Instalação - R$ 150,00</option>
            <option value="Alteração|150.00">Alteração - R$ 150,00</option>
            <option value="Vistoria|150.00">Vistoria - R$ 150,00</option>
            <option value="Serviços maiores|0">Serviços maiores (informar valor abaixo)</option>
          </select>
        </div>
        <div class="form-group"><label class="label">Valor do Serviço (R$)</label><input type="number" step="0.01" id="ex-vatv" class="input" readonly></div>
      </div>
      <div class="form-group hidden" id="ex-avulso-box"><label class="label">Valor do Serviço Maior (R$)</label><input type="number" step="0.01" id="ex-avulso" class="input"></div>
      <div style="font-size:.6rem;color:var(--gr);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">📦 Materiais Utilizados</div>
      <div class="grid-3">
        <div class="form-group"><label class="label">Cabo UTP (R$ 1,50/m)</label><input type="number" step="0.1" id="ex-utp" class="input" placeholder="Metros"></div>
        <div class="form-group"><label class="label">Cabo CCI (R$ 1,00/m)</label><input type="number" step="0.1" id="ex-cci" class="input" placeholder="Metros"></div>
        <div class="form-group"><label class="label">Canaleta (R$ 3,50/m)</label><input type="number" step="0.1" id="ex-can" class="input" placeholder="Metros"></div>
      </div>
      <div class="form-group"><label class="label">Total Materiais</label><input type="text" id="ex-tmat" class="input" readonly style="font-weight:700"></div>
      <div style="font-size:.6rem;color:var(--gr);margin:10px 0 8px;text-transform:uppercase;letter-spacing:.5px">📋 Relatório de Encerramento</div>
      <p>Preencha os quatro campos obrigatórios para encerrar o chamado.</p>
      <div class="form-group"><label class="label" for="ex-causa">Causa raiz *</label><select id="ex-causa" class="input" required onchange="sincronizarCamposEncerramento()"><option value="">Selecione...</option><option>Infracliente</option><option>Elétrica cliente</option><option>Elétrica concessionária</option><option>Mau uso</option><option>Vistoria</option></select></div>
      <div class="form-group"><label class="label" for="ex-solucao">Solução técnica *</label><textarea id="ex-solucao" class="input" rows="3" required oninput="sincronizarCamposEncerramento()"></textarea></div>
      <div class="form-group"><label class="label" for="ex-validacao">Validação Vectra/Umtelecom *</label><input id="ex-validacao" class="input" required oninput="sincronizarCamposEncerramento()"></div>
      <div class="form-group"><label class="label" for="ex-senha">Senha *</label><input id="ex-senha" class="input" required autocomplete="off" oninput="sincronizarCamposEncerramento()"></div>
      <div class="form-group"><label class="label">Máscara de encerramento</label><textarea id="ex-relatorio" oninput="preencherCamposEncerramento()" class="input" rows="13" style="font-family:monospace;line-height:1.45" placeholder="Preencha o relatório de encerramento..."></textarea></div>
      <div class="form-group">
        <label class="label">📷 Fotos da execução</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <label class="btn btn-p" for="ex-fotos" style="cursor:pointer">📷 Tirar foto</label>
          <label class="btn btn-s" for="ex-galeria" style="cursor:pointer">🖼️ Anexar da galeria</label>
        </div>
        <input type="file" id="ex-fotos" accept="image/jpeg,image/png,image/webp" capture="environment" style="position:absolute;left:-9999px;width:1px;height:1px">
        <input type="file" id="ex-galeria" accept="image/jpeg,image/png,image/webp" multiple style="position:absolute;left:-9999px;width:1px;height:1px">
        <small>As fotos são acumuladas e preservadas no rascunho. Até 8 fotos, máximo de 8 MB por foto.</small>
        <div id="ex-fotos-preview" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px;margin-top:8px"></div>
      </div>
      <form id="form-vistoria" class="card" style="margin:10px 0;background:#f8fafc;border:1px solid #cbd5e1">
        <h3 style="font-size:.78rem;color:var(--p);margin-bottom:8px">📄 Relatório de vistoria</h3>
        <select class="hidden" id="vistoria-chamado" required aria-hidden="true" tabindex="-1"></select>
        <div class="form-group"><label class="label" for="vistoria-pdf">Anexar relatório de vistoria (PDF, até 20 MB)</label><input class="input" type="file" id="vistoria-pdf" accept="application/pdf,.pdf" required></div>
        <div class="form-group"><label class="label" for="ex-obs">Observação sobre o relatório</label><textarea id="ex-obs" class="input" rows="2" placeholder="Informe uma observação sobre a vistoria ou o relatório anexado"></textarea></div>
        <button class="btn btn-p" id="vistoria-enviar" type="submit">📤 Enviar relatório de vistoria</button>
        <p role="status" id="vistoria-mensagem" style="margin-top:8px"></p>
      </form>
      <div class="total-box">
        <strong>VALOR TOTAL DO SERVIÇO: <span id="ex-total" style="font-size:1.1rem">R$ 0,00</span></strong>
      </div>
    </div>
    <div class="modal-ft">
      <button class="btn btn-s" id="btn-can-ex">Cancelar</button>
      <button class="btn btn-g" id="btn-cf-ex">✅ Encerrar Chamado</button>
    </div>
  </div>
</div>

